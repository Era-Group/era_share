<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_era_address_client" model="ir.ui.view">
        <field name="name">res.partner.form.era.address.client</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='div_type']" position="after">
                <label for="x_short_address" string="Short Address"/>
                <div class="o_row">
                    <field
                        name="x_short_address"
                        placeholder="JCHA4298"
                        nolabel="1"
                    />
                    <button
                        name="action_resolve_short_address"
                        type="object"
                        string="Resolve Short Address"
                        class="btn-primary"
                        invisible="not x_short_address"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
