<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Managers: full visibility across the company. -->
        <record id="rule_era_ai_account_manager" model="ir.rule">
            <field name="name">AI Account: managers see all</field>
            <field name="model_id" ref="model_era_ai_account"/>
            <field name="groups" eval="[(4, ref('era_ai_accounts.group_ai_account_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regular users: only accounts they may actually use (read-only). -->
        <record id="rule_era_ai_account_user" model="ir.rule">
            <field name="name">AI Account: users see usable accounts</field>
            <field name="model_id" ref="model_era_ai_account"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                    '&amp;', ('scope', '=', 'shared'),
                        '|', ('allowed_user_ids', '=', False), ('allowed_user_ids', 'in', [user.id]),
                    '&amp;', ('scope', '=', 'personal'),
                        '|', ('owner_user_id', '=', user.id), ('allowed_user_ids', 'in', [user.id]),
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Multi-company isolation for managers writing records. -->
        <record id="rule_era_ai_account_company" model="ir.rule">
            <field name="name">AI Account: multi-company</field>
            <field name="model_id" ref="model_era_ai_account"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
