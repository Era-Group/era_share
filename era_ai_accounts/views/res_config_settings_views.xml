<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_era_ai_accounts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.era.ai.accounts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai_app.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ai_app']/block[@name='ai_providers']/setting[@id='google_provider']" position="after">
                <setting
                    id="era_ai_accounts_link"
                    string="AI Accounts"
                    help="Link Claude, ChatGPT or Kimi via the local CLI proxy (no API key) or OpenAI/Gemini/Cloudflare/Z.AI/Kimi/custom via API keys, and share them with users."
                    groups="base.group_system">
                    <button name="%(era_ai_accounts.era_ai_account_action)d" type="action"
                            string="Open AI Accounts" class="btn-link"/>
                </setting>
                <setting
                    id="era_cli_protection"
                    string="AI CLI rate protection"
                    help="Keep the connected Claude/ChatGPT/Kimi accounts safe from concurrent or rapid-fire calls. Calls are serialized and paced per provider; tune the limits below."
                    groups="base.group_system">
                    <field name="cli_gap_enabled"/>
                    <group class="mt-2">
                        <field name="cli_min_gap" invisible="not cli_gap_enabled"/>
                        <field name="cli_gap_per_kb" invisible="not cli_gap_enabled"/>
                        <field name="cli_max_gap" invisible="not cli_gap_enabled"/>
                        <field name="cli_max_concurrency"/>
                        <field name="cli_lock_wait"/>
                        <field name="cli_timeout"/>
                        <field name="cli_max_prompt_chars"/>
                    </group>
                </setting>
                <setting
                    id="custom_llm_provider"
                    string="Use your own custom LLM provider"
                    help="Configure any OpenAI-compatible provider (OpenRouter, Groq, Together, local gateways, etc.)."
                    groups="base.group_system">
                    <field name="custom_llm_key_enabled"/>
                    <group invisible="not custom_llm_key_enabled">
                        <div class="flex-grow-1 d-flex flex-column gap-2">
                            <label for="custom_llm_provider_name"/>
                            <field name="custom_llm_provider_name" placeholder="OpenRouter" class="w-100"/>
                            <label for="custom_llm_key"/>
                            <field name="custom_llm_key" placeholder="API key" password="True" class="w-100"/>
                            <label for="custom_llm_base_url"/>
                            <field name="custom_llm_base_url" placeholder="https://openrouter.ai/api/v1" class="w-100"/>
                            <label for="custom_llm_auth_header"/>
                            <field name="custom_llm_auth_header" placeholder="Authorization" class="w-100"/>
                            <label for="custom_llm_auth_prefix"/>
                            <field name="custom_llm_auth_prefix" placeholder="Bearer" class="w-100"/>
                            <label for="custom_llm_model"/>
                            <field name="custom_llm_model" placeholder="openrouter/free" class="w-100"/>
                            <label for="custom_llm_model_2"/>
                            <field name="custom_llm_model_2" placeholder="openai/gpt-4o-mini" class="w-100"/>
                            <label for="custom_llm_model_3"/>
                            <field name="custom_llm_model_3" placeholder="google/gemini-2.0-flash-exp:free" class="w-100"/>
                            <label for="custom_llm_model_4"/>
                            <field name="custom_llm_model_4" placeholder="meta-llama/llama-3.3-70b-instruct:free" class="w-100"/>
                            <label for="custom_llm_referer"/>
                            <field name="custom_llm_referer" placeholder="https://your-domain.example" class="w-100"/>
                            <label for="custom_llm_title"/>
                            <field name="custom_llm_title" placeholder="Your App Name" class="w-100"/>
                            <div class="mt-3 pt-3 border-top">
                                <h6 class="mb-1">Embeddings</h6>
                                <div class="text-muted small mb-2">
                                    The Claude and ChatGPT CLI accounts are text-only and cannot
                                    index documents, so knowledge sources are embedded by a
                                    separate service. It is a different endpoint with its own
                                    key — the fields above configure chat only.
                                </div>
                                <field name="embedding_service_status" readonly="1" class="w-100 mb-2"/>
                                <label for="custom_llm_embedding_base_url"/>
                                <field name="custom_llm_embedding_base_url"
                                       placeholder="https://embed.era.net.sa/v1" class="w-100"/>
                                <label for="custom_llm_embedding_key"/>
                                <field name="custom_llm_embedding_key" password="True"
                                       placeholder="bearer token for the embeddings endpoint"
                                       class="w-100"/>
                                <label for="custom_llm_embedding_model"/>
                                <field name="custom_llm_embedding_model"
                                       placeholder="intfloat/multilingual-e5-large" class="w-100"/>
                                <label for="custom_llm_embedding_batch_size"/>
                                <field name="custom_llm_embedding_batch_size"
                                       placeholder="32" class="w-100"/>
                                <label for="embedding_model_override"/>
                                <field name="embedding_model_override"
                                       placeholder="custom_llm/text-embedding-3-small"
                                       class="w-100"/>
                                <div class="text-muted small mt-2">
                                    The button fills these fields in; nothing is
                                    applied until you Save.
                                </div>
                                <div class="mt-2">
                                    <button name="action_restore_default_embedding_endpoint" type="object"
                                            string="Restore default endpoint"
                                            class="btn btn-primary btn-sm"/>
                                    <button name="action_test_embedding_endpoint" type="object"
                                            string="Test connection"
                                            class="btn btn-secondary btn-sm ms-1"/>
                                </div>
                            </div>
                        </div>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
