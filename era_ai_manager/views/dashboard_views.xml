<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_era_ai_dashboard_form" model="ir.ui.view">
        <field name="name">era.ai.dashboard.form</field>
        <field name="model">era.ai.dashboard</field>
        <field name="arch" type="xml">
            <form string="How the AI manager is doing" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-primary"/>
                    <button name="action_open_faults" type="object"
                            string="What is broken"
                            invisible="faults_critical == 0 and faults_warning == 0"/>
                    <button name="action_open_pending" type="object"
                            string="Waiting for you" invisible="pending_now == 0"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>How the AI manager is doing</h1>
                        <h5 class="text-muted">
                            Everything below covers <field name="period_label"
                            readonly="1" class="oe_inline"/> unless it says otherwise.
                        </h5>
                    </div>

                    <field name="verdict_html" widget="html" nolabel="1"
                           class="mb-3"/>

                    <group>
                        <group string="Is it running">
                            <label for="agents_active" string="AI staff switched on"/>
                            <div>
                                <field name="agents_active" readonly="1" class="oe_inline"/>
                                <span> of </span>
                                <field name="agents_total" readonly="1" class="oe_inline"/>
                            </div>
                            <field name="last_agent_run" readonly="1"
                                   string="Last successful run"/>
                            <field name="agent_failures" readonly="1"
                                   string="Runs that failed"/>
                            <field name="faults_critical" readonly="1"
                                   string="Broken now"/>
                            <field name="faults_warning" readonly="1"
                                   string="Worth a look"/>
                            <field name="assistant_failures" readonly="1"
                                   string="Visitors shown an error (7d)"/>
                        </group>
                        <group string="How it is set to behave">
                            <field name="autonomy_label" readonly="1" string="Autonomy"/>
                            <field name="window_label" readonly="1" string="Sends during"/>
                            <field name="window_open" readonly="1" string="Window open now"/>
                            <field name="period_days" string="Period (days)"/>
                        </group>
                    </group>

                    <group>
                        <group string="What it did">
                            <field name="sent_period" readonly="1" string="Messages sent"/>
                            <field name="marketing_period" readonly="1"
                                   string="— reaching out"/>
                            <field name="replies_period" readonly="1"
                                   string="— answering a customer"/>
                            <field name="pending_now" readonly="1"
                                   string="Waiting for your approval"/>
                            <field name="blocked_period" readonly="1"
                                   string="Held back by a guardrail"/>
                            <field name="blocked_reason" readonly="1"
                                   string="— most often because"
                                   invisible="not blocked_reason"/>
                        </group>
                        <group string="Did it arrive">
                            <field name="delivered_period" readonly="1"
                                   string="Accepted by the mail server"/>
                            <field name="bounced_period" readonly="1" string="Bounced"/>
                            <field name="failed_period" readonly="1"
                                   string="Could not be sent"/>
                        </group>
                    </group>

                    <group>
                        <group string="Who it reaches">
                            <field name="watchlists_approved" readonly="1"
                                   string="Audiences in use"/>
                            <field name="audience_size" readonly="1"
                                   string="Customers under watch"/>
                            <field name="contacts_reachable" readonly="1"
                                   string="Contacts with an email address"/>
                            <field name="reached_ever" readonly="1"
                                   string="Contacted at least once"/>
                            <field name="opted_out" readonly="1" string="Opted out"/>
                        </group>
                        <group string="Conversations">
                            <field name="conversations_period" readonly="1"
                                   string="Chats read"/>
                            <field name="converted_period" readonly="1"
                                   string="— became a lead or ticket"/>
                        </group>
                    </group>

                    <footer class="mt-3">
                        <button name="action_open_sent" type="object"
                                string="Open what was sent"/>
                        <button name="action_open_blocked" type="object"
                                string="Open what was held back"/>
                        <button name="action_open_conversations" type="object"
                                string="Open the conversations"/>
                        <button name="action_open_watchlists" type="object"
                                string="Open the audiences"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_era_ai_dashboard" model="ir.actions.server">
        <field name="name">Performance</field>
        <field name="model_id" ref="model_era_ai_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.open_dashboard()</field>
    </record>
</odoo>
