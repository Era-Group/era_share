<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_era_ai_dashboard_form" model="ir.ui.view">
        <field name="name">era.ai.dashboard.form</field>
        <field name="model">era.ai.dashboard</field>
        <field name="arch" type="xml">
            <form string="How the AI manager is doing" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-primary"/>
                    <button name="action_open_faults" type="object"
                            string="What is broken"
                            invisible="faults_critical == 0 and faults_warning == 0"/>
                    <button name="action_open_pending" type="object"
                            string="Waiting for you" invisible="pending_now == 0"/>
                    <button name="action_open_sent" type="object"
                            string="What was sent"/>
                    <button name="action_open_conversations" type="object"
                            string="Conversations"/>
                </header>
                <sheet>
                    <field name="board_html" widget="html" nolabel="1"/>
                    <group class="mt-3" col="4">
                        <field name="period_days" string="Show the last (days)"/>
                    </group>
                    <!-- Kept for filters, exports and automated checks; the
                         board above is what a person reads. -->
                    <group invisible="1">
                        <field name="faults_critical"/>
                        <field name="faults_warning"/>
                        <field name="pending_now"/>
                        <field name="sent_period"/>
                        <field name="marketing_period"/>
                        <field name="replies_period"/>
                        <field name="blocked_period"/>
                        <field name="blocked_reason"/>
                        <field name="delivered_period"/>
                        <field name="bounced_period"/>
                        <field name="failed_period"/>
                        <field name="agents_active"/>
                        <field name="agents_total"/>
                        <field name="agent_failures"/>
                        <field name="assistant_failures"/>
                        <field name="last_agent_run"/>
                        <field name="audience_size"/>
                        <field name="watchlists_approved"/>
                        <field name="contacts_reachable"/>
                        <field name="reached_ever"/>
                        <field name="opted_out"/>
                        <field name="conversations_period"/>
                        <field name="converted_period"/>
                        <field name="autonomy_label"/>
                        <field name="window_label"/>
                        <field name="window_open"/>
                        <field name="period_label"/>
                        <field name="verdict_html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_era_ai_dashboard" model="ir.actions.server">
        <field name="name">Performance</field>
        <field name="model_id" ref="model_era_ai_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.open_dashboard()</field>
    </record>

    <!-- One landing place per card. Declared as real actions rather than
         built in Python because a card is a link in an HTML field, and a link
         can only carry a URL. None of them is date-limited: the card counts a
         period, the list shows everything newest first, so the number and the
         list can never disagree with each other. -->
    <record id="action_dash_faults" model="ir.actions.act_window">
        <field name="name">Still broken</field>
        <field name="res_model">era.ai.watchdog.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
    </record>
    <record id="action_dash_broken_chats" model="ir.actions.act_window">
        <field name="name">Chats where the assistant failed</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', '=', 'livechat')]</field>
    </record>
    <record id="action_dash_pending" model="ir.actions.act_window">
        <field name="name">Waiting for your approval</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
    </record>
    <record id="action_dash_agents" model="ir.actions.act_window">
        <field name="name">The AI staff</field>
        <field name="res_model">aidoo.scheduled</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_dash_agent_failures" model="ir.actions.act_window">
        <field name="name">Runs that failed</field>
        <field name="res_model">aidoo.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'error')]</field>
    </record>
    <record id="action_dash_last_run" model="ir.actions.act_window">
        <field name="name">Agent runs</field>
        <field name="res_model">aidoo.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scheduled_id', '!=', False)]</field>
    </record>
    <record id="action_dash_sent" model="ir.actions.act_window">
        <field name="name">Messages sent</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>
    <record id="action_dash_marketing" model="ir.actions.act_window">
        <field name="name">Reaching out</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent'), ('play', '!=', 'reply')]</field>
    </record>
    <record id="action_dash_replies" model="ir.actions.act_window">
        <field name="name">Answers to customers</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent'), ('play', '=', 'reply')]</field>
    </record>
    <record id="action_dash_delivered" model="ir.actions.act_window">
        <field name="name">Accepted by the mail server</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent'), ('mail_id.state', '=', 'sent')]</field>
    </record>
    <record id="action_dash_undelivered" model="ir.actions.act_window">
        <field name="name">Did not reach anyone</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mail_id.state', 'in', ['exception', 'cancel'])]</field>
    </record>
    <record id="action_dash_blocked" model="ir.actions.act_window">
        <field name="name">Held back by a guardrail</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'blocked')]</field>
    </record>
    <record id="action_dash_audiences" model="ir.actions.act_window">
        <field name="name">Audiences</field>
        <field name="res_model">era.ai.watchlist</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approved')]</field>
    </record>
    <record id="action_dash_reachable" model="ir.actions.act_window">
        <field name="name">Contacts with an email address</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('email', '!=', False)]</field>
    </record>
    <record id="action_dash_conversations" model="ir.actions.act_window">
        <field name="name">Conversations read</field>
        <field name="res_model">era.ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_dash_opted_out" model="ir.actions.act_window">
        <field name="name">Opted out</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_blacklisted', '=', True)]</field>
    </record>
</odoo>
