<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_era_ai_outreach_search" model="ir.ui.view">
        <field name="name">era.ai.outreach.search</field>
        <field name="model">era.ai.outreach</field>
        <field name="arch" type="xml">
            <search string="Outreach">
                <field name="subject"/>
                <field name="email_to"/>
                <field name="partner_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="pending" string="Awaiting approval" domain="[('state', '=', 'pending')]"/>
                <filter name="blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_play" string="Play" context="{'group_by': 'play'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_era_ai_outreach_list" model="ir.ui.view">
        <field name="name">era.ai.outreach.list</field>
        <field name="model">era.ai.outreach</field>
        <field name="arch" type="xml">
            <list string="Outreach" create="false"
                  decoration-muted="state in ('rejected', 'sent')"
                  decoration-danger="state == 'blocked'"
                  decoration-bf="state == 'pending'">
                <field name="create_date" optional="show"/>
                <field name="play"/>
                <field name="channel" optional="hide"/>
                <field name="subject"/>
                <field name="email_to" optional="show"/>
                <field name="watchlist_id" optional="hide"/>
                <field name="agent_name" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'blocked'"/>
                <field name="block_reason" optional="show"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" invisible="state not in ('draft', 'pending')"/>
                <button name="action_reject" type="object" string="Reject"
                        icon="fa-times" invisible="state not in ('draft', 'pending')"/>
            </list>
        </field>
    </record>

    <record id="view_era_ai_outreach_form" model="ir.ui.view">
        <field name="name">era.ai.outreach.form</field>
        <field name="model">era.ai.outreach</field>
        <field name="arch" type="xml">
            <form string="Outreach" create="false">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state not in ('draft', 'pending')"/>
                    <button name="action_send" type="object" string="Approve &amp; Send now"
                            invisible="state not in ('draft', 'pending', 'approved')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved,sent"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Blocked" bg_color="text-bg-danger"
                            invisible="state != 'blocked'"/>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" readonly="state in ('sent', 'rejected')"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not block_reason">
                        <field name="block_reason" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="email_to" readonly="state in ('sent', 'rejected')"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="watchlist_id" readonly="1" invisible="not watchlist_id"/>
                            <field name="thread_model" invisible="1"/>
                            <field name="thread_id" invisible="1"/>
                            <div invisible="not thread_ref">
                                <label for="thread_ref"/>
                                <button name="action_open_thread" type="object"
                                        class="btn-link ps-0" icon="fa-external-link">
                                    <field name="thread_ref" readonly="1" nolabel="1"/>
                                </button>
                            </div>
                        </group>
                        <group string="Classification">
                            <field name="play" readonly="state in ('sent', 'rejected')"/>
                            <field name="channel" readonly="state in ('sent', 'rejected')"/>
                            <field name="lang" readonly="state in ('sent', 'rejected')"/>
                            <field name="agent_name" readonly="1"/>
                            <field name="sent_at" readonly="1" invisible="state != 'sent'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="message">
                            <field name="body_html" widget="html"
                                   readonly="state in ('sent', 'rejected')"/>
                        </page>
                        <page string="Why this, why now" name="rationale">
                            <field name="rationale" readonly="1"
                                   placeholder="The agent's reasoning — never sent to the customer."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_era_ai_outreach" model="ir.actions.act_window">
        <field name="name">Outreach</field>
        <field name="res_model">era.ai.outreach</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
