<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_bwatech_sync" model="ir.cron">
        <field name="name">BWATECH: Sync Banks</field>
        <field name="model_id" ref="model_bwatech_connection"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
<!--        <field name="numbercall">-1</field>-->
        <field name="active">False</field>
    </record>

    <record id="ir_cron_bwatech_gc_logs" model="ir.cron">
        <field name="name">BWATECH: Cleanup API Logs</field>
        <field name="model_id" ref="model_bwatech_connection"/>
        <field name="state">code</field>
        <field name="code">model.cron_gc_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
<!--        <field name="numbercall">-1</field>-->
        <field name="active">True</field>
    </record>
</odoo>
