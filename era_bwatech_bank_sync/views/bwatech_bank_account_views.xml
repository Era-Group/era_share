<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bwatech_bank_account_tree" model="ir.ui.view">
        <field name="name">bwatech.bank.account.tree</field>
        <field name="model">bwatech.bank.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_account"/>
                <field name="bank_name"/>
                <field name="bank_code"/>
                <field name="currency_code"/>
                <field name="balance"/>
                <field name="balance_synced_at"/>
                <field name="last_sequence_number"/>
                <field name="journal_id"/>
                <field name="sync_transactions"/>
            </list>
        </field>
    </record>

    <record id="view_bwatech_bank_account_form" model="ir.ui.view">
        <field name="name">bwatech.bank.account.form</field>
        <field name="model">bwatech.bank.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_balance" type="object" string="Refresh Balance" class="btn-primary"/>
                    <button name="action_sync_transactions" type="object" string="Sync Transactions"/>
                    <button name="action_post_transactions" type="object"
                            string="Post to Journal"
                            invisible="unposted_count == 0"
                            confirm="سيُنشئ أودو قيدًا مُرحَّلًا لكل حركة. تأكّدي أن اليومية صحيحة وأن إشارة المبالغ مُتحقَّق منها."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="account_name"/>
                            <field name="iban"/>
                            <field name="bban"/>
                            <field name="bank_name"/>
                            <field name="bank_code"/>
                        </group>
                        <group>
                            <field name="entity_name"/>
                            <field name="currency_code"/>
                            <field name="balance"/>
                            <field name="balance_synced_at"/>
                            <field name="journal_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="sync_transactions"/>
                            <field name="auto_post"/>
                            <field name="unposted_count"/>
                            <field name="last_sequence_number"/>
                        </group>
                    </group>
                    <field name="transaction_ids" readonly="1">
                        <list>
                            <field name="sequence_number"/>
                            <field name="entry_date"/>
                            <field name="amount"/>
                            <field name="transaction_type_description"/>
                            <field name="bank_reference"/>
                            <field name="third_party_name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bwatech_bank_account" model="ir.actions.act_window">
        <field name="name">Bank Accounts</field>
        <field name="res_model">bwatech.bank.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
