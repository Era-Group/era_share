<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bwatech_connection_tree" model="ir.ui.view">
        <field name="name">bwatech.connection.tree</field>
        <field name="model">bwatech.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment"/>
                <field name="active"/>
                <field name="last_accounts_sync_at"/>
                <field name="last_transactions_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_bwatech_connection_form" model="ir.ui.view">
        <field name="name">bwatech.connection.form</field>
        <field name="model">bwatech.connection</field>
        <field name="arch" type="xml">
            <form string="BWATECH Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                    <button name="action_sync_accounts" type="object" string="Sync Accounts"/>
                    <button name="action_sync_all" type="object" string="Sync All"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_logs" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <field name="log_count" widget="statinfo" string="API Logs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="client_id"/>
                            <field name="active"/>
                            <field name="auto_sync"/>
                        </group>
                        <group>
                            <field name="certificate_filename" invisible="1"/>
                            <field name="certificate_file" widget="binary"
                                   filename="certificate_filename"/>
                            <field name="private_key_filename" invisible="1"/>
                            <field name="private_key_file" widget="binary"
                                   filename="private_key_filename"/>
                            <field name="verify_ssl"/>
                            <field name="include_child_entities"/>
                        </group>
                    </group>
                    <group string="Logging &amp; Diagnostics">
                        <field name="log_mode"/>
                        <field name="log_retention_days"/>
                        <field name="log_error_count" readonly="1"/>
                    </group>
                    <group string="Status">
                        <field name="last_token_at" readonly="1"/>
                        <field name="token_expires_at" readonly="1"/>
                        <field name="last_accounts_sync_at" readonly="1"/>
                        <field name="last_transactions_sync_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Accounts">
                            <field name="account_ids" readonly="1">
                                <list>
                                    <field name="display_account"/>
                                    <field name="bank_name"/>
                                    <field name="currency_code"/>
                                    <field name="balance"/>
                                    <field name="last_sequence_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bwatech_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">bwatech.connection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
