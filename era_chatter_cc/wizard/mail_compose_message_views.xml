<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="email_compose_message_wizard_form_cc">
        <field name="name">mail.compose.message.form.cc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject']" position="before">
                <label for="partner_cc_ids" string="Cc"
                       invisible="composition_mode != 'comment' or subtype_is_log"/>
                <field name="partner_cc_ids" widget="many2many_tags_email"
                       placeholder="Add recipients in copy..."
                       groups="base.group_user"
                       invisible="composition_mode != 'comment' or subtype_is_log"
                       options="{'edit_tags': True}"
                       context="{'force_email': True, 'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"/>
            </xpath>
        </field>
    </record>
</odoo>
