        </record>

        <!-- ============ ALLaM (Saudi Arabic LLM) ============ -->
        <!-- Self-hosted / regional endpoint: pricing 0 by default; set if billed.
             Arabic-first model; keep a human in the loop for Arabic messages. -->
        <record id="model_allam" model="crm.ai.model">
            <field name="name">ALLaM</field>
            <field name="code">allam-2-7b</field>
            <field name="provider">allam</field>
            <field name="tier">cheap</field>
            <field name="price_input_1k">0.0</field>
