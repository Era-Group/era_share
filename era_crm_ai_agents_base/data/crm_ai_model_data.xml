<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate card (pricing only) — seeded once; managers maintain prices and add
         rows as providers change pricing or Odoo adds models. noupdate="1" so
         manager edits survive upgrades.

         This is NOT the model list (Odoo native AI owns that). It only supplies
         per-token PRICING so the cost cap (Rule 14) can compute spend. A call on
         a code not listed here is a Rule-14 fail-safe (blocked by default).
         REVIEW these prices when OpenAI/Google change their rate cards. -->
    <data noupdate="1">

        <!-- ============ OpenAI ============ -->
        <record id="model_gpt_41_mini" model="crm.ai.model">
            <field name="name">GPT-4.1 mini</field>
            <field name="code">gpt-4.1-mini</field>
            <field name="provider">openai</field>
            <field name="price_input_1k">0.0004</field>
            <field name="price_output_1k">0.0016</field>
        </record>

        <record id="model_gpt_4o" model="crm.ai.model">
            <field name="name">GPT-4o</field>
            <field name="code">gpt-4o</field>
            <field name="provider">openai</field>
            <field name="price_input_1k">0.0025</field>
            <field name="price_output_1k">0.01</field>
        </record>

        <!-- ============ Google (Gemini) ============ -->
        <record id="model_gemini_25_flash" model="crm.ai.model">
            <field name="name">Gemini 2.5 Flash</field>
            <field name="code">gemini-2.5-flash</field>
            <field name="provider">google</field>
            <field name="price_input_1k">0.0003</field>
            <field name="price_output_1k">0.0025</field>
        </record>

        <record id="model_gemini_25_pro" model="crm.ai.model">
            <field name="name">Gemini 2.5 Pro</field>
            <field name="code">gemini-2.5-pro</field>
            <field name="provider">google</field>
            <field name="price_input_1k">0.00125</field>
            <field name="price_output_1k">0.01</field>
        </record>

    </data>
</odoo>
