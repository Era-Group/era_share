<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": seeded once on install; admins maintain pricing afterwards
         and their edits survive module upgrades. -->
    <data noupdate="1">

        <!-- ============ Anthropic (Claude) ============ -->
        <!-- Pricing from the authoritative Claude model reference (USD / 1K tokens). -->
        <record id="model_claude_haiku_45" model="crm.ai.model">
            <field name="name">Claude Haiku 4.5</field>
            <field name="code">claude-haiku-4-5</field>
            <field name="provider">anthropic</field>
            <field name="tier">cheap</field>
            <field name="price_input_1k">0.001</field>
            <field name="price_output_1k">0.005</field>
            <field name="max_context">200000</field>
            <field name="env_key_param">era_crm_ai_agents.anthropic_api_key</field>
        </record>

        <record id="model_claude_sonnet_46" model="crm.ai.model">
            <field name="name">Claude Sonnet 4.6</field>
