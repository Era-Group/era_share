<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": seeded once; admins adjust the cap afterwards and their
         change survives module upgrades. -->
    <data noupdate="1">

        <!-- Global monthly cost cap in USD (Rule 14). 0 or negative = no cap.
             Governs the PRICED native API path (OpenAI/Google). -->
        <record id="param_monthly_cost_cap" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.monthly_cost_cap</field>
            <field name="value">100.0</field>
        </record>

        <!-- Global monthly TOKEN limit (Rule 14) for the Claude CLI / subscription
             path, where there is no dollar cost. ESTIMATED tokens. 0 or negative =
             no limit (unbounded). Seeded bounded so the subscription path is never
             silently unlimited; managers raise/lower it (global or per-agent key
             era_crm_ai_agents.monthly_token_limit.<tech_name>). -->
        <record id="param_monthly_token_limit" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.monthly_token_limit</field>
            <field name="value">2000000</field>
        </record>

        <!--
        Per-agent overrides are config parameters too, added per deployment once
        the agents exist (a satellite module is installed). The key is the global
        key suffixed with the agent's tech_name, e.g.:

            era_crm_ai_agents.monthly_cost_cap.era_dead_lead   ->  50.0

        is_over_cap() reads the per-agent key first, then falls back to the
        global cap above.
        -->

        <!-- Protection-layer toggles (Change 1). Seeded True so the manager
             Settings checkboxes match the guard's default-ON behaviour. The
             guard also treats a missing param as ON (fail-safe). -->
        <record id="param_enable_cost_cap" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.enable_cost_cap</field>
            <field name="value">True</field>
        </record>
        <record id="param_enable_audit" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.enable_audit</field>
            <field name="value">True</field>
        </record>
        <record id="param_enable_pii_redaction" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.enable_pii_redaction</field>
            <field name="value">True</field>
        </record>
        <record id="param_enable_consent_check" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.enable_consent_check</field>
            <field name="value">True</field>
        </record>
        <!-- Rule 14 fail-safe: block AI calls on models with no rate-card price. -->
        <record id="param_block_unpriced_model" model="ir.config_parameter">
            <field name="key">era_crm_ai_agents.block_unpriced_model</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>
