#. module: era_crm_ai_agents_base
#: model_terms:ir.ui.view,arch_db:era_crm_ai_agents_base.res_config_settings_view_form_crm_ai
msgid ""
"<i class=\"fa fa-exclamation-triangle\"/>\n"
"                                <strong>OdooBot runs agents as the superuser.</strong>\n"
"                                It <strong>bypasses all access rules and record\n"
"                                rules</strong>, contradicts Rule 09 (agents must run\n"
"                                under real permissions, never the superuser), and\n"
"                                carries <strong>PDPL risk</strong>: scheduled agents\n"
"                                would process individuals' personal data with\n"
"                                unrestricted access to every record in the database.\n"
"                                Use a dedicated internal user instead unless you\n"
"                                fully accept this."
msgstr ""
"<i class=\"fa fa-exclamation-triangle\"/>\n"
"                                <strong>يشغّل OdooBot الوكلاء بصلاحيات المستخدم الخارق.</strong>\n"
"                                وهو <strong>يتجاوز جميع قواعد الوصول وقواعد\n"
"                                السجلات</strong>، ويخالف القاعدة Rule 09 (يجب تشغيل الوكلاء\n"
"                                بصلاحيات حقيقية، لا بصلاحيات المستخدم الخارق إطلاقاً)،\n"
"                                ويحمل <strong>مخاطر PDPL</strong>: إذ ستعالج الوكلاء المجدولة\n"
"                                البيانات الشخصية للأفراد مع وصول\n"
"                                غير مقيّد إلى كل سجل في قاعدة البيانات.\n"
"                                استخدم مستخدماً داخلياً مخصّصاً بدلاً من ذلك ما لم\n"
"                                تقبل هذا المخاطرة بالكامل."

