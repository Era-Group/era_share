<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_ai_audit_log_list" model="ir.ui.view">
        <field name="name">crm.ai.audit.log.list</field>
        <field name="model">crm.ai.audit.log</field>
        <field name="arch" type="xml">
            <list string="AI Audit Log" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="model_ref"/>
            </list>
        </field>
    </record>

    <record id="view_crm_ai_audit_log_form" model="ir.ui.view">
        <field name="name">crm.ai.audit.log.form</field>
        <field name="model">crm.ai.audit.log</field>
        <field name="arch" type="xml">
            <form string="AI Audit Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="agent_id"/>
                            <field name="user_id"/>
                            <field name="model_ref"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Before">
                        <field name="value_before" nolabel="1"/>
                    </group>
                    <group string="After">
                        <field name="value_after" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_ai_audit_log_search" model="ir.ui.view">
        <field name="name">crm.ai.audit.log.search</field>
        <field name="model">crm.ai.audit.log</field>
        <field name="arch" type="xml">
            <search string="AI Audit Log">
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <group expand="0" string="Group By">
                    <filter name="group_event" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crm_ai_audit_log" model="ir.actions.act_window">
        <field name="name">AI Audit Log</field>
        <field name="res_model">crm.ai.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_ai_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit entries yet.
            </p>
            <p>
                Every sensitive AI decision is recorded here (Rule 20).
                Entries are append-only and cannot be edited or deleted.
            </p>
        </field>
    </record>

</odoo>
