<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_ai_model_list" model="ir.ui.view">
        <field name="name">crm.ai.model.list</field>
        <field name="model">crm.ai.model</field>
        <field name="arch" type="xml">
            <list string="AI Model Pricing" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="provider"/>
                <field name="price_input_1k"/>
                <field name="price_output_1k"/>
            </list>
        </field>
    </record>

    <record id="view_crm_ai_model_form" model="ir.ui.view">
        <field name="name">crm.ai.model.form</field>
        <field name="model">crm.ai.model</field>
        <field name="arch" type="xml">
            <form string="AI Model Pricing">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. GPT-4o"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Model">
                            <field name="code" placeholder="e.g. gpt-4o, gemini-2.5-flash"/>
                            <field name="provider"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Pricing (USD / 1K tokens)">
                            <field name="price_input_1k"/>
                            <field name="price_output_1k"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Rate card only — the list of available models is owned by
                        Odoo native AI. This supplies per-token pricing so the cost
                        cap (Rule 14) can be computed. Review prices when a provider
                        changes its rates or Odoo adds a model.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_ai_model_search" model="ir.ui.view">
        <field name="name">crm.ai.model.search</field>
        <field name="model">crm.ai.model</field>
        <field name="arch" type="xml">
            <search string="AI Model Pricing">
                <field name="name"/>
                <field name="code"/>
                <field name="provider"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crm_ai_model" model="ir.actions.act_window">
        <field name="name">AI Model Pricing</field>
        <field name="res_model">crm.ai.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_ai_model_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a model price to the rate card.
            </p>
            <p>
                This is a pricing rate card keyed by model code — not the model
                list (Odoo native AI owns that). Seeded with OpenAI (GPT) and
                Google (Gemini) prices; keep it complete so the cost cap (Rule 14)
                stays accurate as providers change pricing.
            </p>
        </field>
    </record>

</odoo>
