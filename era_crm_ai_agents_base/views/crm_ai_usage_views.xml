<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_ai_usage_list" model="ir.ui.view">
        <field name="name">crm.ai.usage.list</field>
        <field name="model">crm.ai.usage</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="false" edit="false"
                  decoration-warning="unpriced" decoration-info="via_cli">
                <field name="create_date"/>
                <field name="agent_id"/>
                <field name="model_id"/>
                <field name="input_tokens" sum="Input"/>
                <field name="output_tokens" sum="Output"/>
                <field name="total_tokens" sum="Total"/>
                <field name="token_source"/>
                <field name="via_cli" widget="boolean_toggle" readonly="1"
                       string="CLI"/>
                <field name="cost" sum="Cost" widget="monetary"/>
                <field name="unpriced" widget="boolean_toggle" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_crm_ai_usage_search" model="ir.ui.view">
        <field name="name">crm.ai.usage.search</field>
        <field name="model">crm.ai.usage</field>
        <field name="arch" type="xml">
            <search string="AI Usage">
                <field name="agent_id"/>
                <field name="model_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('create_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="unpriced" string="Unpriced (no rate)" domain="[('unpriced', '=', True)]"/>
                <filter name="via_cli" string="CLI / Subscription" domain="[('via_cli', '=', True)]"/>
                <filter name="via_api" string="Priced API" domain="[('via_cli', '=', False)]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_transport" string="Transport" context="{'group_by': 'via_cli'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_crm_ai_usage_pivot" model="ir.ui.view">
        <field name="name">crm.ai.usage.pivot</field>
        <field name="model">crm.ai.usage</field>
        <field name="arch" type="xml">
            <pivot string="AI Usage">
                <field name="agent_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="cost" type="measure"/>
                <field name="total_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_crm_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">crm.ai.usage</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_crm_ai_usage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI usage recorded yet.
            </p>
            <p>
                Every LLM call records a row here with its token counts and cost,
                feeding the monthly cost cap (Rule 14).
            </p>
        </field>
    </record>

</odoo>
