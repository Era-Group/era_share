<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Open the Settings page focused on this module's OWN app block. -->
    <record id="action_crm_ai_campaign_settings" model="ir.actions.act_window">
        <field name="name">Campaign Agent Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'era_crm_ai_agents_campaign'}</field>
    </record>

    <!-- Suite menu convention: a SELF-CONTAINED functional module gets its
         OWN standalone root menu (separate navbar app icon, PNG per Odoo 19
         core convention), NOT parented to the Base root. Campaigns are
         visible to AI users (they may be approvers); configuration is
         manager-only. -->
    <menuitem id="menu_crm_ai_campaign_root"
              name="Campaign Agent"
              web_icon="era_crm_ai_agents_campaign,static/description/icon.png"
              sequence="52"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <menuitem id="menu_crm_ai_campaign_campaigns"
              name="Campaigns"
              parent="menu_crm_ai_campaign_root"
              action="action_crm_ai_campaign"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <menuitem id="menu_crm_ai_campaign_config"
              name="Configuration"
              parent="menu_crm_ai_campaign_root"
              sequence="50"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_campaign_catalog"
              name="Service Catalog"
              parent="menu_crm_ai_campaign_config"
              action="action_crm_ai_campaign_catalog"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_campaign_category"
              name="Service Categories"
              parent="menu_crm_ai_campaign_config"
              action="action_crm_ai_campaign_category"
              sequence="20"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_campaign_playbook"
              name="Playbooks"
              parent="menu_crm_ai_campaign_config"
              action="action_crm_ai_campaign_playbook"
              sequence="30"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_campaign_suppression"
              name="Suppression List"
              parent="menu_crm_ai_campaign_config"
              action="action_crm_ai_campaign_suppression"
              sequence="40"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_campaign_settings"
              name="Settings"
              parent="menu_crm_ai_campaign_config"
              action="action_crm_ai_campaign_settings"
              sequence="50"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

</odoo>
