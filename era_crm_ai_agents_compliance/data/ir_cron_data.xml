<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- PDPL 72-hour opt-out safety net. Runs as root so it can reconcile
             consent across all contacts. process_opt_out is synchronous, so
             opt-outs are normally applied instantly; this cron only catches any
             request that was recorded without being processed, and flags an SLA
             breach if one slipped past 72h. -->
        <record id="ir_cron_crm_ai_enforce_opt_out_72h" model="ir.cron">
            <field name="name">CRM AI Compliance: Enforce 72h opt-out</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_enforce_72h()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Warm the prayer-time cache daily (today + tomorrow) for active
             cities, so send-time lookups are fast and resilient. Runs as root.
             Sends only city + date to the API — never PII (egress registry). -->
        <record id="ir_cron_crm_ai_warm_prayer_cache" model="ir.cron">
            <field name="name">CRM AI Compliance: Warm prayer-time cache</field>
            <field name="model_id" ref="model_crm_ai_prayer_cache"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_warm_prayer_cache()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
