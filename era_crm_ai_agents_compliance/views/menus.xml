<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Suite menu convention: a CROSS-CUTTING module (Compliance guards every
         sending agent) lives UNDER the Base root menu — it does NOT get its own
         navbar app. It owns a dedicated "Compliance" group, a peer of Dashboard
         / Agents / Approvals / Configuration, manager-gated, with its five
         screens nested beneath it (they were previously flattened directly into
         the Base's Configuration menu). Compliance SETTINGS deliberately stay in
         the shared Base settings app (see res_config_settings_views.xml). -->
    <menuitem id="menu_crm_ai_compliance_root"
              name="Compliance"
              parent="era_crm_ai_agents_base.menu_crm_ai_root"
              sequence="40"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_compliance_consent"
              name="Consent Log"
              parent="menu_crm_ai_compliance_root"
              action="action_crm_ai_consent"
              sequence="40"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_compliance_status"
              name="Compliance Status"
              parent="menu_crm_ai_compliance_root"
              action="action_crm_ai_consent_status"
              sequence="50"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_compliance_dsar"
              name="DSAR Requests"
              parent="menu_crm_ai_compliance_root"
              action="action_crm_ai_dsar_wizard"
              sequence="60"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_compliance_norms"
              name="Norm Vocabulary"
              parent="menu_crm_ai_compliance_root"
              action="action_crm_ai_norm_term"
              sequence="65"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_compliance_settings"
              name="Compliance Settings"
              parent="menu_crm_ai_compliance_root"
              action="action_crm_ai_compliance_settings"
              sequence="70"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

</odoo>
