<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_ai_dead_lead_agent_form" model="ir.ui.view">
        <field name="name">crm.ai.dead.lead.agent.form</field>
        <field name="model">crm.ai.dead.lead.agent</field>
        <field name="arch" type="xml">
            <form string="Dead-Lead Agent">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group string="Trigger">
                            <field name="elapsed_days_threshold"/>
                            <field name="template_id"/>
                        </group>
                        <group string="Scheduled Scan">
                            <field name="scan_enabled"/>
                            <field name="scan_batch_size"/>
                            <field name="cooldown_days"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Set <b>elapsed_days_threshold</b> to 0 to disable the
                        elapsed-time trigger. The scan stays inert until
                        <b>Enable Scheduled Scan</b> is on; it never sends —
                        every comeback still goes through compliance and human
                        approval.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_ai_dead_lead_agent_list" model="ir.ui.view">
        <field name="name">crm.ai.dead.lead.agent.list</field>
        <field name="model">crm.ai.dead.lead.agent</field>
        <field name="arch" type="xml">
            <list string="Dead-Lead Agent">
                <field name="name"/>
                <field name="elapsed_days_threshold"/>
                <field name="template_id"/>
                <field name="scan_enabled" widget="boolean_toggle"/>
                <field name="scan_batch_size"/>
                <field name="cooldown_days"/>
            </list>
        </field>
    </record>

    <record id="action_crm_ai_dead_lead_agent" model="ir.actions.act_window">
        <field name="name">Dead-Lead Settings</field>
        <field name="res_model">crm.ai.dead.lead.agent</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
