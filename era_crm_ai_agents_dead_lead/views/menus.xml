<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Suite menu convention: Dead-Lead Resurrection is a SELF-CONTAINED agent
         with its own distinct behaviour (scan → classify → draft → approve →
         send) and its own settings/template management UI, so — like Enrichment
         and Lead Generation — it gets its OWN standalone top-level navbar app,
         NOT parented to the Base root. web_icon is a brand-neutral 140x140 PNG
         under static/description (PNG, not SVG, per Odoo 19 core convention).
         The root stays AI-user-gated (not manager-only) because it carries the
         user-facing boards (Candidates / Comeback Approvals / Results);
         configuration beneath it is manager-gated. -->
    <menuitem id="menu_crm_ai_dead_lead_root"
              name="Dead-Lead Resurrection"
              web_icon="era_crm_ai_agents_dead_lead,static/description/icon.png"
              sequence="48"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <menuitem id="menu_crm_ai_dead_lead_candidates"
              name="Candidates"
              parent="menu_crm_ai_dead_lead_root"
              action="action_dead_lead_candidates"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <menuitem id="menu_crm_ai_dead_lead_approvals"
              name="Comeback Approvals"
              parent="menu_crm_ai_dead_lead_root"
              action="action_dead_lead_approvals"
              sequence="20"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <menuitem id="menu_crm_ai_dead_lead_results"
              name="Results"
              parent="menu_crm_ai_dead_lead_root"
              action="action_dead_lead_results"
              sequence="30"
              groups="era_crm_ai_agents_base.group_crm_ai_user"/>

    <!-- Configuration (managers only) -->
    <menuitem id="menu_crm_ai_dead_lead_config"
              name="Configuration"
              parent="menu_crm_ai_dead_lead_root"
              sequence="90"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_dead_lead_settings"
              name="Dead-Lead Settings"
              parent="menu_crm_ai_dead_lead_config"
              action="action_crm_ai_dead_lead_agent"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_dead_lead_templates"
              name="Comeback Templates"
              parent="menu_crm_ai_dead_lead_config"
              action="action_crm_ai_dead_lead_template"
              sequence="20"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

</odoo>
