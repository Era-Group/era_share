<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Settings action: opens the unified Settings page focused on Enrichment's
         OWN sibling app block (context module selects the <app> pane). -->
    <record id="action_crm_ai_enrichment_settings" model="ir.actions.act_window">
        <field name="name">Enrichment Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'era_crm_ai_agents_enrichment'}</field>
    </record>

    <!-- Suite menu convention: a SELF-CONTAINED functional module (Enrichment is
         its own engine with its own provider/request management UI) gets its OWN
         standalone top-level navbar app, NOT parented to the Base root. Manager-
         gated; a brand-neutral PNG web_icon (PNG, not SVG, per Odoo 19 core
         convention). -->
    <menuitem id="menu_crm_ai_enrichment_root"
              name="Enrichment"
              web_icon="era_crm_ai_agents_enrichment,static/description/icon.png"
              sequence="55"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_enrichment_requests"
              name="Requests"
              parent="menu_crm_ai_enrichment_root"
              action="action_crm_ai_enrichment_request"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_enrichment_providers"
              name="Providers"
              parent="menu_crm_ai_enrichment_root"
              action="action_crm_ai_enrichment_provider"
              sequence="20"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_enrichment_performance"
              name="Provider Performance"
              parent="menu_crm_ai_enrichment_root"
              action="action_crm_ai_enrichment_attempt"
              sequence="25"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_enrichment_settings"
              name="Settings"
              parent="menu_crm_ai_enrichment_root"
              action="action_crm_ai_enrichment_settings"
              sequence="30"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

</odoo>
