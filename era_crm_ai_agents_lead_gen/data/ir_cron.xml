<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled lead-generation run.

             Execution identity is SUITE-WIDE and configurable, not hardcoded
             here (Rule 09). The cron resolves its run-user at run time via the
             Base resolver crm.ai.agent._get_cron_run_user(), which returns the
             internal account chosen in Settings (default: the least-privilege
             "CRM AI Automation" user) or OdooBot if a manager opted in. A
             setting change therefore takes effect on the NEXT run — no cron
             record needs rewriting. The static user_id below is only the safe
             bootstrap identity (the same least-privilege automation account),
             so the run is never root unless explicitly configured.

             It calls the SAME entrypoint as a manual run, with unattended=True
             so any guard block becomes skip-with-audit (never raises in a
             scheduled context).

             Governance is the SINGLE master toggle: the cron ships active=True,
             but the engine no-ops immediately when lead_gen_enabled=False, so it
             is fully inert until a manager enables the module. It does NOT
             short-circuit the daily cap — the unattended path goes through the
             identical dual enforcement (pre-fetch check + per-record check at
             creation) as the interactive flow.

             New ir.cron records require a full server RESTART to register (see
             Dev Environment Notes) — a module upgrade alone is not enough. -->
        <record id="ir_cron_lead_gen_run" model="ir.cron">
            <field name="name">Lead Generation: Scheduled fetch</field>
            <field name="model_id" ref="model_crm_ai_lead_gen_agent"/>
            <field name="user_id" ref="era_crm_ai_agents_base.user_crm_ai_automation"/>
            <field name="state">code</field>
            <field name="code">model.with_user(env['crm.ai.agent']._get_cron_run_user()).run_lead_generation(unattended=True)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
