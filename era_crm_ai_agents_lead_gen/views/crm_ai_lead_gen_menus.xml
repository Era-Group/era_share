<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Open the Lead Generation block on the global Settings page. The block
         lives inside the Base's "CRM AI Agents" app (manager-gated), so the
         context targets that module — same pattern as Compliance Settings. -->
    <record id="action_crm_ai_lead_gen_settings" model="ir.actions.act_window">
        <field name="name">Lead Generation Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'era_crm_ai_agents_base'}</field>
    </record>

    <!-- Manager-only "Lead Generation" menu group under the Base CRM-AI root. -->
    <menuitem id="menu_crm_ai_lead_gen_root"
              name="Lead Generation"
              parent="era_crm_ai_agents_base.menu_crm_ai_root"
              sequence="50"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_lead_gen_sources"
              name="Sources"
              parent="menu_crm_ai_lead_gen_root"
              action="action_crm_ai_lead_gen_provider"
              sequence="10"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_lead_gen_sourced"
              name="Externally-Sourced Records"
              parent="menu_crm_ai_lead_gen_root"
              action="action_crm_ai_lead_gen_sourced_partners"
              sequence="20"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

    <menuitem id="menu_crm_ai_lead_gen_settings"
              name="Settings"
              parent="menu_crm_ai_lead_gen_root"
              action="action_crm_ai_lead_gen_settings"
              sequence="30"
              groups="era_crm_ai_agents_base.group_crm_ai_manager"/>

</odoo>
