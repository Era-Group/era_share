<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ List: orderable by priority, toggle active inline ====== -->
    <record id="view_crm_ai_lead_gen_provider_list" model="ir.ui.view">
        <field name="name">crm.ai.lead_gen.provider.list</field>
        <field name="model">crm.ai.lead_gen.provider</field>
        <field name="arch" type="xml">
            <list string="Lead-Gen Sources" default_order="priority, name">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="category"/>
                <field name="pdpl_sensitivity"/>
                <field name="env_key_param" optional="show"/>
                <!-- Non-stored compute: display only (cannot be sorted/searched). -->
                <field name="token_present" string="Token" optional="show"/>
                <field name="cost" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ Form ================================================== -->
    <record id="view_crm_ai_lead_gen_provider_form" model="ir.ui.view">
        <field name="name">crm.ai.lead_gen.provider.form</field>
        <field name="model">crm.ai.lead_gen.provider</field>
        <field name="arch" type="xml">
            <form string="Lead-Gen Source">
                <sheet>
                    <widget name="web_ribbon" title="Inactive"
                            bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Source name"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="provider_type"/>
                            <field name="category"/>
                            <field name="pdpl_sensitivity"/>
                            <field name="priority"/>
                        </group>
                        <group string="Activation">
                            <field name="active"/>
                            <field name="env_key_param"/>
                            <field name="token_present"/>
                            <field name="cost"/>
                            <field name="fields_filled"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        A source enters the waterfall only when it is
                        <b>Active</b> AND its token environment variable resolves
                        (<b>Token</b> = ✓). Activation is a legal/operational
                        decision — review PDPL before enabling, especially for
                        decision-maker (heavy) sources.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Search ================================================ -->
    <record id="view_crm_ai_lead_gen_provider_search" model="ir.ui.view">
        <field name="name">crm.ai.lead_gen.provider.search</field>
        <field name="model">crm.ai.lead_gen.provider</field>
        <field name="arch" type="xml">
            <search string="Lead-Gen Sources">
                <field name="name"/>
                <field name="env_key_param"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="cat_company" string="Company"
                        domain="[('category', '=', 'company')]"/>
                <filter name="cat_decision_maker" string="Decision-Maker"
                        domain="[('category', '=', 'decision_maker')]"/>
                <filter name="cat_verification" string="Verification"
                        domain="[('category', '=', 'verification')]"/>
                <separator/>
                <filter name="pdpl_heavy" string="PDPL Heavy"
                        domain="[('pdpl_sensitivity', '=', 'heavy')]"/>
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'provider_type'}"/>
                    <filter name="group_pdpl" string="PDPL Sensitivity"
                            context="{'group_by': 'pdpl_sensitivity'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ Action ================================================ -->
    <record id="action_crm_ai_lead_gen_provider" model="ir.actions.act_window">
        <field name="name">Lead-Gen Sources</field>
        <field name="res_model">crm.ai.lead_gen.provider</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_ai_lead_gen_provider_search"/>
        <!-- 'active' is Odoo's archive field and every source ships active=False,
             so without active_test=False the list would look empty. Managers
             must see ALL sources to toggle them on. -->
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No lead-gen sources found.</p>
            <p>Sources are seeded on install (all inactive). Toggle a source
               Active and set its token environment variable to bring it into the
               prospecting waterfall.</p>
        </field>
    </record>

</odoo>
