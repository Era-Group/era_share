<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ##################### List ######################### -->
        <record id="crm_etimad_form_client" model="ir.ui.view">
            <field name="name">crm.etimad.client.list</field>
            <field name="model">crm.etimad.client</field>
            <field name="arch" type="xml">
                <list string="Etimad Tenders" create="false" delete="false" edit="false"
                      default_order="ai_match_score desc, limit asc"
                      decoration-danger="limit and limit &lt; current_date"
                      decoration-muted="lead_id">
                    <header>
                        <button name="action_ai_match" type="object" string="AI Match"
                                class="btn-secondary" icon="fa-magic"
                                confirm="Run AI matching? Selected tenders are re-analyzed — the first 30 now, the rest by the scheduler. With no selection, the next batch of un-analyzed tenders is scored."
                                title="Re-analyze the selected tenders (first 30 now, the rest by the scheduler); scores a new batch if none selected"/>
                    </header>
                    <field name="name"/>
                    <field name="ref"/>
                    <field name="company"/>
                    <field name="cost"/>
                    <field name="method"/>
                    <field name="questions"/>
                    <field name="limit"/>
                    <field name="publish"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="ai_match" column_invisible="1"/>
                    <field name="ai_match_date" column_invisible="1"/>
                    <field name="ai_match_score" string="Business Match" class="text-center fw-bold fs-5"
                           invisible="not ai_match_date"
                           decoration-success="ai_match == 'high'"
                           decoration-info="ai_match == 'medium'"
                           decoration-muted="ai_match == 'low'"/>
                    <field name="ai_match_reason" optional="hide"/>
                    <field name="study_state" widget="badge"
                           decoration-info="study_state == 'to_review'"
                           decoration-success="study_state == 'studyable'"
                           decoration-danger="study_state == 'rejected'"
                           decoration-muted="study_state == 'converted'"/>
                    <field name="lead_id" optional="hide"/>
                    <button name="etimad_open_link" type="object" string=""
                            class="fa fa-external-link btn-link" title="Open tender link"/>
                    <button name="action_create_lead" type="object" string="To Lead"
                            class="btn-primary" invisible="lead_id"/>
                    <button name="action_open_lead" type="object" string="Open Lead"
                            class="btn-secondary" invisible="not lead_id"/>
                </list>
            </field>
        </record>

        <!-- ##################### Form ######################### -->
        <record id="crm_etimad_form" model="ir.ui.view">
            <field name="name">crm.etimad.client.form</field>
            <field name="model">crm.etimad.client</field>
            <field name="arch" type="xml">
                <form string="Etimad Tender">
                    <header>
                        <button name="action_mark_studyable" type="object" string="Mark Studyable"
                                class="btn-success" invisible="study_state in ('studyable','converted')"/>
                        <button name="action_mark_rejected" type="object" string="Not Suitable"
                                invisible="study_state in ('rejected','converted')"/>
                        <button name="action_create_lead" type="object" string="Create Opportunity"
                                class="btn-primary" invisible="lead_id"/>
                        <button name="action_open_lead" type="object" string="Open Lead"
                                class="btn-secondary" invisible="not lead_id"/>
                        <button name="etimad_open_link" type="object" string="Open Tender"
                                class="btn-secondary" invisible="not link"/>
                        <button name="action_ai_match" type="object" string="AI Match"
                                class="btn-secondary" icon="fa-magic"/>
                        <field name="study_state" widget="statusbar"
                               statusbar_visible="to_review,studyable,converted"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_lead" type="object" class="oe_stat_button"
                                    icon="fa-star" invisible="not lead_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Opportunity</span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company"/>
                                <field name="method"/>
                                <field name="ref"/>
                                <field name="cost"/>
                            </group>
                            <group>
                                <field name="publish"/>
                                <field name="questions"/>
                                <field name="limit"/>
                                <field name="category"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="link" widget="url"/>
                                <field name="etimad_id"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <group string="Business Match (AI)" name="ai_match_group">
                            <field name="ai_match" widget="badge"
                                   decoration-success="ai_match == 'high'"
                                   decoration-info="ai_match == 'medium'"
                                   decoration-muted="ai_match == 'low'"/>
                            <field name="ai_match_score"/>
                            <field name="ai_match_reason"/>
                            <field name="ai_match_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ##################### Search ######################### -->
        <record id="crm_etimad_search" model="ir.ui.view">
            <field name="name">crm.etimad.client.search</field>
            <field name="model">crm.etimad.client</field>
            <field name="arch" type="xml">
                <search string="Search Etimad Tenders">
                    <field name="name" string="Tender"
                           filter_domain="['|', '|', ('name', 'ilike', self), ('company', 'ilike', self), ('ref', 'ilike', self)]"/>
                    <field name="company"/>
                    <field name="method"/>
                    <field name="tag_ids"/>
                    <separator/>
                    <filter name="open_tenders" string="Open"
                            domain="[('limit', '&gt;=', 'today')]"/>
                    <filter name="expired" string="Expired"
                            domain="[('limit', '&lt;', 'today')]"/>
                    <filter name="not_converted" string="Not Converted"
                            domain="[('lead_id', '=', False)]"/>
                    <filter name="converted" string="Converted"
                            domain="[('lead_id', '!=', False)]"/>
                    <separator/>
                    <filter name="to_study" string="To Study"
                            domain="[('study_state', 'in', ['to_review', 'studyable'])]"/>
                    <filter name="studyable" string="Studyable"
                            domain="[('study_state', '=', 'studyable')]"/>
                    <filter name="rejected" string="Not Suitable"
                            domain="[('study_state', '=', 'rejected')]"/>
                    <separator/>
                    <filter name="best_match" string="Best for Our Business"
                            domain="[('ai_match', '=', 'high')]"/>
                    <filter name="match_medium_up" string="Relevant (Medium+)"
                            domain="[('ai_match', 'in', ['high', 'medium'])]"/>
                    <filter name="not_analyzed" string="Not Analyzed"
                            domain="[('ai_match_date', '=', False)]"/>
                    <separator/>
                    <filter name="untagged" string="Untagged" domain="[('tag_ids', '=', False)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter name="publish_date" string="Publish Date" date="publish"/>
                    <filter name="limit_date" string="Deadline" date="limit"/>
                    <group>
                        <filter name="group_study" string="Study Status" context="{'group_by': 'study_state'}"/>
                        <filter name="group_match" string="Business Match" context="{'group_by': 'ai_match'}"/>
                        <filter name="group_company" string="Company" context="{'group_by': 'company'}"/>
                        <filter name="group_method" string="Method" context="{'group_by': 'method'}"/>
                        <filter name="group_tags" string="Tag" context="{'group_by': 'tag_ids'}"/>
                        <filter name="group_limit" string="Deadline" context="{'group_by': 'limit'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="crm_etimad_form_client_act_window" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Crm Etimad</field>
            <field name="res_model">crm.etimad.client</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="crm_etimad_search"/>
            <field name="context">{'search_default_open_tenders': 1}</field>
        </record>
        <menuitem id="crm_etimad_menu_id_client" parent="crm.crm_menu_root" name="Portal Etimad"
                  action="crm_etimad_form_client_act_window" sequence="3"/>

        <!-- ##################### Tags ######################### -->
        <record id="crm_etimad_tag_form_act_window_client" model="ir.actions.act_window">
            <field name="type">ir.actions.act_window</field>
            <field name="name">Crm Etimad Tag</field>
            <field name="res_model">crm.etimad.tag.client</field>
            <field name="view_mode">list</field>
        </record>
        <menuitem id="crm_etimad_tag_menu_id_client" parent="crm.crm_menu_config" name="Etimad Tags"
                  action="crm_etimad_tag_form_act_window_client" sequence="4"/>
    </data>
</odoo>
