    <record id="cron_cs_recompute_metrics" model="ir.cron">
        <field name="name">CS: Recompute account metrics &amp; health</field>
        <field name="model_id" ref="model_cs_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_metrics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1, minute=2, second=0))"/>
    </record>

