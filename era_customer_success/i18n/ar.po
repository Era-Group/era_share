#: model:ir.model.fields,field_description:era_customer_success.field_res_config_settings__cs_ai_adoption_enabled
#: model_terms:ir.ui.view,arch_db:era_customer_success.res_config_settings_view_form_cs
msgid "AI Adoption Plans"
msgstr "خطط التبنّي بـ ✦"

#. module: era_customer_success
