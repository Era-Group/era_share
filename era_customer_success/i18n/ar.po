#: model:ir.model.fields,field_description:era_customer_success.field_res_config_settings__cs_ai_churn_enabled
#: model_terms:ir.ui.view,arch_db:era_customer_success.res_config_settings_view_form_cs
msgid "AI Churn Forecast"
msgstr "تنبّؤ الفقدان بـ ✦"

#. module: era_customer_success
#: model:ir.model.fields,field_description:era_customer_success.field_cs_success_profile__ai_generated_on
#: model:ir.model.fields,field_description:era_customer_success.field_cs_value_review__ai_generated_on
msgid "AI Draft Generated On"
msgstr "تاريخ توليد مسودة ✦"

#. module: era_customer_success
#: model:ir.model.fields,field_description:era_customer_success.field_cs_service__ai_enriched_on
msgid "AI Enriched On"
msgstr "أُثري بـ ✦ في"

#. module: era_customer_success
#: model:ir.model,name:era_customer_success.model_cs_followup_compose
msgid "AI Follow-up / Reply Composer"
msgstr "مُحرِّر المتابعة/الردود بـ ✦"

#. module: era_customer_success
#: model:mail.message.subtype,name:era_customer_success.mt_cs_action
msgid "AI Next Action"
msgstr "إجراء ✦ التالي"

#. module: era_customer_success
#: model:ir.model.fields,field_description:era_customer_success.field_res_company__cs_ai_next_action_enabled
#: model:ir.model.fields,field_description:era_customer_success.field_res_config_settings__cs_ai_next_action_enabled
#: model_terms:ir.ui.view,arch_db:era_customer_success.res_config_settings_view_form_cs
msgid "AI Next Best Action"
msgstr "الإجراء التالي الأنسب بـ ✦"

#. module: era_customer_success
#: model:ir.model,name:era_customer_success.model_cs_call_briefing
msgid "AI Pre-Call / Meeting Briefing"
