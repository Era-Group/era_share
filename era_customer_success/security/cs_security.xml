    </record>
    <record id="cs_kpi_snapshot_rule_company" model="ir.rule">
        <field name="name">CS KPI Snapshot: allowed companies</field><field name="model_id" ref="model_csm_kpi_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="cs_weekly_suggestion_rule_own" model="ir.rule">
        <field name="name">CS Weekly Suggestion: own (CSM)</field>
        <field name="model_id" ref="model_cs_weekly_suggestion"/>
