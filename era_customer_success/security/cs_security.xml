<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_customer_success" model="ir.module.category">
        <field name="name">Customer Success</field>
        <field name="description">Manage customer success accounts, follow-up and KPIs.</field>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_customer_success" model="res.groups.privilege">
        <field name="name">Customer Success</field>
        <field name="category_id" ref="module_category_customer_success"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_era_cs_user" model="res.groups">
        <field name="name">Customer Success Engineer (CSM)</field>
        <field name="privilege_id" ref="privilege_customer_success"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_era_cs_manager" model="res.groups">
        <field name="name">Customer Success Manager</field>
        <field name="privilege_id" ref="privilege_customer_success"/>
        <field name="implied_ids" eval="[(4, ref('group_era_cs_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules: a CSM sees only their own accounts; managers see all -->
    <record id="cs_account_rule_own" model="ir.rule">
        <field name="name">CS Account: own accounts (CSM)</field>
        <field name="model_id" ref="model_cs_account"/>
        <field name="domain_force">[('csm_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_era_cs_user'))]"/>
    </record>

    <record id="cs_account_rule_manager" model="ir.rule">
        <field name="name">CS Account: all accounts (Manager)</field>
        <field name="model_id" ref="model_cs_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_era_cs_manager'))]"/>
    </record>
    <record id="cs_account_rule_company" model="ir.rule">
        <field name="name">CS Account: allowed companies</field><field name="model_id" ref="model_cs_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="cs_offering_rule_own" model="ir.rule">
        <field name="name">CS Offering: own (CSM)</field>
        <field name="model_id" ref="model_csm_offering"/>
        <field name="domain_force">['|', ('csm_user_id', '=', user.id), ('cs_account_id.csm_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_era_cs_user'))]"/>
    </record>

    <record id="cs_offering_rule_manager" model="ir.rule">
        <field name="name">CS Offering: all (Manager)</field>
        <field name="model_id" ref="model_csm_offering"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_era_cs_manager'))]"/>
    </record>
    <record id="cs_offering_rule_company" model="ir.rule">
        <field name="name">CS Offering: allowed companies</field><field name="model_id" ref="model_csm_offering"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cs_next_action_rule_own" model="ir.rule">
        <field name="name">CS Next Action: own accounts (CSM)</field><field name="model_id" ref="model_cs_next_action"/>
        <field name="domain_force">[('csm_user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_era_cs_user'))]"/>
    </record>
    <record id="cs_next_action_rule_manager" model="ir.rule">
        <field name="name">CS Next Action: all accounts (Manager)</field><field name="model_id" ref="model_cs_next_action"/>
        <field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('group_era_cs_manager'))]"/>
    </record>
    <record id="cs_next_action_rule_company" model="ir.rule">
        <field name="name">CS Next Action: allowed companies</field><field name="model_id" ref="model_cs_next_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="cs_kpi_snapshot_rule_own" model="ir.rule">
        <field name="name">CS KPI Snapshot: own accounts (CSM)</field><field name="model_id" ref="model_csm_kpi_snapshot"/>
        <field name="domain_force">[('csm_user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_era_cs_user'))]"/>
    </record>
