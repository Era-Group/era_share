<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="era_customer_success.CsDashboard">
        <div class="o_cs_dashboard p-3 o_action">
            <div t-if="state.loading" class="text-center p-5 text-muted">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <div class="mt-2">Loading Customer Success dashboard…</div>
            </div>
            <div t-else="">
                <div class="border rounded bg-light p-3 mb-3 o_cs_screen_guide">
                    <p><strong>What is this screen?</strong> A management overview showing where the customer portfolio needs attention.</p>
                    <p><strong>Use it to:</strong></p>
                    <ul>
                        <li>See customer volume, health, risk, revenue, and sentiment.</li>
                        <li>Compare workload and customer distribution across CSM engineers.</li>
                        <li>Open the customer records behind any number or ranking.</li>
                    </ul>
                    <p class="mb-0"><strong>Start here:</strong> Review critical customers and overloaded portfolios, then open the source accounts before acting. Use trends for coaching and prioritization, not as a final employee evaluation.</p>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <h2 class="mb-0 me-auto">Customer Success — Executive Dashboard</h2>
                    <button class="btn btn-secondary" t-on-click="() => this.loadData()"
                            title="Refresh every dashboard KPI and ranking from current Customer Success data. Use this after assignments, health updates, or completed work; it does not recalculate source records.">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                </div>

                <!-- KPI tiles -->
                <div class="row g-3 mb-4">
                    <t t-foreach="tiles" t-as="tile" t-key="tile.key">
                        <div class="col-6 col-md-3">
                             <div t-attf-class="card shadow-sm border-0 o_cs_tile border-start border-4 border-#{tile.color}"
                                  role="button" tabindex="0"
                                  t-att-aria-label="tile.label + ': ' + tile.value"
                                  t-on-click="() => this.onTile(tile)"
                                  t-on-keydown="(ev) => this.onTileKeydown(ev, tile)">
                                <div class="card-body d-flex align-items-center">
                                    <i t-attf-class="fa #{tile.icon} fa-2x me-3 text-#{tile.color}"/>
                                    <div>
                                        <div class="o_cs_tile_value fs-3 fw-bold" t-esc="tile.value"/>
                                        <div class="o_cs_tile_label text-muted small" t-esc="tile.label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="row g-3">
                    <!-- Engineer leaderboard -->
                    <div class="col-12 col-lg-7">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white fw-bold">Engineer Leaderboard</div>
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Engineer</th>
                                        <th class="text-end">Accounts</th>
                                        <th class="text-end">Avg Health</th>
                                        <th class="text-end">At Risk</th>
                                        <th class="text-end">MRR</th>
                                        <th class="text-end">Sentiment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                     <tr t-foreach="state.engineers" t-as="e" t-key="e.id"
                                         class="o_cs_row" role="button" tabindex="0"
                                         t-on-click="() => this.openEngineer(e)"
                                         t-on-keydown="(ev) => this.onEngineerKeydown(ev, e)">
                                        <td t-esc="e.name"/>
                                        <td class="text-end" t-esc="e.accounts"/>
                                        <td class="text-end">
                                            <span t-attf-class="badge text-bg-#{e.health >= 75 ? 'success' : (e.health >= 55 ? 'warning' : 'danger')}"
                                                  t-esc="e.health"/>
                                        </td>
                                        <td class="text-end" t-esc="e.atRisk"/>
                                        <td class="text-end" t-esc="e.mrr"/>
                                        <td class="text-end" t-esc="e.sentiment"/>
                                    </tr>
                                    <tr t-if="!state.engineers.length">
                                        <td colspan="6" class="text-center text-muted">No assigned accounts yet.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- At-risk accounts -->
                    <div class="col-12 col-lg-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white fw-bold text-danger">
                                <i class="fa fa-exclamation-triangle me-1"/> At-Risk Customers
                            </div>
                            <div class="list-group list-group-flush">
                                <a t-foreach="state.atRisk" t-as="a" t-key="a.id"
                                   class="list-group-item list-group-item-action d-flex align-items-center"
                                   href="#" t-on-click="(ev) => { ev.preventDefault(); this.openAccount(a.id); }">
                                    <span class="me-2" t-esc="moodEmoji(a.sentiment_label)"/>
                                    <span class="me-auto" t-esc="a.partner_id[1]"/>
                                    <span class="badge text-bg-danger me-2" t-esc="a.health_score"/>
                                    <small class="text-muted" t-esc="a.open_tickets_count + ' tickets'"/>
                                </a>
                                <div t-if="!state.atRisk.length" class="list-group-item text-center text-muted">
                                    No at-risk customers 🎉
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
