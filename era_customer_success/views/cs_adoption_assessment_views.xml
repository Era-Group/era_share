<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_adoption_assessment_list" model="ir.ui.view">
        <field name="name">cs.adoption.assessment.list</field>
        <field name="model">cs.adoption.assessment</field>
        <field name="arch" type="xml">
            <list string="Adoption Assessments" default_order="assessment_date desc"
                  decoration-danger="status == 'low' and state == 'confirmed'"
                  decoration-warning="status == 'watch' and state == 'confirmed'"
                  decoration-success="status == 'healthy' and state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="partner_id"/>
                <field name="csm_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="assessment_date"/>
                <field name="source" widget="badge"/>
                <field name="score" widget="progressbar"/>
                <field name="confidence" widget="progressbar"/>
                <field name="status" widget="badge"/>
                <field name="next_assessment_date" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cs_adoption_assessment_form" model="ir.ui.view">
        <field name="name">cs.adoption.assessment.form</field>
        <field name="model">cs.adoption.assessment</field>
        <field name="arch" type="xml">
            <form string="Customer Adoption Assessment">
                <header>
                    <button name="action_generate_ai_plan" type="object"
                            string="Draft Enablement Plan (AI)" icon="fa-magic"
                            invisible="state != 'draft' or not ai_adoption_enabled"
                            help="Draft a targeted enablement plan from aggregate adoption metrics and the blocker description. AI does not measure usage or change the confirmed score; verify all evidence before confirmation."/>
                    <button name="action_confirm" type="object" string="Confirm Evidence"
                            class="btn-primary" invisible="state != 'draft'"
                            help="Confirm that the entered adoption metrics and evidence are reliable. Confirmation freezes the assessment, updates the customer adoption indicators, and may create an actionable Voice of Customer insight when blockers exist."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"
                            help="Cancel an invalid or unnecessary draft assessment. Cancelled records remain available for audit and do not update customer adoption indicators."/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"
                            help="Return a cancelled assessment to Draft so its source, metrics, evidence, and enablement plan can be corrected before confirmation."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="border rounded bg-light p-3 mb-3 o_cs_screen_guide">
                        <p><strong>What is this screen?</strong> A practical assessment of how actively the customer works with us and moves forward.</p>
                        <p><strong>Use it to:</strong></p>
                        <ul>
                            <li>Assess the customer's support interaction, project progress, and WhatsApp or other communication.</li>
                            <li>Record whether agreed work is moving forward, blocked, or achieved.</li>
                            <li>Record evidence, blockers, and the action needed to improve engagement.</li>
                        </ul>
                        <p class="mb-0"><strong>Start here:</strong> Review recent support, projects, and customer conversations. Record only evidence you can verify, then confirm when the assessment reflects real customer activity.</p>
                    </div>
                    <field name="ai_adoption_enabled" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cs_account_id"/>
                            <field name="csm_user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="assessment_date"/>
                            <field name="next_assessment_date"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="source_reference" placeholder="Report, meeting, integration, or evidence reference..."/>
                            <field name="score" widget="progressbar"/>
                            <field name="confidence" widget="progressbar"/>
                            <field name="status" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Engagement" name="metrics">
                            <group>
                                <group string="Support and Projects">
                                    <field name="support_engagement"/>
                                    <field name="project_engagement"/>
                                </group>
                                <group string="Communication and Progress">
                                    <field name="communication_engagement"/>
                                    <field name="operational_progress"/>
                                </group>
                            </group>
                        </page>
                        <page string="Evidence and Enablement" name="evidence">
                            <group>
                                <field name="evidence" placeholder="Measured evidence supporting this assessment..."/>
                                <field name="blockers" placeholder="What prevents wider or deeper adoption?"/>
                                <field name="enablement_plan" placeholder="Targeted enablement actions for customer success..."/>
                            </group>
                        </page>
                        <page string="Audit" name="audit">
                            <group>
                                <field name="confirmed_on"/>
                                <field name="confirmed_by_id" widget="many2one_avatar_user"/>
                                <field name="ai_generated_on"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cs_adoption_assessment_search" model="ir.ui.view">
        <field name="name">cs.adoption.assessment.search</field>
        <field name="model">cs.adoption.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="csm_user_id"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="[('state', '=', 'confirmed'), ('status', 'in', ('watch','low'))]"/>
                <filter name="my_assessments" string="My Assessments" domain="[('csm_user_id', '=', uid)]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_csm" string="CSM Engineer" context="{'group_by': 'csm_user_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cs_adoption_assessment" model="ir.actions.act_window">
        <field name="name">Adoption Assessments</field>
        <field name="res_model">cs.adoption.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cs_adoption_assessment_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_my_assessments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record measured customer adoption</p>
            <p>Use evidence available to Customer Success: support interaction, project progress, WhatsApp or other communication, and agreed work outcomes. Confirm only reliable observations; incomplete evidence should trigger validation rather than a service recommendation.</p>
        </field>
    </record>
</odoo>
