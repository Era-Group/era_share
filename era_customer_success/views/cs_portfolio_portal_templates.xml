<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_shared_portfolio" name="Shared Customer Portfolio">
        <t t-call="portal.portal_layout">
            <div class="container-fluid py-4" style="max-width:1600px">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div><h1 class="mb-1">Shared Customer Portfolio</h1><h2 class="h4 text-primary" dir="rtl">محفظة العملاء المشتركة</h2><p class="text-muted mb-0">ERA Group × Odoo · Updated snapshot / لقطة بيانات محدثة</p></div>
                    <a t-if="share.allow_export" class="btn btn-primary" t-att-href="'/era/portfolio/%s/xlsx?access_token=%s' % (share.id, access_token)"><i class="fa fa-file-excel-o me-2"/>Export Excel / تصدير إكسل</a>
                </div>
                <div class="alert alert-light border"><strong>Privacy notice / إشعار الخصوصية:</strong> This page contains only the columns requested in Odoo's shared customer sheet. / تحتوي هذه الصفحة فقط على الأعمدة المطلوبة في ملف العملاء المشترك من Odoo.</div>
                <div class="table-responsive shadow-sm rounded border bg-white">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-dark"><tr>
                            <th>ERA CSM<br/><small>مسؤول النجاح</small></th><th>Phone<br/><small>الهاتف</small></th><th>Email<br/><small>البريد</small></th><th>Customer<br/><small>العميل</small></th><th>Join date<br/><small>الانضمام</small></th><th>Next invoice<br/><small>الفاتورة القادمة</small></th><th>Plan<br/><small>الخطة</small></th><th>Industry<br/><small>القطاع</small></th><th>Employees<br/><small>الموظفون</small></th><th>Users<br/><small>المستخدمون</small></th><th>Active users<br/><small>النشطون</small></th><th>Stage<br/><small>المرحلة</small></th><th>Version<br/><small>الإصدار</small></th><th>Adoption<br/><small>التفاعل</small></th><th>Website<br/><small>الموقع</small></th><th>Implemented modules<br/><small>الموديولات</small></th><th>Expansion<br/><small>التوسع</small></th><th>Next action<br/><small>الإجراء التالي</small></th><th>Notes<br/><small>ملاحظات</small></th><th>Status<br/><small>الحالة</small></th>
                        </tr></thead>
                        <tbody><tr t-foreach="lines" t-as="line">
                            <td t-esc="line.era_csm"/><td t-esc="line.era_csm_phone"/><td t-esc="line.era_csm_email"/><td><strong t-esc="line.customer_name"/></td><td t-esc="line.date_of_join or ''"/><td t-esc="line.next_invoice_date or ''"/><td t-esc="line.recurring_plan"/><td t-esc="line.industry"/><td t-esc="line.number_of_employees or ''"/><td t-esc="line.number_of_users or ''"/><td t-esc="line.active_users or ''"/><td t-esc="line.stage"/><td t-esc="line.version"/><td><span class="badge text-bg-info"><t t-esc="str(round(line.adoption, 2)) + '%'"/></span></td><td><a t-if="line.client_website" t-att-href="line.client_website" target="_blank">Open / فتح</a></td><td class="text-wrap" style="min-width:220px" t-esc="line.active_implemented_modules"/><td class="text-wrap" style="min-width:220px" t-esc="line.potential_expansion"/><td class="text-wrap" style="min-width:220px" t-esc="line.next_action"/><td class="text-wrap" style="min-width:220px" t-esc="line.extra_notes"/><td t-esc="line.expansion_status or ''"/>
                        </tr></tbody>
                    </table>
                </div>
                <p class="small text-muted mt-3">Expires / ينتهي: <t t-esc="share.expires_on"/></p>
            </div>
        </t>
    </template>
</odoo>
