<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_stage_list" model="ir.ui.view">
        <field name="name">cs.stage.list</field>
        <field name="model">cs.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="day_window_start"/>
                <field name="day_window_end"/>
                <field name="is_onboarding"/>
                <field name="is_at_risk"/>
                <field name="is_churned"/>
                <field name="fold"/>
                <field name="account_count"/>
            </list>
        </field>
    </record>

    <record id="view_cs_stage_form" model="ir.ui.view">
        <field name="name">cs.stage.form</field>
        <field name="model">cs.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="border rounded bg-light p-3 mb-3 o_cs_screen_guide">
                        <p><strong>What is this screen?</strong> A stage in the customer lifecycle, such as onboarding, stable, at risk, or churned.</p>
                        <p><strong>Use it to:</strong></p>
                        <ul>
                            <li>Set the stage name, order, color, and meaning.</li>
                            <li>Define the day range for automatic onboarding movement.</li>
                            <li>Mark stages that represent risk or churn and choose the related email template.</li>
                        </ul>
                        <p class="mb-0"><strong>Start here:</strong> Keep the lifecycle short and clear. Make onboarding day ranges non-overlapping. Mark risk and churn only when they should affect reports and automation.</p>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="is_onboarding"/>
                            <field name="day_window_start" invisible="not is_onboarding"/>
                            <field name="day_window_end" invisible="not is_onboarding"/>
                            <field name="is_at_risk"/>
                            <field name="is_churned"/>
                            <field name="mail_template_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this stage means..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cs_stage" model="ir.actions.act_window">
        <field name="name">Lifecycle Stages</field>
        <field name="res_model">cs.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the customer lifecycle</p>
            <p>Create ordered stages, describe what each stage means, and mark onboarding, at-risk, or churn stages carefully. Onboarding day windows drive automatic lifecycle progression.</p>
        </field>
    </record>
</odoo>
