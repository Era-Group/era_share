<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_csm_offering_list" model="ir.ui.view">
        <field name="name">csm.offering.list</field>
        <field name="model">csm.offering</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="csm_user_id" widget="many2one_avatar_user"/>
                <field name="offering_date"/>
                <field name="channel"/>
                <field name="expected_value" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'presented'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_csm_offering_form" model="ir.ui.view">
        <field name="name">csm.offering.form</field>
        <field name="model">csm.offering</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suggest_pitch" type="object" string="Suggest Pitch (AI)"
                            icon="fa-magic" class="btn-secondary"
                            help="Draft a customer-specific value message using the selected service and customer context. Review accuracy, tone, and claims before sending; this does not present or qualify the offering."/>
                    <button name="action_send_service_whatsapp" type="object"
                            string="إرسال قالب الخدمة (واتساب)" icon="fa-whatsapp"
                            class="btn-secondary" invisible="not service_id"
                            help="Open the approved WhatsApp service template for this customer. Verify the recipient, service details, and customer consent before sending."/>
                    <button name="action_send_service_email" type="object"
                            string="إرسال إيميل" icon="fa-envelope"
                            class="btn-secondary" invisible="not service_id"
                            help="Open an email containing the selected service and proposed message. Review recipients, content, and attachments before sending."/>
                    <button name="action_present" type="object" string="Mark Presented"
                            class="btn-primary" invisible="state != 'draft'"
                            help="Confirm that the service was actually presented to the customer. First document the customer need, contact, suitability check, channel, and presentation details."/>
                    <button name="action_accept" type="object" string="Qualify → Create Opportunity"
                            class="btn-primary" invisible="state != 'presented'"
                            help="Qualify the need and create one CRM opportunity only after the customer confirms interest and timing. This is the commercial handoff point; recommendations alone must not create opportunities."/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft','presented')"
                            help="Reject this offering when it is unsuitable or the customer declines. The rejection date is retained and recommendation cooldown rules reduce repeated suggestions."/>
                    <button name="action_open_opportunity" type="object" string="View Opportunity"
                            invisible="not opportunity_id"
                            help="Open the CRM opportunity created from this qualified offering to continue the commercial process with the responsible sales team."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,presented,accepted"/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="status">
                        <strong>Best use:</strong> Validate a discovered customer need before handing it to the commercial team.<br/>
                        <strong>Features:</strong> Service context, need evidence, suitability check, customer contact, pitch, presentation, interest, timing, and CRM handoff.<br/>
                        <strong>Priority:</strong> Document the need before presenting. Create an opportunity only after the customer explicitly confirms interest and timing; reject unsuitable recommendations instead of forcing qualification.
                    </div>
                    <field name="is_service_recommendation" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="not is_service_recommendation">
                        توصية للاستكشاف فقط. تحقّق من احتياج العميل قبل تقديم الخدمة أو إنشاء فرصة.
                    </div>
                    <field name="service_image" widget="image" class="oe_avatar"
                           invisible="not service_id" readonly="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Offering name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cs_account_id"/>
                            <field name="csm_user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="service_id"/>
                            <field name="need_type"/>
                            <field name="support_sale_line_id" invisible="need_type != 'support_hours'"/>
                            <field name="recommendation_score" invisible="not is_service_recommendation"/>
                            <field name="offering_date"/>
                            <field name="channel"/>
                            <field name="expected_value" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="opportunity_id" readonly="1"/>
                            <field name="rejected_on" invisible="not rejected_on"/>
                        </group>
                    </group>
                    <field name="product_tmpl_ids" widget="many2many_tags"/>
                    <group string="Need Qualification">
                        <field name="customer_need"/>
                        <field name="customer_contact_id" domain="[('cs_account_id', '=', cs_account_id)]"/>
                        <field name="suitability_checked"/>
                        <field name="customer_interest_confirmed"/>
                        <field name="need_timing"/>
                    </group>
                    <notebook>
                        <page string="Recommendation Evidence" invisible="not is_service_recommendation">
                            <field name="recommendation_reason" readonly="1"/>
                        </page>
                        <page string="Suggested Pitch (AI)" name="pitch">
                            <field name="pitch_message" placeholder="Click 'Suggest Pitch (AI)' to generate a message tailored to this customer's situation…"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes about the offering..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_csm_offering" model="ir.actions.act_window">
        <field name="name">Offerings</field>
        <field name="res_model">csm.offering</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Validate a customer need before selling</p>
            <p>Create an offering as a Draft, document the need and customer contact, present the service, then qualify it only after interest and timing are confirmed. A CRM opportunity is created at qualification, never from a recommendation alone.</p>
        </field>
    </record>
</odoo>
