<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_google_sheet_sync_log_list" model="ir.ui.view">
        <field name="name">cs.google.sheet.sync.log.list</field>
        <field name="model">cs.google.sheet.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="create_date desc">
                <field name="create_date"/>
                <field name="job_type"/>
                <field name="state" widget="badge"/>
                <field name="matched_accounts"/>
                <field name="updated_cells"/>
                <field name="spreadsheet_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_cs_google_sheet_sync_log_form" model="ir.ui.view">
        <field name="name">cs.google.sheet.sync.log.form</field>
        <field name="model">cs.google.sheet.sync.log</field>
        <field name="arch" type="xml">
            <form string="Google Sheet Job Result" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="job_type"/><field name="state"/><field name="spreadsheet_id"/></group>
                        <group><field name="matched_accounts"/><field name="updated_cells"/><field name="create_date"/></group>
                    </group>
                    <field name="details" nolabel="1" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
