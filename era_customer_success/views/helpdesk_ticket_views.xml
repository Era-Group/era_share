<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_cs" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.cs.sentiment</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="border rounded bg-light p-3 mx-3 mt-3 mb-0">
                    <p><strong>What is this screen?</strong> The working record for solving one customer support problem.</p>
                    <p><strong>Use it to:</strong></p>
                    <ul>
                        <li>Assign the issue, communicate with the customer, and monitor the SLA.</li>
                        <li>Record useful tags, work performed, and the final resolution.</li>
                        <li>Provide support-impact and sentiment signals to Customer Success.</li>
                    </ul>
                    <p class="mb-0"><strong>Start here:</strong> Restore service and give the customer a clear update first. Keep tags and resolution factual. Read the conversation before using the sentiment signal for follow-up.</p>
                </div>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="cs_sentiment_analyzed" invisible="1"/>
                <field name="cs_sentiment_label" widget="badge"
                       invisible="not cs_sentiment_analyzed"
                       decoration-success="cs_sentiment_label == 'positive'"
                       decoration-warning="cs_sentiment_label == 'neutral'"
                       decoration-danger="cs_sentiment_label == 'negative'"/>
            </xpath>
        </field>
    </record>
</odoo>
