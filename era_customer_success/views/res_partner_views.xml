<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_cs" model="ir.ui.view">
        <field name="name">res.partner.form.cs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_cs_account" icon="fa-heartbeat"
                        invisible="not is_company"
                        help="Open this company's Customer Success 360° record. If no account exists, use Enroll in Customer Success from the Actions menu first.">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Customer</span>
                        <span class="o_stat_text">Success</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_server_enroll_cs" model="ir.actions.server">
        <field name="name">Enroll in Customer Success</field>
        <field name="help">Create or open the Customer Success account for each selected company. Existing accounts are reused, and the company must be assigned to a CSM before operational follow-up.</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_era_cs_user'))]"/>
        <field name="state">code</field>
        <field name="code">
for partner in records:
    if partner.is_company or partner == partner.commercial_partner_id:
        partner.action_create_cs_account()
        </field>
    </record>
</odoo>
