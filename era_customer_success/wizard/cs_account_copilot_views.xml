<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_account_copilot_form" model="ir.ui.view">
        <field name="name">cs.account.copilot.form</field>
        <field name="model">cs.account.copilot</field>
        <field name="arch" type="xml">
            <form string="Account Copilot">
                <div class="alert alert-info" role="status">
                    🤖 <field name="partner_id" readonly="1" class="oe_inline" nolabel="1"/> — اسأل أي سؤال عن هذا العميل (الوضع، الصحة، المخاطر، التجديد، آخر التفاعلات…)
                </div>
                <field name="question" placeholder="مثال: ليش صحة هذا العميل منخفضة؟ متى آخر تواصل؟ هل فيه فرص بيع؟"
                       nolabel="1"/>
                <group>
                    <button name="action_ask" type="object" string="✨ اسأل الذكاء" class="btn-primary"/>
                </group>
                <field name="answer" nolabel="1" readonly="1" invisible="not answer"/>
                <field name="cs_account_id" invisible="1"/>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
