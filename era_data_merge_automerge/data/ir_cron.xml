<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Compatible cron binding: call the model method via state='code'. -->
        <record id="ir_cron_data_merge_automerge_safe" model="ir.cron">
            <field name="name">Data Merge: Auto Merge Duplicates (Safe)</field>
            <field name="active" eval="True"/>
            <field name="state">code</field>
            <field name="model_id" ref="model_data_merge_automerge_runner"/>
            <field name="code">model.cron_run()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
