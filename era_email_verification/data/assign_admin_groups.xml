<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grant the admin (and OdooBot) the Manager role so the Settings section
         and the Email Verification menu are visible right after install. Kept
         updatable (no noupdate) so a plain `-u` fixes an existing install too;
         the link command is additive/idempotent. -->
    <record id="group_email_verification_manager" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
