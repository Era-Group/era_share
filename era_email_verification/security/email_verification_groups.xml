<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_email_verification" model="ir.module.category">
        <field name="name">Email Verification</field>
        <field name="description">Verify contact and mailing-list email addresses.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: the category lives on res.groups.privilege; groups point to
         it via privilege_id (res.groups no longer has category_id). -->
    <record id="res_groups_privilege_email_verification" model="res.groups.privilege">
        <field name="name">Email Verification</field>
        <field name="category_id" ref="module_category_email_verification"/>
    </record>

    <record id="group_email_verification_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_email_verification"/>
        <field name="comment">Request verification and view email statuses.</field>
    </record>

    <record id="group_email_verification_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_email_verification"/>
        <field name="implied_ids" eval="[(4, ref('group_email_verification_user'))]"/>
        <field name="comment">Configure the service, run bulk jobs, retry/cancel,
            and view technical SMTP details.</field>
    </record>

</odoo>
