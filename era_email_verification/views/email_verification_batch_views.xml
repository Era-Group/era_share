<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ev_batch_list" model="ir.ui.view">
        <field name="name">email.verification.batch.list</field>
        <field name="model">email.verification.batch</field>
        <field name="arch" type="xml">
            <list string="Verification Batches"
                  decoration-success="state == 'done'"
                  decoration-info="state in ('queued','running')"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('queued','running')"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="source"/>
                <field name="total_count"/>
                <field name="imported_count"/>
                <field name="progress" widget="progressbar"/>
                <field name="deliverable_count"/>
                <field name="risky_count"/>
                <field name="undeliverable_count"/>
                <field name="unknown_count" optional="hide"/>
                <field name="blacklist_added_count"/>
                <field name="date_done"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ev_batch_form" model="ir.ui.view">
        <field name="name">email.verification.batch.form</field>
        <field name="model">email.verification.batch</field>
        <field name="arch" type="xml">
            <form string="Verification Batch">
                <header>
                    <button name="action_queue" string="Queue" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','queued','running','failed')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object" invisible="state not in ('failed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,queued,running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" type="object"
                                class="oe_stat_button" icon="fa-list-ul">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="check_smtp"/>
                            <field name="check_catch_all"/>
                            <field name="job_id"
                                   groups="era_email_verification.group_email_verification_manager"/>
                        </group>
                        <group>
                            <field name="total_count"/>
                            <field name="imported_count"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Results">
                        <group>
                            <field name="deliverable_count"/>
                            <field name="risky_count"/>
                            <field name="undeliverable_count"/>
                            <field name="unknown_count"/>
                        </group>
                        <group>
                            <field name="stale_count"/>
                            <field name="blacklist_added_count"/>
                            <field name="date_submitted"/>
                            <field name="date_done"/>
                            <field name="last_progress_at" invisible="state != 'running'"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ev_batch_search" model="ir.ui.view">
        <field name="name">email.verification.batch.search</field>
        <field name="model">email.verification.batch</field>
        <field name="arch" type="xml">
            <search string="Verification Batches">
                <field name="name"/>
                <field name="job_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="queued" string="Queued" domain="[('state','=','queued')]"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <separator/>
                <filter name="my_batches" string="My Batches"
                        domain="[('user_id','=',uid)]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_source" string="Source" context="{'group_by':'source'}"/>
                    <filter name="group_user" string="Created by" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ev_batch" model="ir.actions.act_window">
        <field name="name">Verification Batches</field>
        <field name="res_model">email.verification.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ev_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No verification batches yet</p>
            <p>Batches are created from the Contacts list, mailing lists, or the
               "Verify Unchecked Emails" tool, then processed in the background.</p>
        </field>
    </record>

</odoo>
