<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- No top-level app menu: verification is an add-on to the models it
         serves, so everything hangs off Email Marketing (mass_mailing), the
         app that owns mailing contacts and lists. Contacts get their entry
         points from the buttons injected into the partner form/list. -->

    <menuitem id="menu_ev_operations" name="Email Verification"
              parent="mass_mailing.mass_mailing_menu_root" sequence="4"
              groups="era_email_verification.group_email_verification_user"/>

    <menuitem id="menu_ev_verify_unchecked" name="Verify Unchecked Emails"
              parent="menu_ev_operations" action="action_ev_wizard" sequence="10"/>
    <menuitem id="menu_ev_batches" name="Batches"
              parent="menu_ev_operations" action="action_ev_batch" sequence="20"/>
    <menuitem id="menu_ev_results" name="Results"
              parent="menu_ev_operations" action="action_ev_item" sequence="30"/>

    <!-- Email Marketing / Reporting -->
    <menuitem id="menu_ev_analysis" name="Email Verification Analysis"
              parent="mass_mailing.menu_mass_mailing_report" action="action_ev_item"
              sequence="20"
              groups="era_email_verification.group_email_verification_manager"/>

    <!-- Email Marketing / Configuration -->
    <menuitem id="menu_ev_settings" name="Email Verification Settings"
              parent="mass_mailing.mass_mailing_configuration"
              action="action_ev_config_settings" sequence="25"
              groups="era_email_verification.group_email_verification_manager"/>

</odoo>
