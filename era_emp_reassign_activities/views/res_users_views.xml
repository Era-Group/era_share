<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_reassign" model="ir.ui.view">
        <field name="name">res.users.form.inherit.reassign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_reassign_wizard"
                        type="object"
                        string="Reassign Work"
                        class="btn-secondary"
                        groups="base.group_system"
                        invisible="not id"
                        help="Transfer pending activities, leads, meetings, tickets, tasks and orders to another user."/>
            </xpath>
        </field>
    </record>

</odoo>
