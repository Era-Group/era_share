<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_era_geo_ai_crawler_list" model="ir.ui.view">
    <field name="name">era.geo.ai.crawler.list</field>
    <field name="model">era.geo.ai.crawler</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="vendor"/>
        <field name="name"/>
        <field name="user_agent"/>
        <field name="purpose"/>
        <field name="allowed" widget="boolean_toggle"/>
        <field name="documentation_url" widget="url" optional="hide"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_era_geo_ai_crawler_form" model="ir.ui.view">
    <field name="name">era.geo.ai.crawler.form</field>
    <field name="model">era.geo.ai.crawler</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="user_agent"/>
              <field name="vendor"/>
              <field name="purpose"/>
            </group>
            <group>
              <field name="allowed" widget="boolean_toggle"/>
              <field name="documentation_url" widget="url"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_era_geo_ai_crawler_search" model="ir.ui.view">
    <field name="name">era.geo.ai.crawler.search</field>
    <field name="model">era.geo.ai.crawler</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="user_agent"/>
        <field name="vendor"/>
        <filter name="allowed" string="Allowed" domain="[('allowed','=',True)]"/>
        <filter name="blocked" string="Blocked" domain="[('allowed','=',False)]"/>
        <group>
          <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor'}"/>
          <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_era_geo_ai_crawler" model="ir.actions.act_window">
    <field name="name">AI Crawlers</field>
    <field name="res_model">era.geo.ai.crawler</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No AI crawlers yet</p>
      <p>Allow or block AI/LLM crawlers (GPTBot, PerplexityBot, ClaudeBot …);
         the choices are emitted into robots.txt.</p>
    </field>
  </record>

  <menuitem id="menu_era_geo_root"
            name="GEO (AI Engines)"
            parent="era_seo_manager.menu_website_seo_root"
            sequence="45"/>
  <menuitem id="menu_era_geo_ai_crawlers"
            name="AI Crawlers"
            parent="menu_era_geo_root"
            action="action_era_geo_ai_crawler"
            sequence="10"/>
</odoo>
