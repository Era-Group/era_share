<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_era_gsc_site_list" model="ir.ui.view">
    <field name="name">era.gsc.site.list</field>
    <field name="model">era.gsc.site</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="account_id"/>
        <field name="permission_level" optional="show"/>
        <field name="query_count" optional="show"/>
        <field name="last_pull_date" optional="show"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_era_gsc_site_form" model="ir.ui.view">
    <field name="name">era.gsc.site.form</field>
    <field name="model">era.gsc.site</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_pull_now" type="object"
                  string="Pull Now" class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="account_id"/>
              <field name="permission_level"/>
            </group>
            <group>
              <field name="last_pull_date"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Queries" name="queries">
              <field name="query_ids" readonly="1">
                <list>
                  <field name="date"/>
                  <field name="query"/>
                  <field name="clicks"/>
                  <field name="impressions"/>
                  <field name="ctr" widget="percentage"/>
                  <field name="position"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_era_gsc_site" model="ir.actions.act_window">
    <field name="name">GSC Sites</field>
    <field name="res_model">era.gsc.site</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
