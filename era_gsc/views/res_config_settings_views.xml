<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_res_config_settings_era_gsc" model="ir.ui.view">
    <field name="name">res.config.settings.era.gsc</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='website_info_settings']" position="after">
        <block title="Google Search Console" id="era_gsc_settings"
               help="Pull search performance from Google Search Console.">

          <setting id="era_gsc_oauth" string="OAuth Client"
                   help="OAuth 2.0 Client (Web application) from Google Cloud Console — Credentials.">
            <div class="content-group">
              <div class="row mb-2">
                <label for="era_gsc_redirect_uri" class="col-lg-4 o_light_label"/>
                <field name="era_gsc_redirect_uri" readonly="1" nolabel="1"
                       widget="CopyClipboardChar"/>
              </div>
              <div class="row">
                <label for="era_gsc_client_id" class="col-lg-4 o_light_label"/>
                <field name="era_gsc_client_id"
                       placeholder="xxxxxxxx.apps.googleusercontent.com"/>
              </div>
              <div class="row">
                <label for="era_gsc_client_secret" class="col-lg-4 o_light_label"/>
                <field name="era_gsc_client_secret" password="True"
                       placeholder="••••••••••••••••"/>
              </div>
              <details class="mt-3">
                <summary class="text-primary" style="cursor: pointer;">
                  Show setup guide
                </summary>
                <ol class="ps-3 mt-2 small text-muted">
                  <li>Open Google Cloud Console and create (or pick) a project.</li>
                  <li>Under APIs &amp; Services → Library, enable the Search Console API.</li>
                  <li>Configure the OAuth consent screen (Internal or External).</li>
                  <li>Under Credentials, create an OAuth client ID — Web application.</li>
                  <li>Add the Redirect URI shown above to "Authorized redirect URIs" — exact match, including https and no trailing slash.</li>
                  <li>Paste the Client ID and Client Secret in the fields above and save.</li>
                  <li>Go to Website → SEO → GSC → Accounts → New, then click "Connect with Google".</li>
                </ol>
              </details>
            </div>
          </setting>

          <setting id="era_gsc_pull_window" string="Pull Window (days)"
                   help="How many days of search analytics each pull fetches. GSC data is ~2 days delayed.">
            <field name="era_gsc_pull_window_days"/>
          </setting>

        </block>
      </xpath>
    </field>
  </record>
</odoo>
