msgstr "السند النظامي لهذه الدائرة."

#. module: era_law_firm
#: model:ir.model.fields,help:era_law_firm.field_legal_jurisdiction__note
msgid "Statutory basis or a note on what this jurisdiction covers."
msgstr "السند النظامي أو ملاحظة على ما يشمله هذا الاختصاص."

#. module: era_law_firm
#: model:ir.model.fields,field_description:era_law_firm.field_legal_hearing__stop_datetime
