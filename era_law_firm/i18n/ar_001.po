msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"الحالة بحسب الأنشطة\n"
"متأخر: تجاوز تاريخ الاستحقاق\n"
"اليوم: تاريخ النشاط هو اليوم\n"
"مخطط: أنشطة مستقبلية."

#. module: era_law_firm
#: model_terms:ir.ui.view,arch_db:era_law_firm.view_legal_deadline_rule_form
msgid "Statutory article this period comes from"
msgstr "المادة النظامية التي تستند إليها هذه المدة"

#. module: era_law_firm
#: model_terms:ir.ui.view,arch_db:era_law_firm.view_legal_jurisdiction_form
