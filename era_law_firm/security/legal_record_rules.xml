<odoo>
 <record id="rule_party_company" model="ir.rule"><field name="name">Case parties: company</field><field name="model_id" ref="model_legal_case_party"/><field name="groups" eval="[(4,ref('group_legal_staff'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_hearing_company" model="ir.rule"><field name="name">Hearings: company</field><field name="model_id" ref="model_legal_hearing"/><field name="groups" eval="[(4,ref('group_legal_staff'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_deadline_company" model="ir.rule"><field name="name">Deadlines: company</field><field name="model_id" ref="model_legal_deadline"/><field name="groups" eval="[(4,ref('group_legal_staff'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_document_company" model="ir.rule"><field name="name">Documents: company and restriction</field><field name="model_id" ref="model_legal_document"/><field name="groups" eval="[(4,ref('group_legal_staff'))]"/><field name="domain_force">[('company_id','in',company_ids), '|', ('restricted','=',False), '|', ('owner_id','=',user.id), '|', ('reviewer_id','=',user.id), ('allowed_user_ids','in',user.id)]</field></record>
 <record id="rule_engagement_company" model="ir.rule"><field name="name">Engagements: company</field><field name="model_id" ref="model_legal_engagement"/><field name="groups" eval="[(4,ref('group_legal_accountant'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_time_company" model="ir.rule"><field name="name">Time entries: company</field><field name="model_id" ref="model_legal_time_entry"/><field name="groups" eval="[(4,ref('group_legal_lawyer'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_expense_company" model="ir.rule"><field name="name">Expenses: company</field><field name="model_id" ref="model_legal_expense"/><field name="groups" eval="[(4,ref('group_legal_accountant'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="rule_consultation_company" model="ir.rule"><field name="name">Consultations: company</field><field name="model_id" ref="model_legal_consultation"/><field name="groups" eval="[(4,ref('group_legal_lawyer'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
