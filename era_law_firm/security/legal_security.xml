<odoo>
  <record id="module_category_legal" model="ir.module.category"><field name="name">Legal</field><field name="sequence">30</field></record>
  <record id="privilege_legal_role" model="res.groups.privilege"><field name="name">Law Firm</field><field name="category_id" ref="module_category_legal"/><field name="sequence">10</field><field name="description">Level of responsibility over legal files. Each level includes the one below it.</field></record>
  <record id="privilege_legal_billing" model="res.groups.privilege"><field name="name">Legal Billing</field><field name="category_id" ref="module_category_legal"/><field name="sequence">20</field><field name="description">Access to engagements, invoicing and client trust money.</field></record>
  <record id="group_legal_staff" model="res.groups"><field name="name">Legal Staff</field><field name="privilege_id" ref="privilege_legal_role"/><field name="sequence">10</field></record>
  <record id="group_legal_lawyer" model="res.groups"><field name="name">Lawyer</field><field name="privilege_id" ref="privilege_legal_role"/><field name="sequence">20</field><field name="implied_ids" eval="[(4, ref('group_legal_staff'))]"/></record>
  <record id="group_legal_accountant" model="res.groups"><field name="name">Legal Accountant</field><field name="privilege_id" ref="privilege_legal_billing"/><field name="sequence">10</field><field name="implied_ids" eval="[(4, ref('group_legal_staff'))]"/></record>
  <!-- Three levels of responsibility, each inheriting the one below:
       Lawyer works their own files; Supervisor oversees the team's files;
       Manager owns the firm and everything that carries liability. -->
  <record id="group_legal_supervisor" model="res.groups"><field name="name">Legal Supervisor</field><field name="privilege_id" ref="privilege_legal_role"/><field name="sequence">30</field><field name="implied_ids" eval="[(6, 0, [ref('group_legal_lawyer')])]"/></record>
  <record id="group_legal_manager" model="res.groups"><field name="name">Legal Manager</field><field name="privilege_id" ref="privilege_legal_role"/><field name="sequence">40</field><field name="implied_ids" eval="[(6, 0, [ref('group_legal_supervisor'), ref('group_legal_accountant')])]"/></record>
  <record id="rule_case_supervisor" model="ir.rule"><field name="name">Legal cases: supervisor sees the team</field><field name="model_id" ref="model_legal_case"/><field name="groups" eval="[(4,ref('group_legal_supervisor'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_document_supervisor" model="ir.rule"><field name="name">Documents: supervisor sees the team</field><field name="model_id" ref="model_legal_document"/><field name="groups" eval="[(4,ref('group_legal_supervisor'))]"/><field name="domain_force">[('company_id','in',company_ids), '|', ('restricted','=',False), '|', ('owner_id','=',user.id), '|', ('reviewer_id','=',user.id), ('allowed_user_ids','in',user.id)]</field></record>
  <record id="rule_case_company_team" model="ir.rule"><field name="name">Legal cases: company and team</field><field name="model_id" ref="model_legal_case"/><field name="groups" eval="[(4,ref('group_legal_staff'))]"/><field name="domain_force">[('company_id','in',company_ids), '|', ('lawyer_id','=',user.id), ('team_user_ids','in',user.id)]</field></record>
  <record id="rule_case_manager" model="ir.rule"><field name="name">Legal cases: manager company</field><field name="model_id" ref="model_legal_case"/><field name="groups" eval="[(4,ref('group_legal_manager'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_trust_company" model="ir.rule"><field name="name">Trust company isolation</field><field name="model_id" ref="model_legal_trust_account"/><field name="groups" eval="[(4,ref('group_legal_accountant'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_trust_tx_company" model="ir.rule"><field name="name">Trust transactions company isolation</field><field name="model_id" ref="model_legal_trust_transaction"/><field name="groups" eval="[(4,ref('group_legal_accountant'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
