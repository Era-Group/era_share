<odoo>
    <record id="view_legal_dashboard_form" model="ir.ui.view">
        <field name="name">legal.dashboard.form</field>
        <field name="model">legal.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="false" edit="false" delete="false" class="o_legal_dashboard">
                <sheet>
                    <field name="show_lawyer" invisible="1"/>
                    <field name="show_supervisor" invisible="1"/>
                    <field name="show_manager" invisible="1"/>
                    <field name="show_accountant" invisible="1"/>
                    <field name="show_ai" invisible="1"/>

                    <div class="o_legal_dash_head d-flex justify-content-between align-items-end flex-wrap gap-2">
                        <div>
                            <h1><field name="headline" nolabel="1"/></h1>
                            <div class="o_legal_dash_sub">What needs your attention, before you go looking.</div>
                        </div>
                        <button name="action_open_intake" type="object"
                                string="Open a Case" class="btn btn-primary"/>
                    </div>

                    <div class="o_legal_dash_section" invisible="not show_lawyer">
                        <div class="o_legal_dash_section_title">My Work</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_open_cases" type="object" class="o_legal_tile">
                                    <div class="o_legal_tile_icon"><i class="fa fa-briefcase" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_open_cases" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Open Cases</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_hearings_week" type="object" class="o_legal_tile o_legal_tile_info">
                                    <div class="o_legal_tile_icon"><i class="fa fa-university" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_hearings_week" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Hearings, 7 Days</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_deadlines_overdue" type="object" class="o_legal_tile o_legal_tile_danger">
                                    <div class="o_legal_tile_icon"><i class="fa fa-exclamation-triangle" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_deadlines_overdue" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Overdue Deadlines</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_deadlines_week" type="object" class="o_legal_tile o_legal_tile_warning">
                                    <div class="o_legal_tile_icon"><i class="fa fa-clock-o" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_deadlines_week" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Deadlines, 7 Days</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_draft_cases" type="object" class="o_legal_tile">
                                    <div class="o_legal_tile_icon"><i class="fa fa-balance-scale" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_draft_cases" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Awaiting Conflict Check</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_my_draft_time" type="object" class="o_legal_tile">
                                    <div class="o_legal_tile_icon"><i class="fa fa-hourglass-half" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="my_draft_time" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Draft Time</div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="o_legal_dash_section" invisible="not show_supervisor">
                        <div class="o_legal_dash_section_title">Team</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_blocked_conflicts" type="object" class="o_legal_tile o_legal_tile_danger">
                                    <div class="o_legal_tile_icon"><i class="fa fa-ban" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="blocked_conflicts" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Blocked Conflicts</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_unassigned_cases" type="object" class="o_legal_tile o_legal_tile_warning">
                                    <div class="o_legal_tile_icon"><i class="fa fa-user-times" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="unassigned_cases" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Unassigned Cases</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_cases_by_lawyer" type="object" class="o_legal_tile">
                                    <div class="o_legal_tile_icon"><i class="fa fa-users" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_label">Case Load by Lawyer</div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="o_legal_dash_section" invisible="not show_manager">
                        <div class="o_legal_dash_section_title">Oversight</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_ai_needs_review" type="object" class="o_legal_tile o_legal_tile_warning">
                                    <div class="o_legal_tile_icon"><i class="fa fa-eye" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="ai_needs_review" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">AI Needs Review</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_trust_accounts" type="object" class="o_legal_tile o_legal_tile_success">
                                    <div class="o_legal_tile_icon"><i class="fa fa-shield" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_label">Trust Accounts</div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="o_legal_dash_section" invisible="not show_accountant">
                        <div class="o_legal_dash_section_title">Billing</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_billable_time" type="object" class="o_legal_tile o_legal_tile_success">
                                    <div class="o_legal_tile_icon"><i class="fa fa-money" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="billable_time" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Billable Time</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_approved_expenses" type="object" class="o_legal_tile o_legal_tile_success">
                                    <div class="o_legal_tile_icon"><i class="fa fa-file-text-o" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="approved_expenses" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Expenses to Invoice</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6 col-md-4 col-xl-3">
                                <button name="action_draft_engagements" type="object" class="o_legal_tile">
                                    <div class="o_legal_tile_icon"><i class="fa fa-handshake-o" role="img"/></div>
                                    <div class="o_legal_tile_body">
                                        <div class="o_legal_tile_count"><field name="draft_engagements" nolabel="1"/></div>
                                        <div class="o_legal_tile_label">Draft Engagements</div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">legal.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Sequence 5: clicking the app's root opens its first child, and the
         landing everyone asked for is this, with Cases one click away. -->
    <menuitem id="menu_legal_dashboard" name="Dashboard"
              parent="menu_legal_root" action="action_legal_dashboard" sequence="5"/>
</odoo>
