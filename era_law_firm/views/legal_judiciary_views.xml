<odoo>

    <record id="view_legal_jurisdiction_list" model="ir.ui.view">
        <field name="name">legal.jurisdiction.list</field>
        <field name="model">legal.jurisdiction</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_legal_jurisdiction_form" model="ir.ui.view">
        <field name="name">legal.jurisdiction.form</field>
        <field name="model">legal.jurisdiction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Commercial Judiciary"/></h1></div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Statutory basis"><field name="note" nolabel="1"/></group>
                    <notebook>
                        <page string="Courts" name="courts">
                            <field name="court_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="degree"/>
                                    <field name="city"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_jurisdiction" model="ir.actions.act_window">
        <field name="name">Jurisdictions</field>
        <field name="res_model">legal.jurisdiction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_legal_court_list" model="ir.ui.view">
        <field name="name">legal.court.list</field>
        <field name="model">legal.court</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="degree"/>
                <field name="jurisdiction_id"/>
                <field name="city"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_legal_court_search" model="ir.ui.view">
        <field name="name">legal.court.search</field>
        <field name="model">legal.court</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city"/>
                <field name="jurisdiction_id"/>
                <filter name="first" string="First Instance" domain="[('degree','=','first')]"/>
                <filter name="appeal" string="Appeal" domain="[('degree','=','appeal')]"/>
                <group name="group_by">
                    <filter name="group_jurisdiction" string="Jurisdiction" context="{'group_by': 'jurisdiction_id'}"/>
                    <filter name="group_degree" string="Degree" context="{'group_by': 'degree'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_legal_court_form" model="ir.ui.view">
        <field name="name">legal.court.form</field>
        <field name="model">legal.court</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Commercial Court in Riyadh"/></h1></div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="degree"/>
                            <field name="jurisdiction_id"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Circuits" name="circuits">
                            <field name="circuit_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_court" model="ir.actions.act_window">
        <field name="name">Courts</field>
        <field name="res_model">legal.court</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_legal_court_search"/>
    </record>

    <record id="view_legal_circuit_list" model="ir.ui.view">
        <field name="name">legal.circuit.list</field>
        <field name="model">legal.circuit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="court_id"/>
                <field name="jurisdiction_id" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_legal_circuit" model="ir.actions.act_window">
        <field name="name">Circuits</field>
        <field name="res_model">legal.circuit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_legal_config_jurisdictions" name="Jurisdictions" parent="menu_legal_config_judiciary"
              action="action_legal_jurisdiction" sequence="4"/>
    <menuitem id="menu_legal_config_courts" name="Courts" parent="menu_legal_config_judiciary"
              action="action_legal_court" sequence="5"/>
    <menuitem id="menu_legal_config_circuits" name="Circuits" parent="menu_legal_config_judiciary"
              action="action_legal_circuit" sequence="6"/>

</odoo>
