<odoo>
 <template id="portal_my_home_legal" inherit_id="portal.portal_my_home" name="Legal cases portal entry"><xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><t t-call="portal.portal_docs_entry"><t t-set="title">My Legal Cases</t><t t-set="url" t-value="'/my/legal-cases'"/><t t-set="placeholder_count" t-value="'legal_case_count'"/></t></xpath></template>
 <template id="portal_my_legal_cases" name="My Legal Cases"><t t-call="portal.portal_layout"><div class="container"><h2>My Legal Cases</h2><table class="table"><thead><tr><th>Reference</th><th>Type</th><th>Stage</th></tr></thead><tbody><tr t-foreach="cases" t-as="case"><td><a t-att-href="case.access_url"><t t-out="case.name"/></a></td><td><t t-out="case.case_type"/></td><td><t t-out="case.stage_id.name"/></td></tr></tbody></table></div></t></template>
 <template id="portal_legal_case" name="Legal Case"><t t-call="portal.portal_layout"><div class="container"><h2><t t-out="case.name"/></h2><p><t t-out="case.stage_id.name"/></p><h4>Published documents</h4><ul><li t-foreach="documents" t-as="doc"><a t-att-href="'/my/legal-cases/%s/documents/%s/download' % (case.id, doc.id)"><t t-out="doc.name"/></a></li></ul></div></t></template>
</odoo>
