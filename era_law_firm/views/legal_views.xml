                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="is_rejected"/>
            </list>
        </field>
    </record>

    <record id="action_legal_case_stage" model="ir.actions.act_window">
        <field name="name">Case Stages</field>
        <field name="res_model">legal.case.stage</field>
        <field name="view_mode">list,form</field>
    </record>

