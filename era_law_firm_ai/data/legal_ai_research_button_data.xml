<odoo>
    <!-- What the AI button opens inside this app, as data rather than as code:
         the key the button sends there, the agent that answers it, the standing
         instructions, and the questions offered to start from. Point ai_agent
         elsewhere and the button follows, with nothing to redeploy.

         One key covers every screen in the app, with a record or without one,
         because that is how a lawyer moves through it: the dashboard, a list,
         a statute, a case. The prompts below therefore come in both flavours —
         they are sampled, not shown as a set — and the standing instructions
         tell the agent to read the record when one arrives.

         Not noupdate: an upgrade should refresh what the module ships, and a
         firm that wants its own wording copies the record rather than editing
         this one. -->

    <!-- The starters this button offers, and they are all about the file the
         lawyer is standing on. That is what this agent is for; the general
         statutory question has a door of its own now, and when this button is
         pressed with no record open it borrows that door's questions
         (ai_chat_prompts.py). -->
    <record id="prompt_app_file_summary" model="ai.prompt.button">
        <field name="name">لخّص الملف المفتوح في خمسة أسطر</field>
        <field name="sequence">50</field>
    </record>
    <record id="prompt_app_next_step" model="ai.prompt.button">
        <field name="name">ما الخطوة التالية على هذا الملف ومتى؟</field>
        <field name="sequence">60</field>
    </record>
    <record id="prompt_app_gaps" model="ai.prompt.button">
        <field name="name">ما المستندات أو الأدلة الناقصة في هذا الملف؟</field>
        <field name="sequence">70</field>
    </record>
    <record id="prompt_app_hearing" model="ai.prompt.button">
        <field name="name">حضّر لي الجلسة القادمة في هذا الملف</field>
        <field name="sequence">80</field>
    </record>
    <record id="prompt_app_deadlines" model="ai.prompt.button">
        <field name="name">ما المواعيد النظامية القريبة على هذا الملف وما مصدر كل منها؟</field>
        <field name="sequence">90</field>
    </record>
    <record id="prompt_app_position" model="ai.prompt.button">
        <field name="name">ما نقاط القوة والضعف في موقفنا على هذا الملف؟</field>
        <field name="sequence">100</field>
    </record>

    <record id="composer_legal_research" model="ai.composer">
        <field name="name">المستشار القانوني — the AI button inside this app</field>
        <field name="interface_key">era_legal_research</field>
        <field name="ai_agent" ref="agent_legal_advisor"/>
        <field name="default_prompt">هذه محادثة مع مستشار المكتب داخل نظام إدارة مكتب المحاماة.

إن وصلك سجل من النظام — قضية أو جلسة أو مهلة أو مستند — فهو موضوع السؤال: اعتمد على معطياته وعلى ملف القضية الذي يتبعه. وإن لم يصلك سجل فالسؤال نظامي عام، فأجب من النصوص المرفوعة إلى هذا الوكيل.

وفي الحالين: ابدأ بالجواب المباشر، ثم اذكر السند من النصوص المرفقة بنظامه ومادته كما وردت. ولا تذكر رقم مادة لم يرد نصها فيها. ومخرجك مسودة يتحقق منها المحامي قبل الاعتماد عليها.</field>
        <field name="available_prompts" eval="[(6, 0, [
            ref('prompt_app_file_summary'),
            ref('prompt_app_next_step'),
            ref('prompt_app_gaps'),
            ref('prompt_app_hearing'),
            ref('prompt_app_deadlines'),
            ref('prompt_app_position')])]"/>
    </record>

</odoo>
