<odoo>
    <!-- The research agent is the one that answers only from its sources, so it is
         the one that must carry the statute texts. Flagging it here means a fresh
         install wires the corpus to it without anyone remembering to. Kept in its
         own file (not noupdate) so an upgrade re-asserts the flag if it was cleared;
         the agent record itself stays defined, noupdate, in legal_ai_agents_data. -->
    <record id="agent_research" model="ai.agent">
        <field name="moj_corpus_target" eval="True"/>
    </record>

    <!-- Drafting and contract review both ask the model for the statutory
         basis, and a prompt that demands article numbers without the texts to
         read them from gets them recalled from memory — a wrong article number
         in a filed memo is the most expensive thing this module can produce.
         Summarising is deliberately not here: its job is the document in front
         of it, and injecting statute chunks into every summary would push it
         to opine instead. -->
    <record id="agent_drafting" model="ai.agent">
        <field name="moj_corpus_target" eval="True"/>
    </record>
    <record id="agent_contract_review" model="ai.agent">
        <field name="moj_corpus_target" eval="True"/>
    </record>
</odoo>
