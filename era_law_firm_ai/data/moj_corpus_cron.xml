<odoo>
    <!-- Monthly, on the first of the month. The scraper republishes every
         Saturday, but statutes do not change at that rate: a run that finds
         nothing new does no work beyond one fetch, and a run that finds
         something re-embeds only the statutes whose text actually moved. The
         cost of being up to a month behind on a royal decree is lower than the
         cost of the weekly churn, and a firm that needs a change today has the
         Resync button.

         Indexing needs no cron of its own: ai.agent.source.create() calls
         _trigger() on ai.ir_cron_generate_embedding, and that cron is shipped
         with a 9999-month interval precisely because it is trigger-driven
         rather than scheduled. A new or replaced statute is embedded within
         seconds of the sync writing it — on a live database. On a neutralized
         one every cron is deactivated, and Odoo deliberately refuses to let
         them be re-enabled, so indexing there has to be run by hand. -->
    <record id="cron_moj_corpus_sync" model="ir.cron">
        <field name="name">Saudi Legislation Corpus Sync</field>
        <field name="model_id" ref="model_moj_law"/>
        <field name="state">code</field>
        <field name="code">model._run_corpus_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <!-- Anchored to the 1st at 02:00: Odoo adds the interval to nextcall,
             so the anchor is what keeps it on the first of every month rather
             than drifting to whatever day it was installed. -->
        <field name="nextcall"
               eval="(DateTime.now().replace(day=1, hour=2, minute=0, second=0, microsecond=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
