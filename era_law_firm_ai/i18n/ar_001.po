#. module: era_law_firm_ai
#: model:ir.model.fields,field_description:era_law_firm_ai.field_ai_agent__legal_sources_ready
msgid "Sources Usable"
msgstr "المصادر صالحة للاستخدام"

#. module: era_law_firm_ai
#: model:ir.model.fields,field_description:era_law_firm_ai.field_legal_ai_charter__body
#: model_terms:ir.ui.view,arch_db:era_law_firm_ai.view_legal_ai_charter_form
