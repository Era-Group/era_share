<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="era_law_firm_ai.CitationDialog">
        <Dialog size="'lg'" title="props.document.name || 'Source'">
            <!-- What a lawyer would type into the Ministry's own search. Not a
                 link: those addresses are rotated, and a citation that leads to
                 a dead page is worse than no citation. -->
            <div t-if="reference.length" class="o_era_citation_ref border rounded p-2 mb-3 small">
                <div t-foreach="reference" t-as="row" t-key="row.label" class="d-flex gap-2">
                    <span class="text-muted" style="min-width: 9rem;" t-esc="row.label"/>
                    <span class="fw-bold" t-esc="row.value"/>
                </div>
            </div>
            <div t-if="hasText" class="o_era_citation_text border rounded p-3 bg-view" t-out="body"/>
            <div t-else="" class="text-muted">
                This source is a file rather than text. Open it to read it.
            </div>
            <t t-set-slot="footer">
                <button t-if="props.document.citation_line" class="btn btn-secondary"
                        t-on-click="onCopyReference">Copy the reference</button>
                <a t-if="!hasText" class="btn btn-secondary"
                   t-att-href="props.document.download_url" target="_blank"
                   rel="noreferrer noopener">Open the file</a>
                <button class="btn btn-primary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
