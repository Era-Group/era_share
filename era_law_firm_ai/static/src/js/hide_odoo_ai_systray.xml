<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The button itself is left exactly as Odoo wrote it; only a condition is
         added, so nothing about how it looks or behaves elsewhere is restated
         here and a change upstream carries through. -->
    <t t-name="era_law_firm_ai.SystrayActionInLawFirm"
       t-inherit="ai.SystrayAction" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-if">!eraInLawFirm.value</attribute>
        </xpath>
    </t>

</templates>
