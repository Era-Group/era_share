<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        All Live Chat History — exposes every discuss.channel of type
        'livechat' in a single menu, including conversations handled by
        AI agents.

        Odoo's built-in "Sessions" action (im_livechat.discuss_channel_action)
        filters by `livechat_channel_id != False`. AI-only conversations
        can be created without a livechat_channel_id and therefore never
        show up there. This action keeps the same form + list views
        im_livechat ships (so messages render correctly) but broadens
        the domain to every channel of type 'livechat'.

        We also need our own search view: im_livechat's search view
        auto-applies an "Active sessions" filter that hides every closed
        conversation. The search view below ships no default filters —
        all sessions appear by default — and offers explicit
        Active / Closed toggle filters the user can apply manually.
    -->

    <record id="view_era_livechat_history_search" model="ir.ui.view">
        <field name="name">era.livechat.history.search</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <search string="Chat History">
                <field name="name"/>
                <field name="livechat_operator_id" string="Operator / AI"/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_operator" string="Operator / AI"
                            context="{'group_by': 'livechat_operator_id'}"/>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_era_livechat_history" model="ir.actions.act_window">
        <field name="name">All Chat History</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('channel_type', '=', 'livechat')]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_era_livechat_history_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list',   'view_id': ref('im_livechat.discuss_channel_view_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('im_livechat.discuss_channel_view_kanban')}),
            (0, 0, {'view_mode': 'form',   'view_id': ref('im_livechat.discuss_channel_view_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No live chat conversations yet
            </p>
            <p>
                Once visitors chat with your AI agent or human operators on the
                website, every conversation will appear here — newest first.
            </p>
        </field>
    </record>

    <!-- Menu under the existing Live Chat root, just below "Sessions". -->
    <menuitem id="menu_era_livechat_history"
              name="All Chat History"
              parent="im_livechat.menu_livechat_root"
              action="action_era_livechat_history"
              sequence="20"/>

</odoo>
