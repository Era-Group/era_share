<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="monte_carlo_comparison_view_form" model="ir.ui.view">
        <field name="name">monte.carlo.comparison.form</field>
        <field name="model">monte.carlo.comparison</field>
        <field name="arch" type="xml">
            <form string="Compare Scenarios">
                <sheet>
                    <div class="oe_title">
                        <h1>Scenario Comparison</h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Compare the probable outcomes of several runs at once.
                        Pick the runs below; the cumulative-probability curves
                        and the figures update automatically. A curve further to
                        the <b>right</b> means generally higher outcomes (better
                        for revenue/profit, but worse for cost/time goals); a
                        <b>steeper</b> curve means less uncertainty.
                    </div>
                    <group>
                        <field name="run_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Add completed runs to compare..."/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not note">
                        <field name="note" nolabel="1"/>
                    </div>
                    <separator string="Cumulative Probability (CDF)"
                               invisible="not comparison_chart"/>
                    <field name="comparison_chart" nolabel="1"
                           invisible="not comparison_chart"/>
                    <separator string="Side-by-side Figures"
                               invisible="not comparison_table"/>
                    <field name="comparison_table" nolabel="1"
                           invisible="not comparison_table"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="monte_carlo_comparison_action" model="ir.actions.act_window">
        <field name="name">Compare Scenarios</field>
        <field name="res_model">monte.carlo.comparison</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_monte_carlo_run"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
