<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="monte_carlo_result_view_list" model="ir.ui.view">
        <field name="name">monte.carlo.result.list</field>
        <field name="model">monte.carlo.result</field>
        <field name="arch" type="xml">
            <list string="Simulation Results" create="false" edit="false">
                <field name="run_id"/>
                <field name="iteration"/>
                <field name="output_value" avg="Average"/>
                <field name="input_snapshot_display" string="Inputs"/>
            </list>
        </field>
    </record>

    <record id="monte_carlo_result_view_graph" model="ir.ui.view">
        <field name="name">monte.carlo.result.graph</field>
        <field name="model">monte.carlo.result</field>
        <field name="arch" type="xml">
            <graph string="Outcome Distribution" type="bar" sample="1">
                <field name="output_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="monte_carlo_result_view_pivot" model="ir.ui.view">
        <field name="name">monte.carlo.result.pivot</field>
        <field name="model">monte.carlo.result</field>
        <field name="arch" type="xml">
            <pivot string="Outcome Analysis" sample="1">
                <field name="run_id" type="row"/>
                <field name="output_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="monte_carlo_result_view_search" model="ir.ui.view">
        <field name="name">monte.carlo.result.search</field>
        <field name="model">monte.carlo.result</field>
        <field name="arch" type="xml">
            <search string="Results">
                <field name="run_id"/>
                <field name="model_id"/>
                <group>
                    <filter name="group_run" string="Run"
                            context="{'group_by': 'run_id'}"/>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="monte_carlo_result_action" model="ir.actions.act_window">
        <field name="name">Simulation Results</field>
        <field name="res_model">monte.carlo.result</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="monte_carlo_result_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No results yet
            </p>
            <p>
                Run a simulation to generate result rows, then analyse the
                outcome distribution here.
            </p>
        </field>
    </record>

</odoo>
