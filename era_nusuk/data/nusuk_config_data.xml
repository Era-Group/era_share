        </record>
        <record id="service_meals" model="umrah.service">
            <field name="name">Meals</field>
            <field name="code">meals</field>
            <field name="sequence">40</field>
        </record>
        <record id="service_guide" model="umrah.service">
            <field name="name">Guide</field>
            <field name="code">guide</field>
