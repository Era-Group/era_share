<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Occupancy types (editable seed data) -->
        <record id="occupancy_double" model="umrah.occupancy.type">
            <field name="name">Double</field>
            <field name="code">double</field>
            <field name="capacity">2</field>
