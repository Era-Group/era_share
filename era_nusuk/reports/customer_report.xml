<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>

<!-- ================================================== -->
<!-- REPORT ACTION -->
<!-- ================================================== -->

<record id="action_report_umrah_customer" model="ir.actions.report">

    <field name="name">Umrah Customer Report</field>

    <field name="model">umrah.customer</field>

    <field name="report_type">qweb-pdf</field>

    <field name="report_name">era_nusuk.report_umrah_customer</field>

    <field name="report_file">era_nusuk.report_umrah_customer</field>

    <field name="binding_model_id" ref="model_umrah_customer"/>

    <field name="binding_type">report</field>

    <field name="print_report_name">'Customer - %s' % (object.company_partner_id.name)</field>

</record>


<!-- ================================================== -->
<!-- REPORT TEMPLATE -->
<!-- ================================================== -->

<template id="report_umrah_customer">

<t t-call="web.external_layout">

<main>

<t t-foreach="docs" t-as="o">

<div class="page">

<style>

.report-box{
border:1px solid #d1d5db;
border-radius:10px;
padding:20px;
}

.header{
margin-bottom:20px;
}

.logo img{
max-height:60px;
}

.title{
font-size:24px;
font-weight:bold;
text-align:center;
margin-top:10px;
}

.section{
margin-top:15px;
}

.section-title{
background:#f3f4f6;
padding:6px 10px;
font-weight:bold;
border-radius:4px;
margin-bottom:5px;
}

.info-table{
width:100%;
font-size:13px;
}

.info-table td{
padding:4px 6px;
}

.label{
font-weight:600;
width:40%;
color:#374151;
}

.value{
color:#111827;
}

</style>


<div class="report-box">

<!-- HEADER -->

<table width="100%">

<tr>

<td width="30%" class="logo">
<img t-if="res_company.logo"
t-att-src="'data:image/png;base64,%s' % res_company.logo"/>
</td>

<td width="40%" class="title">
Customer Report
</td>

<td width="30%" style="text-align:right">
<strong>Status:</strong>
<span t-esc="dict(o._fields['state'].selection).get(o.state)"/>
</td>

</tr>

</table>


<!-- COMPANY INFO -->

<div class="section">

<div class="section-title">Company Information</div>

<table class="info-table">

<tr>
<td class="label">Company Name</td>
<td class="value" t-esc="o.company_partner_id.name"/>
</tr>

<tr>
<td class="label">Commercial Register</td>
<td class="value" t-esc="o.commercial_register"/>
</tr>

<tr>
<td class="label">Tax Number</td>
<td class="value" t-esc="o.vat"/>
</tr>

</table>

</div>


<!-- CONTACT -->

<div class="section">

<div class="section-title">Contact Information</div>

<table class="info-table">

<tr>
<td class="label">Mobile</td>
<td class="value" t-esc="o.mobile"/>
</tr>

<tr>
<td class="label">Phone</td>
<td class="value" t-esc="o.phone"/>
</tr>

<tr>
<td class="label">Email</td>
<td class="value" t-esc="o.email"/>
</tr>

</table>

</div>


<!-- ADDRESS -->

<div class="section">

<div class="section-title">Address</div>

<table class="info-table">

<tr>
<td class="label">Country</td>
<td class="value" t-esc="o.country_id.name"/>
</tr>

<tr>
<td class="label">City</td>
<td class="value" t-esc="o.city"/>
</tr>

<tr>
<td class="label">District</td>
<td class="value" t-esc="o.district"/>
</tr>

<tr>
<td class="label">Street</td>
<td class="value" t-esc="o.street"/>
</tr>

<tr>
<td class="label">Postal Code</td>
<td class="value" t-esc="o.zip"/>
</tr>

</table>

</div>


<!-- RESPONSIBLE -->

<div class="section">

<div class="section-title">Responsible Person</div>

<table class="info-table">

<tr>
<td class="label">Name</td>
<td class="value" t-esc="o.responsible_id.name"/>
</tr>

<tr>
<td class="label">Email</td>
<td class="value" t-esc="o.responsible_email"/>
</tr>

<tr>
<td class="label">Mobile</td>
<td class="value" t-esc="o.responsible_mobile"/>
</tr>

</table>

</div>


<!-- SALES -->

<div class="section">

<div class="section-title">Sales Information</div>

<table class="info-table">

<tr>
<td class="label">Salesperson</td>
<td class="value" t-esc="o.salesperson_id.name"/>
</tr>

</table>

</div>


<!-- STATISTICS -->

<div class="section">

<div class="section-title">Statistics</div>

<table class="info-table">

<tr>
<td class="label">Contracts</td>
<td class="value" t-esc="o.contract_count"/>
</tr>

<tr>
<td class="label">Groups</td>
<td class="value" t-esc="o.group_count"/>
</tr>

<tr>
<td class="label">Trips</td>
<td class="value" t-esc="o.trip_count"/>
</tr>

<tr>
<td class="label">Invoices</td>
<td class="value" t-esc="o.invoice_count"/>
</tr>

</table>

</div>


</div>

</div>

</t>

</main>

</t>

</template>

</data>
</odoo>