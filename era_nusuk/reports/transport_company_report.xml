<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>

<!-- ================================================== -->
<!-- REPORT ACTION -->
<!-- ================================================== -->

<record id="action_report_transport_company" model="ir.actions.report">

    <field name="name">Transport Company</field>

    <field name="model">umrah.transport.company</field>

    <field name="report_type">qweb-pdf</field>

    <field name="report_name">era_nusuk.report_transport_company</field>

    <field name="report_file">era_nusuk.report_transport_company</field>

    <field name="binding_model_id" ref="model_umrah_transport_company"/>

    <field name="binding_type">report</field>

    <field name="print_report_name">'Transport Company - %s' % (object.name)</field>

</record>


<!-- ================================================== -->
<!-- REPORT TEMPLATE -->
<!-- ================================================== -->

<template id="report_transport_company">

<t t-call="web.external_layout">

<main>

<t t-foreach="docs" t-as="o">

<div class="page">

<style>

.report-box{
border:1px solid #d1d5db;
border-radius:10px;
padding:20px;
}

.title{
font-size:24px;
font-weight:bold;
text-align:center;
margin-bottom:10px;
}

.section{
margin-top:15px;
}

.section-title{
background:#f3f4f6;
padding:6px 10px;
font-weight:bold;
border-radius:4px;
margin-bottom:6px;
}

.info-table{
width:100%;
font-size:13px;
}

.info-table td{
padding:4px 6px;
}

.label{
font-weight:600;
width:40%;
color:#374151;
}

.value{
color:#111827;
}

.logo img{
max-height:60px;
}

</style>


<div class="report-box">

<!-- HEADER -->

<table width="100%">

<tr>

<td width="30%" class="logo">
<img t-if="res_company.logo"
t-att-src="'data:image/png;base64,%s' % res_company.logo"/>
</td>

<td width="40%" class="title">
Transport Company Report
</td>

<td width="30%" style="text-align:right">
<strong>Rating:</strong>
<span t-esc="o.rating"/>
</td>

</tr>

</table>


<!-- COMPANY INFORMATION -->

<div class="section">

<div class="section-title">Company Information</div>

<table class="info-table">

<tr>
<td class="label">Company Name</td>
<td class="value" t-esc="o.name"/>
</tr>

<tr>
<td class="label">Tax Number</td>
<td class="value" t-esc="o.tax_number"/>
</tr>

<tr>
<td class="label">Reliability</td>
<td class="value" t-esc="dict(o._fields['reliability_score'].selection).get(o.reliability_score)"/>
</tr>

</table>

</div>


<!-- CONTACT -->

<div class="section">

<div class="section-title">Contact Information</div>

<table class="info-table">

<tr>
<td class="label">Mobile</td>
<td class="value" t-esc="o.mobile"/>
</tr>

<tr>
<td class="label">Phone</td>
<td class="value" t-esc="o.phone"/>
</tr>

<tr>
<td class="label">Email</td>
<td class="value" t-esc="o.email"/>
</tr>

<tr>
<td class="label">Website</td>
<td class="value" t-esc="o.website"/>
</tr>

</table>

</div>


<!-- LOCATION -->

<div class="section">

<div class="section-title">Location</div>

<table class="info-table">

<tr>
<td class="label">Country</td>
<td class="value" t-esc="o.country_id.name"/>
</tr>

<tr>
<td class="label">City</td>
<td class="value" t-esc="o.state_id.name"/>
</tr>

<tr>
<td class="label">District</td>
<td class="value" t-esc="o.district"/>
</tr>

<tr>
<td class="label">Street</td>
<td class="value" t-esc="o.street"/>
</tr>

<tr>
<td class="label">ZIP</td>
<td class="value" t-esc="o.zip"/>
</tr>

</table>

</div>


<!-- LICENSE -->

<div class="section">

<div class="section-title">License Information</div>

<table class="info-table">

<tr>
<td class="label">License Number</td>
<td class="value" t-esc="o.license_number"/>
</tr>

<tr>
<td class="label">License Expiry</td>
<td class="value" t-esc="o.license_expiry"/>
</tr>

</table>

</div>


<!-- VEHICLES -->

<div class="section">

<div class="section-title">Vehicles</div>

<table class="table table-sm table-bordered" width="100%">

<thead>

<tr>
<th>Vehicle</th>
<th>Code</th>
<th>Type</th>
<th>Capacity</th>
</tr>

</thead>

<tbody>

<tr t-foreach="o.vehicle_ids" t-as="v">

<td t-esc="v.name"/>
<td t-esc="v.vehicle_code"/>
<td t-esc="v.vehicle_type"/>
<td t-esc="v.passenger_capacity"/>

</tr>

</tbody>

</table>

</div>


</div>

</div>

</t>

</main>

</t>

</template>

</data>
</odoo>