<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agent list View -->
    <record id="view_umrah_agent_list" model="ir.ui.view">
        <field name="name">umrah.agent.list</field>
        <field name="model">umrah.agent</field>
        <field name="arch" type="xml">
            <list string="Agents">
                <field name="name"/>
                <field name="code"/>
                <field name="company_name"/>
                <field name="agent_type"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="total_trips_organized"/>
                <field name="total_pilgrims_served"/>
                <field name="rating"/>
                <field name="status"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Agent Form View -->
    <record id="view_umrah_agent_form" model="ir.ui.view">
        <field name="name">umrah.agent.form</field>
        <field name="model">umrah.agent</field>
        <field name="arch" type="xml">
            <form string="Agent">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object"
                            class="oe_highlight"
                            invisible="status != 'draft'"/>

                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="status != 'pending_approval'"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="status != 'approved'"/>
                    <button name="action_blacklist" string="Blacklist" type="object"
                            invisible="status not in ('approved','suspended')"/>
                    <button name="action_reactivate" string="Reactivate" type="object"
                            invisible="status != 'suspended'"/>

                    <field name="status" widget="statusbar" statusbar_visible="draft,pending_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Agent Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="code"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_name"/>
                            <field name="agent_type"/>
                            <field name="specialization"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <group>
                        <group string="Business Information">
                            <field name="license_number"/>
                            <field name="license_expiry_date"/>
                            <field name="tax_number"/>
                            <field name="registration_number"/>
                        </group>
                        <group string="Experience and Rating">
                            <field name="years_of_experience"/>
                            <field name="rating"/>
                            <field name="customer_satisfaction"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="Financial Information">
                            <field name="commission_rate"/>
                            <field name="payment_terms"/>
                        </group>
                        <group string="Performance Metrics">
                            <field name="total_trips_organized"/>
                            <field name="total_pilgrims_served"/>
                            <field name="success_rate"/>
                            <field name="average_group_size"/>
                        </group>
                    </group>
                    <group string="Bank Information">
                        <group>
                            <field name="bank_name"/>
                            <field name="bank_account_number"/>
                        </group>
                        <group>
                            <field name="iban"/>
                            <field name="swift_code"/>
                        </group>
                    </group>
                    <group string="Documents and Certifications">
                        <group>
                            <field name="has_umrah_license"/>
                            <field name="has_hajj_license"/>
                        </group>
                        <group>
                            <field name="has_travel_license"/>
                            <field name="has_insurance"/>
                        </group>
                    </group>
                    <group>
                        <group string="Emergency Contact">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                        <group string="Additional Information">
                            <field name="languages_spoken"/>
                        </group>
                    </group>
                    <group string="Services Offered">
                        <field name="services_offered"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Trips">
                            <field name="trip_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="departure_date"/>
                                    <field name="return_date"/>
                                    <field name="current_bookings"/>
                                    <field name="max_capacity"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Groups">
                            <field name="group_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="trip_ids"/>
                                    <field name="current_members"/>
                                    <field name="max_capacity"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visas Processed">
                            <field name="visa_ids">
                                <list>
                                    <field name="visa_number"/>
                                    <field name="pilgrim_id"/>
                                    <field name="visa_type"/>
                                    <field name="application_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoices">
                            <field name="invoice_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total_in_currency_signed"/>
                                    <field name="amount_residual_signed"/>
                                    <field name="state"/>
                                    <field name="status_in_payment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Agent Search View -->
    <record id="view_umrah_agent_search" model="ir.ui.view">
        <field name="name">umrah.agent.search</field>
        <field name="model">umrah.agent</field>
        <field name="arch" type="xml">
            <search string="Search Agents">
                <field name="name"/>
                <field name="code"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <filter string="Individual" name="individual" domain="[('agent_type', '=', 'individual')]"/>
                <filter string="Company" name="company" domain="[('agent_type', '=', 'company')]"/>
                <filter string="Tour Operator" name="tour_operator" domain="[('agent_type', '=', 'tour_operator')]"/>
                <filter string="Religious Organization" name="religious_organization"
                        domain="[('agent_type', '=', 'religious_organization')]"/>
                <separator/>
                <filter string="Umrah Only" name="umrah" domain="[('specialization', '=', 'umrah')]"/>
                <filter string="Hajj Only" name="hajj" domain="[('specialization', '=', 'hajj')]"/>
                <filter string="Both" name="both" domain="[('specialization', '=', 'both')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending_approval"
                        domain="[('status', '=', 'pending_approval')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Suspended" name="suspended" domain="[('status', '=', 'suspended')]"/>
                <filter string="Blacklisted" name="blacklisted" domain="[('status', '=', 'blacklisted')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter string="High Rating (4+)" name="high_rating" domain="[('rating', '>=', 4)]"/>
                <group expand="0" string="Group By">
                    <filter string="Agent Type" name="group_agent_type" context="{'group_by': 'agent_type'}"/>
                    <filter string="Specialization" name="group_specialization"
                            context="{'group_by': 'specialization'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>

                <searchpanel>
                    <field name="status" select="multi" string="Status" color="#875A7B"
                           enable_counters="1"/>
                    <field name="agent_type" select="multi" string="Type"  enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Agent Action -->
    <record id="action_umrah_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">umrah.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first agent!
            </p>
            <p>
                Manage travel agents and tour operators for Umrah services.
            </p>
        </field>
    </record>
</odoo>

