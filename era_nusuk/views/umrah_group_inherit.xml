<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Section 1: Groups screen refactor (via inheritance)   -->
    <!-- ===================================================== -->
    <record id="view_umrah_group_form_inherit" model="ir.ui.view">
        <field name="name">umrah.group.form.inherit</field>
        <field name="model">umrah.group</field>
        <field name="inherit_id" ref="view_umrah_group_form"/>
        <field name="arch" type="xml">

            <!-- 1.1 Remove the Create Invoice button -->
            <xpath expr="//button[@name='action_create_invoice']" position="replace"/>

            <!-- 1.2 Add the Trip Data group next to Basic Information.
                 NOTE: Odoo 18 forbids @string as an inheritance selector
                 (translatable attribute), so we anchor on a field that is
                 unique to the Basic Information group. -->
            <xpath expr="//group[field[@name='leader_id']]" position="after">
                <group string="Trip Data">
                    <field name="arrival_flight_no"/>
                    <field name="arrival_airport"/>
                    <field name="arrival_date"/>
                    <field name="departure_flight_no"/>
                    <field name="departure_airport"/>
                    <field name="departure_date"/>
                    <field name="makkah_hotel_id"/>
                    <field name="madinah_hotel_id"/>
                    <field name="package_id"/>
                    <field name="masar_group_number"/>
                </group>
            </xpath>

            <!-- 1.3 Remove the 5 tabs/pages. Each page is anchored on a field
                 unique to that page (string selectors are not allowed). -->
            <xpath expr="//page[.//field[@name='group_type']]" position="replace"/>            <!-- Type & Communication -->
            <xpath expr="//page[.//field[@name='special_requirements']]" position="replace"/>  <!-- Requirements -->
            <xpath expr="//page[.//field[@name='member_ids']]" position="replace"/>            <!-- Members -->
            <xpath expr="//page[.//field[@name='booking_reference']]" position="replace"/>      <!-- Hotel Bookings -->
            <xpath expr="//page[.//field[@name='trip_ids']]" position="replace"/>              <!-- Trips -->

        </field>
    </record>

</odoo>
