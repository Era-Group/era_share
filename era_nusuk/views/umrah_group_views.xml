<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Group list View -->
    <record id="view_umrah_group_list" model="ir.ui.view">

        <field name="name">umrah.group.list</field>

        <field name="model">umrah.group</field>

        <field name="arch" type="xml">

            <list string="Groups">

                <field name="name"/>
                <field name="code"/>

                <field name="leader_id"/>
                <field name="current_members"/>
                <field name="max_capacity"/>
                <field name="available_spots"/>
                <field name="group_type"/>
                <field name="status"/>

            </list>

        </field>

    </record>


    <!-- Group Form View -->
    <record id="view_umrah_group_form" model="ir.ui.view">

        <field name="name">umrah.group.form</field>

        <field name="model">umrah.group</field>

        <field name="arch" type="xml">

            <form string="Group">

                <header>
                    <button name="action_print_pilgrim_cards"
        type="object"
        string="Print Pilgrim Cards"
        class="btn-primary"
        icon="fa-id-card"/>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="oe_highlight"
                            invisible="status not in ('draft', 'forming')"/>

                    <button name="action_depart"
                            string="Depart"
                            type="object"
                            class="oe_highlight"
                            invisible="status not in ('confirmed')"/>

                    <button name="action_arrive_saudi"
                            string="Arrive in Saudi"
                            type="object"
                            invisible="status not in ('departed')"/>

                    <button name="action_return"
                            string="Return"
                            type="object"
                            invisible="status not in ('in_saudi')"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="oe_highlight"
                            invisible="status not in ('returned')"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="status not in ('draft', 'forming', 'confirmed')"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,forming,confirmed,departed,in_saudi,returned,completed"/>
                    <button name="action_create_invoice"
        string="Create Invoice"
        type="object"
        class="btn-primary"
        icon="fa-money"/>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">

    <button type="object"
            name="action_view_trips"
            class="oe_stat_button"
            icon="fa-plane">

        <field name="trip_count"
               widget="statinfo"
               string="Trips"/>

    </button>
                        <button name="action_view_programs"
        type="object"
        class="oe_stat_button"
        icon="fa-bus">

    <field name="program_count"
           widget="statinfo"
           string="Programs"/>

</button>

                        <button name="action_view_hotel_bookings"
        type="object"
        class="oe_stat_button"
        icon="fa-bed">

    <field name="hotel_booking_count"
           widget="statinfo"
           string="Hotel Bookings"/>

</button>

<button name="action_view_pilgrims"
        type="object"
        class="oe_stat_button"
        icon="fa-user">

    <field name="pilgrim_count"
           widget="statinfo"
           string="Pilgrims"/>

</button>

                        <button name="action_view_invoices"
        type="object"
        class="oe_stat_button"
        icon="fa-file-text-o">

    <field name="invoice_count" widget="statinfo" string="Invoices"/>

</button>

</div>

                                                <group>

                                <group string="Basic Information">

                                    <field name="name"/>
                                    <field name="code"/>
                                      <field name="trip_ids" widget="many2many_tags"/>
                                    <field name="leader_id"/>
                                    <field name="guide_id"/>
                                    <field name="agent_id"/>

                                </group>


                                <group string="Capacity and Dates">

                                    <field name="max_capacity"/>
                                    <field name="current_members"/>
                                    <field name="available_spots"/>
                                    <field name="formation_date"/>


                                </group>

                            </group>



                    <notebook>






                        <!-- ======================= -->
                        <!-- Type & Communication -->
                        <!-- ======================= -->

                        <page string="Type &amp; Communication">

                            <group>

                                <group string="Group Type and Restrictions">

                                    <field name="group_type"/>
                                    <field name="gender_restriction"/>
                                    <field name="age_restriction"/>

                                </group>


                                <group string="Communication">

                                    <field name="whatsapp_group_link"/>
                                    <field name="telegram_group_link"/>

                                </group>

                            </group>

                        </page>


                        <!-- ======================= -->
                        <!-- Requirements -->
                        <!-- ======================= -->

                        <page string="Requirements">

                            <group string="Special Requirements">

                                <field name="special_requirements"/>

                            </group>


                            <group string="Dietary Requirements">

                                <field name="dietary_requirements"/>

                            </group>


                            <group string="Medical Requirements">

                                <field name="medical_requirements"/>

                            </group>

                        </page>






                        <!-- ======================= -->
                        <!-- Pilgrims -->
                        <!-- ======================= -->

                       <page string="Members">

    <field name="member_ids">

        <list editable="bottom">
<field name="pilgrim_id"/>
           <field name="trip_id" domain="[('id','in',parent.trip_ids)]"/>
           <field name="hotel_booking_ids" widget="many2many_tags"/>


        </list>

    </field>

</page>

                        <page string="Trips">
                               <field name="trip_ids" widget="many2many_tags"/>

    <field name="trip_ids" readonly="1">

        <list>

            <field name="name"/>
            <field name="code"/>
            <field name="departure_date"/>
            <field name="return_date"/>
            <field name="duration_days"/>
            <field name="status"/>

        </list>

    </field>

</page>


                        <!-- ======================= -->
                        <!-- Hotel Bookings -->
                        <!-- ======================= -->

                        <page string="Hotel Bookings">

                            <field name="hotel_booking_ids">

                                <list>

                                    <field name="booking_reference"/>
                                    <field name="hotel_id"/>
                                    <field name="room_type_id"/>
                                    <field name="check_in_date"/>
                                    <field name="check_out_date"/>
                                    <field name="nights"/>
                                    <field name="total_cost"/>
                                    <field name="status"/>

                                </list>

                            </field>

                        </page>




                        <page string="Programs">



                                <field name="program_ids"/>






                        </page>
                        <!-- ======================= -->
                        <!-- Description & Notes -->
                        <!-- ======================= -->

                        <page string="Description &amp; Notes">

                            <group string="Description">

                                <field name="description"/>

                            </group>


                            <group string="Notes">

                                <field name="notes"/>

                            </group>

                        </page>


                    </notebook>

                </sheet>


                <chatter/>

            </form>

        </field>

    </record>


    <!-- Group Search View -->
    <record id="view_umrah_group_search" model="ir.ui.view">

        <field name="name">umrah.group.search</field>

        <field name="model">umrah.group</field>

        <field name="arch" type="xml">

            <search string="Search Groups">

                <field name="name"/>
                <field name="code"/>
                <field name="trip_ids" widget="many2many_tags"/>
                <field name="leader_id"/>
                <field name="agent_id"/>

                <filter string="Family"
                        name="family"
                        domain="[('group_type', '=', 'family')]"/>

                <filter string="Friends"
                        name="friends"
                        domain="[('group_type', '=', 'friends')]"/>

                <filter string="Organization"
                        name="organization"
                        domain="[('group_type', '=', 'organization')]"/>

                <filter string="Mixed"
                        name="mixed"
                        domain="[('group_type', '=', 'mixed')]"/>

                <filter string="VIP"
                        name="vip"
                        domain="[('group_type', '=', 'vip')]"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('status', '=', 'draft')]"/>

                <filter string="Forming"
                        name="forming"
                        domain="[('status', '=', 'forming')]"/>

                <filter string="Confirmed"
                        name="confirmed"
                        domain="[('status', '=', 'confirmed')]"/>

                <filter string="Departed"
                        name="departed"
                        domain="[('status', '=', 'departed')]"/>

                <filter string="In Saudi"
                        name="in_saudi"
                        domain="[('status', '=', 'in_saudi')]"/>

                <filter string="Returned"
                        name="returned"
                        domain="[('status', '=', 'returned')]"/>

                <filter string="Completed"
                        name="completed"
                        domain="[('status', '=', 'completed')]"/>

                <separator/>

                <filter string="Available Spots"
                        name="available"
                        domain="[('available_spots', '>', 0)]"/>

                <group expand="0" string="Group By">

                    <filter string="Trip"
                            name="group_trip"
                            context="{'group_by': 'trip_ids'}"/>

                    <filter string="Group Type"
                            name="group_type"
                            context="{'group_by': 'group_type'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'status'}"/>

                    <filter string="Agent"
                            name="group_agent"
                            context="{'group_by': 'agent_id'}"/>

                    <filter string="Formation Month"
                            name="group_formation_month"
                            context="{'group_by': 'formation_date:month'}"/>

                </group>

            </search>

        </field>

    </record>


    <!-- Group Action -->
    <record id="action_umrah_group" model="ir.actions.act_window">

        <field name="name">Groups</field>

        <field name="res_model">umrah.group</field>

        <field name="view_mode">list,form</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first group!
            </p>

            <p>
                Organize pilgrims into groups for better management during Umrah trips.
            </p>

        </field>

    </record>

</odoo>
