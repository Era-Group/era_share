<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================= -->
    <!-- List View (Tree سابقاً) -->
    <!-- ============================= -->

    <record id="view_umrah_location_type_list" model="ir.ui.view">
        <field name="name">umrah.location.type.list</field>
        <field name="model">umrah.location.type</field>
        <field name="arch" type="xml">
            <list string="Location Types">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!-- Form View -->
    <!-- ============================= -->

    <record id="view_umrah_location_type_form" model="ir.ui.view">
        <field name="name">umrah.location.type.form</field>
        <field name="model">umrah.location.type</field>
        <field name="arch" type="xml">
            <form string="Location Type">

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="code"/>

                    </group>

                    <group>

                        <field name="description"/>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ============================= -->
    <!-- Action -->
    <!-- ============================= -->

    <record id="action_umrah_location_type" model="ir.actions.act_window">
        <field name="name">Location Types</field>
        <field name="res_model">umrah.location.type</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>