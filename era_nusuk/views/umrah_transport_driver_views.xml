<odoo>

    <!-- ============================== -->
    <!-- LIST VIEW -->
    <!-- ============================== -->

    <record id="view_umrah_driver_list" model="ir.ui.view">
        <field name="name">umrah.driver.list</field>
        <field name="model">umrah.transport.driver</field>
        <field name="arch" type="xml">

            <list>
                <field name="driver_name"/>
                <field name="driver_phone"/>
                <field name="driver_license"/>
            </list>

        </field>
    </record>


    <!-- ============================== -->
    <!-- FORM VIEW -->
    <!-- ============================== -->

    <record id="view_umrah_driver_form" model="ir.ui.view">
        <field name="name">umrah.driver.form</field>
        <field name="model">umrah.transport.driver</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <!-- صورة السائق أعلى اليسار -->
                    <field name="image"
                           widget="image"
                           class="oe_avatar"
                           options="{'size':[120,120]}"/>

                    <group>

                        <group>
                            <field name="driver_name"/>
                            <field name="age"/>
                            <field name="id_number"/>
                            <field name="driver_phone"/>
                              <field name="driver_license"/>
                            <field name="license_attachment_ids" widget="many2many_binary"/>
                        </group>



                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ============================== -->
    <!-- ACTION -->
    <!-- ============================== -->

    <record id="action_umrah_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">umrah.transport.driver</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>