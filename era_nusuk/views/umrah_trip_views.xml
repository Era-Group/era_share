<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trip list View -->
    <record id="view_umrah_trip_list" model="ir.ui.view">

        <field name="name">umrah.trip.list</field>

        <field name="model">umrah.trip</field>

        <field name="arch" type="xml">

            <list string="Trips">

                <field name="name"/>
                <field name="code"/>
                <field name="departure_date"/>
                <field name="return_date"/>
                <field name="duration_days" readonly="1"/>
                <field name="current_bookings"/>
                <field name="max_capacity"/>
                <field name="available_seats"/>
                <field name="base_price"/>
                <field name="status"/>

            </list>

        </field>

    </record>


    <!-- Trip Form View -->
    <record id="view_umrah_trip_form" model="ir.ui.view">

        <field name="name">umrah.trip.form</field>

        <field name="model">umrah.trip</field>

        <field name="arch" type="xml">

            <form string="Trip">

                <header>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,completed"/>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">

    <button type="object"
            name="action_view_groups"
            class="oe_stat_button"
            icon="fa-users">

        <field name="group_count"
               widget="statinfo"
               string="Groups"/>

    </button>

                        <button name="action_view_pilgrims"
        type="object"
        class="oe_stat_button"
        icon="fa-user">

    <field name="pilgrim_count"
           widget="statinfo"
           string="Pilgrims"/>

</button>

                        <button name="action_view_bookings"
        type="object"
        class="oe_stat_button"
        icon="fa-bed">

    <field name="booking_count"
           widget="statinfo"
           string="Bookings"/>

</button>

</div>


                    <!-- BASIC INFORMATION -->

                    <group>

                        <group string="Basic Information">

                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="package_type"/>
                            <field name="agent_id"/>

                        </group>


                        <group string="Dates and Duration">

                            <field name="departure_date"/>
                            <field name="return_date"/>
                            <field name="duration_days"/>
                            <field name="created_date"/>

                        </group>

                    </group>



                    <!-- PACKAGE INCLUDES (NOW IN FORM) -->

                    <group string="Package Includes">

                        <group>

                            <field name="includes_flight"/>
                            <field name="includes_accommodation"/>
                            <field name="includes_transportation"/>

                        </group>

                        <group>

                            <field name="includes_meals"/>
                            <field name="includes_guide"/>

                        </group>

                    </group>



                    <!-- NOTEBOOK -->

                    <notebook>


                        <!-- PAGE 1 -->
                        <page string="Locations &amp; Capacity">

                            <group>

                                <group string="Locations">

                                    <field name="departure_city"/>
                                    <field name="departure_airport"/>
                                    <field name="arrival_city"/>
                                    <field name="arrival_airport"/>

                                </group>


                                <group string="Capacity and Pricing">

                                    <field name="max_capacity"/>
                                    <field name="current_bookings"/>
                                    <field name="available_seats"/>
                                    <field name="base_price"/>

                                </group>

                            </group>

                        </page>



                        <!-- PAGE 2 -->
                        <page string="Visits &amp; Notes">

                            <group string="Internal Visits">

                                <field name="mecca_visits"/>
                                <field name="medina_visits"/>
                                <field name="other_visits"/>

                            </group>


                            <group string="Notes">

                                <field name="notes"/>

                            </group>

                        </page>



                        <!-- PAGE 3 -->
                       <page string="Pilgrims">

    <field name="pilgrim_ids" readonly="1" widget="many2many">

        <list>

            <field name="full_name"/>
            <field name="passport_number"/>
            <field name="nationality"/>
            <field name="status"/>

        </list>

    </field>

</page>



                        <!-- PAGE 4 -->
                        <page string="Groups">

    <field name="group_ids">

        <list editable="bottom">

            <field name="name"/>
            <field name="code"/>
            <field name="current_members"/>
            <field name="max_capacity"/>
            <field name="status"/>

        </list>

    </field>

</page>



                        <!-- PAGE 5 -->
                        <page string="Hotels">

                            <field name="hotel_ids">

                                <list>

                                    <field name="name"/>
                                    <field name="city"/>
                                    <field name="star_rating"/>
                                    <field name="distance_to_haram"/>

                                </list>

                            </field>

                        </page>


                    </notebook>


                </sheet>


                <chatter/>

            </form>

        </field>

    </record>



    <!-- Trip Search View -->
    <record id="view_umrah_trip_search" model="ir.ui.view">

        <field name="name">umrah.trip.search</field>

        <field name="model">umrah.trip</field>

        <field name="arch" type="xml">

            <search string="Search Trips">

                <field name="name"/>
                <field name="code"/>
                <field name="departure_city"/>
                <field name="agent_id"/>

                <filter string="Economy"
                        name="economy"
                        domain="[('package_type', '=', 'economy')]"/>

                <filter string="Standard"
                        name="standard"
                        domain="[('package_type', '=', 'standard')]"/>

                <filter string="Premium"
                        name="premium"
                        domain="[('package_type', '=', 'premium')]"/>

                <filter string="VIP"
                        name="vip"
                        domain="[('package_type', '=', 'vip')]"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('status', '=', 'draft')]"/>

                <filter string="Confirmed"
                        name="confirmed"
                        domain="[('status', '=', 'confirmed')]"/>

                <filter string="In Progress"
                        name="in_progress"
                        domain="[('status', '=', 'in_progress')]"/>

                <filter string="Completed"
                        name="completed"
                        domain="[('status', '=', 'completed')]"/>

                <separator/>

                <filter string="Available Seats"
                        name="available"
                        domain="[('available_seats', '>', 0)]"/>

                <group expand="0" string="Group By">

                    <filter string="Package Type"
                            name="group_package"
                            context="{'group_by': 'package_type'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'status'}"/>

                    <filter string="Agent"
                            name="group_agent"
                            context="{'group_by': 'agent_id'}"/>

                    <filter string="Departure Month"
                            name="group_departure_month"
                            context="{'group_by': 'departure_date:month'}"/>

                </group>


                <searchpanel>

                    <field name="status"
                           select="multi"
                           string="Status"
                           color="#875A7B"
                           enable_counters="1"/>

                    <field name="agent_id"
                           select="multi"
                           string="Agent"
                           enable_counters="1"/>

                </searchpanel>

            </search>

        </field>

    </record>



    <!-- Trip Action -->
    <record id="action_umrah_trip" model="ir.actions.act_window">

        <field name="name">Trips</field>

        <field name="res_model">umrah.trip</field>

        <field name="view_mode">list,form</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first Umrah trip!
            </p>

            <p>
                Plan and manage Umrah trips with all necessary details.
            </p>

        </field>

    </record>

</odoo>
