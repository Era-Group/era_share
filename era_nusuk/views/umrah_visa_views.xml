<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Visa list View -->
    <record id="view_umrah_visa_list" model="ir.ui.view">

        <field name="name">umrah.visa.list</field>

        <field name="model">umrah.visa</field>

        <field name="arch" type="xml">

            <list string="Visas">

                <field name="visa_number"/>
                <field name="pilgrim_id"/>
                <field name="visa_type"/>
                <field name="application_date"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
                <field name="payment_status"/>
                <field name="total_fee"/>

            </list>

        </field>

    </record>



    <!-- Visa Form View -->
    <record id="view_umrah_visa_form" model="ir.ui.view">

        <field name="name">umrah.visa.form</field>

        <field name="model">umrah.visa</field>

        <field name="arch" type="xml">

            <form string="Visa">

                <header>

                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="oe_highlight"
                            invisible="status not in ('draft')"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="status not in ('under_review', 'submitted')"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="status not in ('under_review', 'submitted')"/>

                    <button name="action_issue"
                            string="Issue"
                            type="object"
                            class="oe_highlight"
                            invisible="status != 'approved'"/>

                    <button name="action_create_agent_invoice"
                            string="Create Invoice"
                            type="object"
                            class="oe_highlight"
                            invisible="status != 'issued'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="status not in ('under_review', 'submitted','draft', 'approved')"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,issued"/>

                </header>



                <sheet>


                    <!-- BASIC INFORMATION -->

                    <group>

                        <group string="Basic Information">

                            <field name="visa_number"/>
                            <field name="visa_type"/>
                            <field name="pilgrim_id"/>
                            <field name="trip_id"/>
                            <field name="group_id"/>
                            <field name="agent_id"/>

                        </group>


                        <group string="Application Details">

                            <field name="application_date"/>
                            <field name="application_reference"/>
                            <field name="consulate_location"/>

                        </group>

                    </group>



                    <!-- REJECTION REASON -->

                    <group string="Rejection Reason"
                           invisible="status not in ('rejected')">

                        <field name="rejection_reason"/>

                    </group>



                    <!-- NOTES -->

                    <group string="Notes">

                        <field name="notes"/>

                    </group>



                    <!-- NOTEBOOK -->

                    <notebook>


                        <!-- PAGE 1 -->
                        <page string="Visa Details">

                            <group>

                                <group string="Visa Details">

                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="validity_period"/>
                                    <field name="entry_type"/>
                                    <field name="duration_of_stay"/>

                                </group>


                                <group string="Fees">

                                    <field name="visa_fee"/>
                                    <field name="service_fee"/>
                                    <field name="total_fee"/>

                                </group>

                            </group>

                        </page>



                        <!-- PAGE 2 -->
                        <page string="Payment Information">

                            <group string="Payment Information">

                                <field name="payment_status"/>
                                <field name="payment_date"/>
                                <field name="payment_reference"/>

                            </group>

                        </page>



                        <!-- PAGE 3 -->
                        <page string="Documents Submitted">

                            <group string="Documents Submitted">

                                <field name="passport_copy_submitted"/>
                                <field name="photo_submitted"/>
                                <field name="application_form_submitted"/>
                                <field name="invitation_letter_submitted"/>

                            </group>

                        </page>



                    </notebook>


                </sheet>



                <chatter/>

            </form>

        </field>

    </record>



    <!-- Visa Search View -->
    <record id="view_umrah_visa_search" model="ir.ui.view">

        <field name="name">umrah.visa.search</field>

        <field name="model">umrah.visa</field>

        <field name="arch" type="xml">

            <search string="Search Visas">

                <field name="visa_number"/>
                <field name="pilgrim_id"/>
                <field name="application_reference"/>
                <field name="agent_id"/>

                <filter string="Umrah"
                        name="umrah"
                        domain="[('visa_type', '=', 'umrah')]"/>

                <filter string="Hajj"
                        name="hajj"
                        domain="[('visa_type', '=', 'hajj')]"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('status', '=', 'draft')]"/>

                <filter string="Submitted"
                        name="submitted"
                        domain="[('status', '=', 'submitted')]"/>

                <filter string="Under Review"
                        name="under_review"
                        domain="[('status', '=', 'under_review')]"/>

                <filter string="Approved"
                        name="approved"
                        domain="[('status', '=', 'approved')]"/>

                <filter string="Issued"
                        name="issued"
                        domain="[('status', '=', 'issued')]"/>

                <filter string="Rejected"
                        name="rejected"
                        domain="[('status', '=', 'rejected')]"/>

                <separator/>

                <filter string="Unpaid"
                        name="unpaid"
                        domain="[('payment_status', '=', 'unpaid')]"/>

                <filter string="Paid"
                        name="paid"
                        domain="[('payment_status', '=', 'paid')]"/>

                <separator/>

                <filter string="Expiring Soon"
                        name="expiring_soon"
                        domain="[('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'status'}"/>

                    <filter string="Visa Type"
                            name="group_visa_type"
                            context="{'group_by': 'visa_type'}"/>

                    <filter string="Payment Status"
                            name="group_payment_status"
                            context="{'group_by': 'payment_status'}"/>

                    <filter string="Agent"
                            name="group_agent"
                            context="{'group_by': 'agent_id'}"/>

                    <filter string="Application Month"
                            name="group_application_month"
                            context="{'group_by': 'application_date:month'}"/>

                </group>


                <searchpanel>

                    <field name="status"
                           select="multi"
                           string="Status"
                           color="#875A7B"
                           enable_counters="1"/>

                    <field name="visa_type"
                           select="multi"
                           string="Type"
                           enable_counters="1"/>

                    <field name="agent_id"
                           select="multi"
                           string="Agent"
                           enable_counters="1"/>

                </searchpanel>

            </search>

        </field>

    </record>



    <!-- Visa Action -->
    <record id="action_umrah_visa" model="ir.actions.act_window">

        <field name="name">Visas</field>

        <field name="res_model">umrah.visa</field>

        <field name="view_mode">list,form</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first visa application!
            </p>

            <p>
                Manage visa applications and processing for Umrah pilgrims.
            </p>

        </field>

    </record>

</odoo>
