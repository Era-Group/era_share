<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_payment_reminder" model="mail.template">
            <field name="name">تذكير بدفعة مستحقة</field>
            <field name="model_id" ref="model_payment_tracking"/>
            <field name="subject">تذكير: دفعة مستحقة - {{ object.sale_order_id.name or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<div dir="rtl" style="direction:rtl; text-align:right; font-family:Tahoma, Arial, sans-serif; color:#333333; background-color:#f4f4f4; padding:16px;">
    <table align="center" width="100%" style="max-width:640px; margin:auto; background:#ffffff; border:1px solid #e0e0e0; border-radius:8px; overflow:hidden;">
        <tr>
            <td style="background-color:#1a5276; padding:20px 24px; color:#ffffff; font-size:20px; font-weight:bold;">
                تذكير بدفعة مستحقة
            </td>
        </tr>
        <tr>
            <td style="padding:24px;">
                <p style="margin:0 0 12px;">عميلنا العزيز <strong t-out="object.partner_id.name or ''">العميل</strong>،</p>
                <p style="margin:0 0 16px;">
                    نود تذكيركم بشأن الدفعات المستحقة على الطلب
                    <strong t-out="object.sale_order_id.name or object.name or ''">SO000</strong>.
                </p>

                <table width="100%" style="border-collapse:collapse; margin:16px 0;">
                    <tr style="background-color:#f0f3f6;">
                        <td style="padding:10px; border:1px solid #e0e0e0;">إجمالي الطلب</td>
                        <td style="padding:10px; border:1px solid #e0e0e0; font-weight:bold;">
                            <span t-out="format_amount(object.amount_total, object.currency_id)">0.00</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px; border:1px solid #e0e0e0;">المبلغ المدفوع</td>
                        <td style="padding:10px; border:1px solid #e0e0e0; color:#1e8449; font-weight:bold;">
                            <span t-out="format_amount(object.amount_paid, object.currency_id)">0.00</span>
                        </td>
                    </tr>
                    <tr style="background-color:#f0f3f6;">
                        <td style="padding:10px; border:1px solid #e0e0e0;">المبلغ المتبقي</td>
                        <td style="padding:10px; border:1px solid #e0e0e0; color:#c0392b; font-weight:bold;">
                            <span t-out="format_amount(object.amount_due, object.currency_id)">0.00</span>
                        </td>
                    </tr>
                    <tr t-if="object.next_payment_date">
                        <td style="padding:10px; border:1px solid #e0e0e0;">الدفعة القادمة</td>
                        <td style="padding:10px; border:1px solid #e0e0e0; font-weight:bold;">
                            <span t-out="format_amount(object.next_payment_amount, object.currency_id)">0.00</span>
                            بتاريخ
                            <span t-out="format_date(object.next_payment_date)">2026-01-01</span>
                        </td>
                    </tr>
                </table>

                <t t-if="object.installment_line_ids">
                    <h3 style="margin:20px 0 8px; color:#1a5276;">جدول الأقساط</h3>
                    <table width="100%" style="border-collapse:collapse;">
                        <tr style="background-color:#1a5276; color:#ffffff;">
                            <th style="padding:8px; border:1px solid #e0e0e0;">القسط</th>
                            <th style="padding:8px; border:1px solid #e0e0e0;">تاريخ الاستحقاق</th>
                            <th style="padding:8px; border:1px solid #e0e0e0;">المبلغ</th>
                            <th style="padding:8px; border:1px solid #e0e0e0;">المتبقي</th>
                        </tr>
                        <tr t-foreach="object.installment_line_ids" t-as="line">
                            <td style="padding:8px; border:1px solid #e0e0e0;" t-out="line.name or ''">القسط</td>
                            <td style="padding:8px; border:1px solid #e0e0e0;" t-out="format_date(line.due_date)">2026-01-01</td>
                            <td style="padding:8px; border:1px solid #e0e0e0;" t-out="format_amount(line.amount_expected, object.currency_id)">0.00</td>
                            <td style="padding:8px; border:1px solid #e0e0e0;" t-out="format_amount(line.amount_due, object.currency_id)">0.00</td>
                        </tr>
                    </table>
                </t>

                <p style="margin:20px 0 0;">نشكر لكم حسن تعاونكم، ونرجو سداد المبالغ المستحقة في مواعيدها.</p>
                <p style="margin:8px 0 0; color:#888888;">مع تحيات فريق <t t-out="object.company_id.name or ''">الشركة</t></p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>
    </data>
</odoo>
