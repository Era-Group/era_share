<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_brd_scope_item_form" model="ir.ui.view">
        <field name="name">project.brd.scope.item.form</field>
        <field name="model">project.brd.scope.item</field>
        <field name="arch" type="xml">
            <form string="مراجعة نطاق متطلب BRD">
                <sheet>
                    <field name="project_brd_state" invisible="1"/>
                    <field name="can_review" invisible="1"/>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="brd_version" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="source_reference" readonly="not can_review or project_brd_state != 'scope_review'"/>
                        </group>
                        <group>
                            <field name="ai_classification" widget="badge"/>
                            <field name="classification" widget="badge"
                                   readonly="not can_review or project_brd_state != 'scope_review'"/>
                            <field name="confidence" widget="badge" readonly="1"/>
                            <field name="commercial_status" widget="badge" readonly="not can_review"/>
                            <field name="cr_number" readonly="not can_review"/>
                        </group>
                    </group>
                    <group string="العمل المطلوب">
                        <field name="requirement" nolabel="1"
                               readonly="not can_review or project_brd_state != 'scope_review'"/>
                    </group>
                    <group string="المطابقة التعاقدية">
                        <field name="contract_reference"
                               readonly="not can_review or project_brd_state != 'scope_review'"/>
                        <field name="reason"
                               readonly="not can_review or project_brd_state != 'scope_review'"/>
                        <field name="impact" readonly="not can_review"/>
                        <field name="recommended_action" readonly="not can_review"/>
                        <field name="manager_decision_reason" widget="badge"
                               readonly="not can_review"
                               placeholder="إلزامي عند تغيير تصنيف الذكاء الاصطناعي"/>
                        <field name="manager_note" readonly="not can_review"
                               placeholder="تفاصيل إضافية اختيارية"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_project_form_brd" model="ir.ui.view">
        <field name="name">project.project.form.brd</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="era_sembly_meetings_tasks.view_project_project_form_sembly"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_build_brd" type="object"
                        string="بناء وثيقة المتطلبات (Build BRD)"
                        class="btn-primary" icon="fa-file-text-o"
                        groups="project.group_project_manager"
                        invisible="brd_state in ['queued', 'transcribing', 'extracting', 'generating', 'scope_analyzing', 'scope_review'] or brd_state == 'done'"/>
                <button name="action_build_brd" type="object"
                        string="إعادة بناء وثيقة المتطلبات"
                        class="btn-secondary" icon="fa-refresh"
                        groups="project.group_project_manager"
                        confirm="سيتم بناء نسخة جديدة من جميع تفريغات الاجتماعات الحالية. هل تريد المتابعة؟"
                        invisible="brd_state != 'done'"/>
                <button name="action_analyze_brd_scope" type="object"
                        string="تحليل الأعمال خارج النطاق"
                        class="btn-secondary" icon="fa-balance-scale"
                        groups="project.group_project_manager"
                        invisible="brd_state != 'done' and not (brd_state == 'failed' and brd_draft_document)"/>
                <button name="action_finalize_brd_scope" type="object"
                        string="اعتماد النطاق وإصدار BRD النهائي"
                        class="btn-primary" icon="fa-check-square-o"
                        groups="project.group_project_manager"
                        confirm="سيتم إصدار BRD النهائي وسجل طلبات التغيير حسب التصنيفات الحالية. هل تريد الاعتماد؟"
                        invisible="brd_state != 'scope_review'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="وثيقة المتطلبات BRD" name="project_brd">
                    <field name="brd_document_id" invisible="1"/>
                    <field name="brd_scope_document_id" invisible="1"/>
                    <field name="brd_draft_document" invisible="1"/>
                    <div class="d-flex justify-content-end mb-2">
                        <button name="action_open_brd_document" type="object"
                                string="فتح في المستندات" icon="fa-folder-open-o"
                                class="btn btn-primary me-2"
                                invisible="not brd_document_id"/>
                        <button name="action_open_brd_scope_document" type="object"
                                string="فتح سجل طلبات التغيير" icon="fa-external-link"
                                class="btn btn-secondary me-2"
                                invisible="not brd_scope_document_id"/>
                        <button name="action_open_brd_agent" type="object"
                                string="إعداد برومبت وكيل BRD" icon="fa-cog"
                                class="btn btn-secondary"
                                groups="base.group_system"/>
                    </div>
                    <separator string="خط أساس نطاق العقد"/>
                    <div class="alert alert-info" role="status">
                        يستخدم النظام هذا النص كمرجع تعاقدي للمقارنة. عند بدء التحليل تحفظ نسخة ثابتة منه ولا تؤثر التعديلات اللاحقة على التشغيل الجاري.
                    </div>
                    <field name="brd_contract_scope" widget="html" nolabel="1"
                           placeholder="ألصق نطاق العمل المتفق عليه حسب العقد أو SOW. عند تركه فارغاً يستخدم وصف المشروع عند بدء البناء."
                           readonly="brd_state in ['queued', 'transcribing', 'extracting', 'generating', 'scope_analyzing', 'scope_review']"
                           groups="project.group_project_manager"/>
                    <field name="brd_contract_scope" widget="html" nolabel="1"
                           readonly="1" groups="!project.group_project_manager"/>
                    <group>
                        <group>
                            <field name="brd_state" widget="badge" readonly="1"/>
                            <field name="brd_progress_message" readonly="1"/>
                            <field name="brd_requested_by_id" readonly="1"/>
                            <field name="brd_requested_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="brd_meeting_count" readonly="1"/>
                            <field name="brd_transcript_count" readonly="1"/>
                            <field name="brd_version" readonly="1"/>
                            <field name="brd_pending_version" readonly="1"
                                   invisible="brd_state not in ['generating', 'scope_analyzing', 'scope_review']"/>
                            <field name="brd_completed_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="brd_progress" widget="brd_progressbar" readonly="1"
                           invisible="brd_state not in ['queued', 'transcribing', 'extracting', 'generating', 'scope_analyzing', 'scope_review']"/>
                    <div class="alert alert-danger" role="alert" invisible="brd_state != 'failed'">
                        <field name="brd_error" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="not brd_document or brd_state == 'done'">
                        الوثيقة المعروضة أدناه هي الإصدار السابق؛ لم تستبدلها عملية البناء الحالية بعد.
                    </div>
                    <div class="alert alert-info" role="status" invisible="not brd_document">
                        يمكن لمدير المشروع تعديل الوثيقة هنا ثم حفظ المشروع. تتم مزامنة التعديلات تلقائياً إلى نفس الملف في تطبيق المستندات.
                    </div>
                    <separator string="مراجعة مطابقة النطاق"
                               groups="project.group_project_user"
                               invisible="brd_state != 'scope_review' and not brd_scope_item_ids"/>
                    <div class="alert alert-warning" role="status"
                         invisible="brd_state != 'scope_review'">
                        راجع كل تصنيف. يجب حسم البنود غير الواضحة، واختيار سبب قرار المدير عند تغيير اقتراح الذكاء الاصطناعي، ثم اضغط «اعتماد النطاق وإصدار BRD النهائي».
                    </div>
                    <field name="brd_contract_scope_snapshot" widget="html" readonly="1"
                           string="نسخة نطاق العقد المستخدمة"
                           invisible="brd_state != 'scope_review'"/>
                    <field name="brd_scope_item_ids" nolabel="1" mode="list"
                           readonly="brd_state != 'scope_review'"
                           groups="project.group_project_manager"
                           context="{'form_view_ref': 'era_project_brd.view_project_brd_scope_item_form'}">
                        <list editable="bottom" open_form_view="True" create="0" delete="0"
                              decoration-success="classification == 'in_scope'"
                              decoration-danger="classification in ['out_of_scope', 'change_candidate']"
                              decoration-warning="classification == 'unclear'"
                              decoration-muted="classification == 'deferred'">
                            <field name="sequence" widget="handle"/>
                            <field name="code" readonly="1"/>
                            <field name="requirement"/>
                            <field name="source_reference" optional="hide"/>
                            <field name="ai_classification" widget="badge" readonly="1" optional="show"/>
                            <field name="classification" widget="badge"/>
                            <field name="confidence" widget="badge" readonly="1" optional="show"/>
                            <field name="contract_reference" optional="show"/>
                            <field name="reason" optional="show"/>
                            <field name="impact" optional="hide"/>
                            <field name="recommended_action" optional="hide"/>
                            <field name="manager_decision_reason" widget="badge" optional="show"/>
                            <field name="manager_note" optional="hide"/>
                            <field name="cr_number" optional="show"/>
                            <field name="commercial_status" widget="badge" optional="show"/>
                        </list>
                    </field>
                    <field name="brd_scope_item_ids" nolabel="1" mode="list" readonly="1"
                           groups="project.group_project_user,!project.group_project_manager"
                           context="{'form_view_ref': 'era_project_brd.view_project_brd_scope_item_form'}">
                        <list open_form_view="True">
                            <field name="code"/>
                            <field name="requirement"/>
                            <field name="classification" widget="badge"/>
                            <field name="contract_reference" optional="show"/>
                            <field name="reason" optional="show"/>
                            <field name="cr_number" optional="show"/>
                            <field name="commercial_status" widget="badge" optional="show"/>
                        </list>
                    </field>
                    <separator string="مسودة BRD قيد المراجعة"
                               invisible="brd_state != 'scope_review'"/>
                    <field name="brd_draft_document" widget="html" readonly="1" nolabel="1"
                           invisible="brd_state != 'scope_review'"/>
                    <field name="brd_document" widget="html" nolabel="1"
                           class="w-100" invisible="not brd_document"
                           readonly="brd_state != 'done'"
                           groups="project.group_project_manager"/>
                    <field name="brd_document" widget="html" nolabel="1"
                           class="w-100" invisible="not brd_document" readonly="1"
                           groups="!project.group_project_manager"/>
                    <div class="text-muted" invisible="brd_document or brd_draft_document or brd_state in ['queued', 'transcribing', 'extracting', 'generating', 'scope_analyzing', 'scope_review']">
                        لم يتم بناء وثيقة متطلبات لهذا المشروع بعد.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
