<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="era_delivery_note_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t>
                <!-- read every value in en_US so figures and dates stay latin -->
                <t t-set="doc" t-value="o.with_context(lang='en_US')"/>
                <t t-set="H" t-value="env['era.report.helper']"/>
                <t t-set="partner" t-value="doc.partner_id or (doc.move_ids and doc.move_ids[0].partner_id)"/>
                <t t-set="cmp" t-value="doc.company_id.sudo().with_context(lang='en_US')"/>
                <t t-set="code" t-value="doc.picking_type_id.code"/>
                <t t-set="moves" t-value="[m for m in doc.move_ids if m.state != 'cancel']"/>

                <t t-set="era_title_ar" t-value="'إذن استلام' if code == 'incoming' else ('إذن تحويل' if code == 'internal' else 'إذن تسليم')"/>
                <t t-set="era_title_en" t-value="'RECEIPT NOTE' if code == 'incoming' else ('INTERNAL TRANSFER' if code == 'internal' else 'DELIVERY NOTE')"/>
                <t t-set="era_identity_name" t-value="cmp.name"/>
                <t t-set="era_identity_sub" t-value="' | '.join(
                    (['C.R. ' + cmp.company_registry] if cmp.company_registry else [])
                    + (['VAT ' + cmp.partner_id.vat] if cmp.partner_id.vat else []))"/>

                <t t-set="era_meta" t-value="[
                    {'ar': 'رقم الإذن', 'en': 'DN No.', 'val': doc.name},
                    {'ar': 'التاريخ', 'en': 'Date', 'val': H.doc_date(doc.date_done or doc.scheduled_date)},
                    {'ar': 'أمر البيع', 'en': 'SO Ref.', 'val': doc.origin or '-'},
                    {'ar': 'يسلم إلى موقع', 'en': 'Deliver to', 'val': (partner.name or '-') + (' - ' + partner.city if partner.city else '')},
                ]"/>

                <t t-set="era_parties" t-value="[
                    {
                        'variant': 'teal',
                        'title_ar': 'الشركة',
                        'title_en': 'Company',
                        'name': cmp.name,
                        'rows': [
                            ('العنوان', H.address_line(cmp.partner_id)),
                            ('السجل التجاري', cmp.company_registry or '-'),
                            ('الهاتف', cmp.phone or '-'),
                        ],
                    },
                    {
                        'variant': 'indigo',
                        'title_ar': 'العميل',
                        'title_en': 'Customer',
                        'name': partner.name or '-',
                        'rows': [
                            ('العنوان', H.address_line(partner)),
                            ('الهاتف', partner.phone or '-'),
                        ] + ([('الرقم الضريبي', partner.vat)] if partner.vat else []),
                    },
                ]"/>

                <t t-set="era_signatures" t-value="[
                    ('أمين المستودع', 'Storekeeper'),
                    ('مندوب التسليم', 'Delivery Rep'),
                    ('استلام العميل', 'Customer Receipt'),
                ]"/>

                <t t-call="era_report_designs.era_document_layout">

                    <table class="o_era_table">
                        <colgroup>
                            <col style="width: 4%"/>
                            <col style="width: 30%"/>
                            <col style="width: 10%"/>
                            <col style="width: 16%"/>
                            <col style="width: 13%"/>
                            <col style="width: 13%"/>
                            <col style="width: 14%"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th><span class="o_era_table__hd-ar">م</span><span class="o_era_table__hd-en">SN</span></th>
                                <th><span class="o_era_table__hd-ar">الصنف / الوصف</span><span class="o_era_table__hd-en">Description</span></th>
                                <th><span class="o_era_table__hd-ar">الوحدة</span><span class="o_era_table__hd-en">UoM</span></th>
                                <th><span class="o_era_table__hd-ar">رقم الدفعة</span><span class="o_era_table__hd-en">Lot / Serial</span></th>
                                <th><span class="o_era_table__hd-ar">الكمية المطلوبة</span><span class="o_era_table__hd-en">Ordered</span></th>
                                <th><span class="o_era_table__hd-ar">الكمية المسلمة</span><span class="o_era_table__hd-en">Delivered</span></th>
                                <th><span class="o_era_table__hd-ar">حالة الصنف</span><span class="o_era_table__hd-en">Status</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="moves" t-as="move">
                                <td t-out="move_index + 1"/>
                                <td class="o_era_table__desc">
                                    <div class="o_era_table__desc-main" t-out="move.product_id.name"/>
                                    <div t-if="move.description_picking and move.description_picking != move.product_id.name"
                                         class="o_era_table__desc-sub" t-out="move.description_picking"/>
                                </td>
                                <td t-out="move.product_uom.name"/>
                                <td t-out="', '.join(lot.name for lot in move.move_line_ids.lot_id) or '-'"/>
                                <td t-out="H.qty(move.product_uom_qty)"/>
                                <td t-out="H.qty(move.quantity)"/>
                                <td>
                                    <span t-if="move.quantity &gt;= move.product_uom_qty" class="o_era_badge o_era_badge--ok">سليم</span>
                                    <span t-else="" class="o_era_badge o_era_badge--short">ناقص</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="o_era_foot-block">
                        <tr>
                            <td style="width: 50%">
                                <div class="o_era_tile">
                                    <table>
                                        <tr>
                                            <td class="o_era_tile__lbl">إجمالي الكمية المطلوبة / Total Ordered</td>
                                            <td class="o_era_tile__val" t-out="H.qty(sum(move.product_uom_qty for move in moves))"/>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                            <td style="width: 50%">
                                <div class="o_era_tile o_era_tile--teal">
                                    <table>
                                        <tr>
                                            <td class="o_era_tile__lbl">الكمية المسلمة / Total Delivered</td>
                                            <td class="o_era_tile__val" t-out="H.qty(sum(move.quantity for move in moves))"/>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="height: 10px"/>

                    <t t-call="era_report_designs.era_notes_box">
                        <div>تم تسليم الأصناف المذكورة أعلاه بالكميات والحالة الموضحة. يقر المستلم باستلامها كاملة وسليمة ما لم يذكر خلاف ذلك.</div>
                        <div t-if="doc.note" t-field="doc.note"/>
                    </t>

                </t>
            </t>
        </xpath>
    </template>

</odoo>
