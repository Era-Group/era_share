<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The body of Odoo's own sale order document is swapped for the Era
        design instead of registering a new report: the standard Print menu
        keeps a single entry, mail templates and the portal follow along, and
        uninstalling the module restores Odoo's layout as it was.
    -->
    <template id="era_sale_order_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t>
                <!-- read every value in en_US so figures and dates stay latin -->
                <t t-set="doc" t-value="doc.with_context(lang='en_US')"/>
                <t t-set="H" t-value="env['era.report.helper']"/>
                <t t-set="partner" t-value="doc.partner_id"/>
                <t t-set="cmp" t-value="doc.company_id.sudo().with_context(lang='en_US')"/>
                <t t-set="cur" t-value="doc.currency_id"/>
                <t t-set="proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
                <t t-set="quotation" t-value="doc.state in ('draft', 'sent')"/>

                <t t-set="era_title_ar" t-value="'فاتورة مبدئية' if proforma else ('عرض سعر' if quotation else 'أمر بيع')"/>
                <t t-set="era_title_en" t-value="'PRO-FORMA INVOICE' if proforma else ('QUOTATION' if quotation else 'SALES ORDER')"/>

                <t t-set="era_meta" t-value="[
                    {'ar': 'رقم أمر البيع' if not quotation else 'رقم عرض السعر', 'en': 'SO No.' if not quotation else 'Quote No.', 'val': doc.name},
                    {'ar': 'التاريخ', 'en': 'Date', 'val': H.doc_date(doc.date_order)},
                    {'ar': 'المرجع', 'en': 'Ref.', 'val': doc.client_order_ref or '-'},
                    {'ar': 'تاريخ التسليم', 'en': 'Delivery', 'val': H.doc_date(doc.commitment_date)},
                    {'ar': 'العملة', 'en': 'Currency', 'val': cur.name},
                ]"/>

                <t t-set="era_parties" t-value="[
                    {
                        'variant': 'indigo',
                        'title_ar': 'العميل',
                        'title_en': 'Customer',
                        'name': partner.name,
                        'rows': [
                            ('العنوان', H.address_line(partner)),
                            ('الهاتف', partner.phone or '-'),
                        ] + ([('الرقم الضريبي', partner.vat)] if partner.vat else []) + [
                            ('التسليم إلى', H.address_line(doc.partner_shipping_id)),
                        ],
                    },
                    {
                        'variant': 'teal',
                        'title_ar': 'البائع',
                        'title_en': 'Seller',
                        'name': cmp.name,
                        'rows': [
                            ('العنوان', H.address_line(cmp.partner_id)),
                            ('السجل التجاري', cmp.company_registry or '-'),
                            ('الرقم الضريبي', cmp.partner_id.vat or '-'),
                            ('جهة الاتصال', doc.user_id.name or '-'),
                            ('الهاتف', cmp.phone or '-'),
                        ],
                    },
                ]"/>

                <t t-set="era_signatures" t-value="[
                    ('إعداد / المبيعات', 'Prepared by — Sales'),
                    ('اعتماد / الإدارة المالية', 'Approved by — Finance'),
                    ('قبول العميل', 'Customer Acceptance'),
                ]"/>

                <t t-call="era_report_designs.era_document_layout">

                    <table class="o_era_table">
                        <colgroup>
                            <col style="width: 4%"/>
                            <col style="width: 24%"/>
                            <col style="width: 8%"/>
                            <col style="width: 7%"/>
                            <col style="width: 11%"/>
                            <col style="width: 14%"/>
                            <col style="width: 8%"/>
                            <col style="width: 11%"/>
                            <col style="width: 13%"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th><span class="o_era_table__hd-ar">م</span><span class="o_era_table__hd-en">SN</span></th>
                                <th><span class="o_era_table__hd-ar">الصنف / الوصف</span><span class="o_era_table__hd-en">Description</span></th>
                                <th><span class="o_era_table__hd-ar">الوحدة</span><span class="o_era_table__hd-en">UoM</span></th>
                                <th><span class="o_era_table__hd-ar">الكمية</span><span class="o_era_table__hd-en">Qty</span></th>
                                <th><span class="o_era_table__hd-ar">سعر الوحدة</span><span class="o_era_table__hd-en">Unit Price</span></th>
                                <th><span class="o_era_table__hd-ar">الإجمالي قبل الضريبة</span><span class="o_era_table__hd-en">Subtotal</span></th>
                                <th><span class="o_era_table__hd-ar">نسبة الضريبة</span><span class="o_era_table__hd-en">VAT %</span></th>
                                <th><span class="o_era_table__hd-ar">قيمة الضريبة</span><span class="o_era_table__hd-en">VAT Amount</span></th>
                                <th><span class="o_era_table__hd-ar">الإجمالي</span><span class="o_era_table__hd-en">Total</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr t-if="line.display_type == 'line_section'" class="o_era_table__section">
                                    <td colspan="9" t-out="line.name"/>
                                </tr>
                                <tr t-elif="line.display_type == 'line_note'" class="o_era_table__note">
                                    <td colspan="9" t-out="line.name"/>
                                </tr>
                                <tr t-elif="not line.display_type">
                                    <!-- sections and notes must not consume a sequence number -->
                                    <td t-out="len([l for l in doc.order_line[:line_index + 1] if not l.display_type])"/>
                                    <td class="o_era_table__desc">
                                        <div class="o_era_table__desc-main" t-out="line.product_id.name"/>
                                        <div class="o_era_table__desc-sub" t-out="line.name"/>
                                    </td>
                                    <td t-out="line.product_uom_id.name"/>
                                    <td t-out="H.qty(line.product_uom_qty)"/>
                                    <td t-out="H.money(line.price_unit, cur)"/>
                                    <td t-out="H.money(line.price_subtotal, cur)"/>
                                    <td t-out="H.qty(sum(tax.amount for tax in line.tax_ids if tax.amount_type == 'percent')) + '%'"/>
                                    <td t-out="H.money(line.price_tax, cur)"/>
                                    <td t-out="H.money(line.price_total, cur)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table class="o_era_foot-block">
                        <tr>
                            <td style="width: 62%">
                                <t t-if="doc.note" t-call="era_report_designs.era_notes_box">
                                    <span t-field="doc.note"/>
                                </t>
                            </td>
                            <td style="width: 38%">
                                <table class="o_era_sum">
                                    <tr>
                                        <td class="o_era_sum__lbl">الإجمالي قبل الضريبة / Subtotal</td>
                                        <td class="o_era_sum__val" t-out="H.money(doc.amount_untaxed, cur)"/>
                                    </tr>
                                    <tr>
                                        <td class="o_era_sum__lbl">ضريبة القيمة المضافة / VAT</td>
                                        <td class="o_era_sum__val" t-out="H.money(doc.amount_tax, cur)"/>
                                    </tr>
                                </table>
                                <div class="o_era_grand">
                                    <table>
                                        <tr>
                                            <td>
                                                <div class="o_era_grand__ar">الإجمالي النهائي</div>
                                                <div class="o_era_grand__en">Grand Total (<t t-out="cur.name"/>)</div>
                                            </td>
                                            <td class="o_era_grand__val" t-out="H.money(doc.amount_total, cur)"/>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                </t>
            </t>
        </xpath>
    </template>

</odoo>
