<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_era_commission_agent" model="ir.sequence">
            <field name="name">Commission Agent</field>
            <field name="code">era.commission.agent</field>
            <field name="prefix">AGT/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_era_commission_settlement" model="ir.sequence">
            <field name="name">Commission Settlement</field>
            <field name="code">era.commission.settlement</field>
            <field name="prefix">COM/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
