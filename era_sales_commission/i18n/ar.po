#. module: era_sales_commission
#: model:ir.model.fields,field_description:era_sales_commission.field_era_commission_plan__agent_count
msgid "# Agents"
msgstr "عدد المندوبين"

#. module: era_sales_commission
#: model:ir.model.fields,field_description:era_sales_commission.field_account_bank_statement_line__era_commission_count
#: model:ir.model.fields,field_description:era_sales_commission.field_account_move__era_commission_count
#: model:ir.model.fields,field_description:era_sales_commission.field_account_payment__era_commission_count
#: model:ir.model.fields,field_description:era_sales_commission.field_sale_order__era_commission_count
msgid "# Commission Lines"
msgstr "عدد سطور العمولة"

#. module: era_sales_commission
#: model:ir.model.fields,field_description:era_sales_commission.field_era_commission_agent__line_count
#: model:ir.model.fields,field_description:era_sales_commission.field_era_commission_settlement__line_count
msgid "# Lines"
msgstr "عدد السطور"

#. module: era_sales_commission
#: model:ir.model.fields,field_description:era_sales_commission.field_era_commission_agent__settlement_count
msgid "# Settlements"
msgstr "عدد الكشوف"

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_agent_rate.py:0
msgid ""
"%(agent)s already has a rate for this commission type. Edit it instead of "
"adding a second one."
msgstr "لدى %(agent)s نسبة مسجّلة لهذا النوع من العمولة. عدّلها بدل إضافة سجل ثانٍ."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_target.py:0
msgid ""
"%(agent)s already has a target of this kind over an overlapping period. One "
"period has to name one target."
msgstr "لدى %(agent)s مستهدف من هذا النوع على فترة متداخلة. الفترة الواحدة لا تحتمل أكثر من مستهدف واحد."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid ""
"%(agent)s has no payment partner, so no vendor bill can be issued to them."
msgstr "لا توجد جهة صرف على %(agent)s، فلا يمكن إصدار فاتورة مورّد باسمه."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_agent.py:0
msgid ""
"%(agent)s is already on %(plan)s over an overlapping period. Close the first"
" assignment before opening a second one, otherwise the same sale would be "
"paid twice."
msgstr ""
"%(agent)s مُسند بالفعل إلى %(plan)s في فترة متداخلة. أغلق الإسناد الأول قبل فتح ثانٍ، وإلا صُرفت العمولة على البيع نفسه مرتين."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid ""
"%(agent)s is not linked to an employee, so there is no payslip to push "
"%(name)s onto. Set the employee on the agent first."
msgstr "المندوب %(agent)s غير مرتبط بموظف، فلا توجد قسيمة راتب يُرحَّل إليها %(name)s. اربط المندوب بموظف أولاً."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_line.py:0
msgid ""
"%(count)s commission line(s) are already on a settlement. Cancel the "
"settlement before deleting them."
msgstr "%(count)s من سطور العمولة مرتبطة بكشف. ألغِ الكشف قبل حذفها."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid ""
"%(employee)s has no draft payslip covering %(from)s to %(to)s. Create the "
"payslip first, then push."
msgstr "لا توجد قسيمة راتب بحالة مسودّة للموظف %(employee)s تغطّي الفترة من %(from)s إلى %(to)s. أنشئ القسيمة أولاً ثم رحّل."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_plan.py:0
msgid ""
"%(name)s already produced commission lines that were confirmed or settled. "
"Close it and open a new plan instead of rewriting how it computes: a paid "
"statement has to stay reproducible."
msgstr ""
"%(name)s أنتجت بالفعل سطور عمولة مؤكدة أو مصروفة. أغلقها وافتح خطة جديدة بدل تعديل طريقة احتسابها: الكشف المدفوع يجب أن يبقى قابلًا لإعادة الإنتاج."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_line.py:0
msgid ""
"%(name)s belongs to settlement %(settlement)s and cannot be changed. Cancel "
"the settlement first."
msgstr ""
"%(name)s يتبع الكشف %(settlement)s ولا يمكن تعديله. ألغِ الكشف أولًا."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s cannot go back to draft from %(state)s."
msgstr "لا يمكن إعادة %(name)s إلى مسودة من حالة %(state)s."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_rule.py:0
msgid "%(name)s computes on tiers but has none."
msgstr "%(name)s يحتسب بالشرائح لكنه لا يحتوي أي شريحة."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_agent.py:0
#: code:addons/era_sales_commission/models/commission_plan.py:0
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s ends before it starts."
msgstr "%(name)s ينتهي قبل أن يبدأ."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has been paid and cannot be cancelled."
msgstr "%(name)s صُرف بالفعل ولا يمكن إلغاؤه."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid ""
"%(name)s has been pushed to payslip %(slip)s. Remove the commission input "
"from the payslip before cancelling it, otherwise the agent is paid for a "
"statement that no longer exists."
msgstr "تم ترحيل %(name)s إلى قسيمة الراتب %(slip)s. احذف إدخال العمولة من القسيمة قبل الإلغاء، وإلا صُرف للمندوب كشف لم يعد قائماً."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_plan.py:0
msgid ""
"%(name)s has neither a rule nor an agent carrying a rate for %(type)s, so it"
" would compute nothing. Either write a rule on the plan, or set the rate on "
"the agents assigned to it."
msgstr "لا تحمل %(name)s أي قاعدة، ولا يحمل أي من مناديبها نسبة لنوع %(type)s، فلن تحتسب شيئاً. إمّا أن تكتب قاعدة على الخطة، وإمّا أن تضبط النسبة على المناديب المسنَدين إليها."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has not been posted yet."
msgstr "%(name)s لم يُرحَّل بعد."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has nothing to approve."
msgstr "%(name)s لا يحتوي ما يُعتمد."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has nothing to pay. Compute it first."
msgstr "%(name)s لا يحتوي أي مبلغ للصرف. احتسبه أولًا."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_plan.py:0
msgid "%(name)s has settled commission lines and cannot go back to draft."
msgstr "%(name)s له سطور عمولة مصروفة ولا يمكن إعادته إلى مسودة."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has to be approved before it goes to payroll."
msgstr "يجب اعتماد %(name)s قبل ترحيلها إلى الرواتب."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has to be approved before it is posted."
msgstr "يجب اعتماد %(name)s قبل ترحيله."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s has to be posted before it is marked as paid."
msgstr "يجب ترحيل %(name)s قبل تعليمه كمدفوع."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s is %(state)s and can no longer be recomputed."
msgstr "%(name)s في حالة %(state)s ولا يمكن إعادة احتسابه."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid ""
"%(name)s is %(state)s. Cancel it first: deleting it would leave its "
"commission lines settled and unpayable."
msgstr ""
"%(name)s في حالة %(state)s. ألغِه أولًا: حذفه يترك سطور عمولته مصروفة وغير قابلة للصرف."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s is already approved."
msgstr "%(name)s معتمد بالفعل."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s is already posted as %(move)s."
msgstr "%(name)s مُرحَّل بالفعل بالقيد %(move)s."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s totals zero, so there is nothing to post."
msgstr "إجمالي %(name)s صفر، فلا يوجد ما يُرحَّل."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_settlement.py:0
msgid "%(name)s was already pushed to payslip %(slip)s."
msgstr "سبق ترحيل %(name)s إلى قسيمة الراتب %(slip)s."

#. module: era_sales_commission
#. odoo-python
#: code:addons/era_sales_commission/models/commission_engine.py:0
msgid "%(product)s - %(start)s to %(end)s"
msgstr "%(product)s - من %(start)s إلى %(end)s"

