<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_era_commission" model="ir.ui.view">
        <field name="name">account.payment.form.era.commission</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_era_commission" type="object"
                        class="oe_stat_button" icon="fa-percent"
                        groups="era_sales_commission.group_era_commission_officer"
                        invisible="era_commission_count == 0">
                    <field name="era_commission_count" widget="statinfo"
                           string="Commission"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group1']" position="inside">
                <field name="era_agent_id"
                       invisible="partner_type != 'customer'"
                       groups="era_sales_commission.group_era_commission_officer"/>
            </xpath>
        </field>
    </record>

</odoo>
