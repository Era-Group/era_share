<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="era_commission_simulate_view_form" model="ir.ui.view">
        <field name="name">era.commission.simulate.form</field>
        <field name="model">era.commission.simulate</field>
        <field name="arch" type="xml">
            <form string="Simulate Commission">
                <div class="alert alert-info" role="alert">
                    Runs the real computation engine without writing anything. Manager
                    overrides, target factors, bonuses and deductions are not included:
                    this is what the rules alone would pay.
                </div>
                <group>
                    <group>
                        <field name="agent_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="simulated" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="plan_ids" widget="many2many_tags"
                               placeholder="Every plan of the agent"/>
                    </group>
                </group>
                <field name="result_ids" readonly="1" invisible="not simulated">
                    <list string="Result" create="0" edit="0">
                        <field name="date"/>
                        <field name="name"/>
                        <field name="commission_type" optional="show"/>
                        <field name="partner_id" optional="show"/>
                        <field name="product_id" optional="show"/>
                        <field name="rule_id" optional="hide"/>
                        <field name="quantity" optional="show"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="base_amount" sum="Base"/>
                        <field name="rate"/>
                        <field name="unit_price" optional="hide"/>
                        <field name="commission_amount" sum="Commission"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right" invisible="not simulated">
                    <field name="base_total"/>
                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                </group>
                <footer>
                    <button name="action_simulate" type="object" string="Simulate"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="era_commission_simulate_action" model="ir.actions.act_window">
        <field name="name">Simulate Commission</field>
        <field name="res_model">era.commission.simulate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
