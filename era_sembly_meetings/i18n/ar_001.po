#. module: era_sembly_meetings
#: code:addons/era_sembly_meetings/models/res_config_settings.py:0
msgid ""
"Reachable. Tools: %s.\n"
"No token configured yet, so no meeting data can be pulled."
msgstr ""
"الخادم متاح. الأدوات: %s.\n"
"لم يتم ضبط رمز بعد، لذا لا يمكن سحب بيانات الاجتماعات."

#. module: era_sembly_meetings
#: code:addons/era_sembly_meetings/models/res_config_settings.py:0
msgid ""
"Connected. Tools: %s.\n"
"Token %s accepted; %s recent meeting(s) visible."
msgstr ""
"تم الاتصال. الأدوات: %s.\n"
"تم قبول الرمز %s؛ عدد الاجتماعات الحديثة الظاهرة: %s."

#. module: era_sembly_meetings
#: code:addons/era_sembly_meetings/wizard/sembly_import_wizard.py:0
