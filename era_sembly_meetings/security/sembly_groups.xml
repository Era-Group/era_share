<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19 moved the group→category link behind res.groups.privilege;
         res.groups itself no longer has category_id. -->
    <record id="module_category_sembly" model="ir.module.category">
        <field name="name">Sembly Meetings</field>
        <field name="description">Access to imported Sembly.ai meetings.</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_sembly" model="res.groups.privilege">
        <field name="name">Sembly Meetings</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="era_sembly_meetings.module_category_sembly"/>
    </record>

    <!-- Two groups, differing along BOTH axes:

                          | Employee              | Manager
           Which records  | reads every meeting   | reads every meeting
           Link fields    | may set them          | may set them
           Content        | read only             | may edit
           Create/delete  | no                    | yes
           Settings, sync | no                    | yes

         "Content" is everything the meeting factually IS: its title, times,
         participants, summary, transcript and items. The three restrictions
         are enforced in three different places, all server side. Create and
         delete by ir.model.access.csv, the record scope by the record rule,
         and the per-field content lock by
         sembly.meeting._check_content_access. -->

    <record id="group_sembly_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="era_sembly_meetings.res_groups_privilege_sembly"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads every meeting and files it against the right
            opportunity, task or ticket. Cannot edit what the meeting says, and
            cannot create or delete one.</field>
    </record>

    <record id="group_sembly_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="era_sembly_meetings.res_groups_privilege_sembly"/>
        <field name="implied_ids" eval="[(4, ref('era_sembly_meetings.group_sembly_user'))]"/>
        <field name="comment">Everything an employee can do, plus editing and
            deleting meetings, configuring the connection, running imports and
            reading the sync log.</field>
    </record>

    <!-- A separate capability, not a rank: "may publish a meeting recording to
         anyone with the link". It lives in the BASE because the base owns the
         permission model, and because the modules that know which app-manager
         should hold it are the satellites — the base still names no external
         group. Each satellite grants it to its own manager:
           _crm     -> sales_team.group_sale_manager
           _tasks   -> project.group_project_manager
           _tickets -> helpdesk.group_helpdesk_manager
         Doing it the other way round is impossible: those groups do not exist
         on a database without their app, and a view referring to a missing
         group fails at install. -->
    <record id="group_sembly_share" model="res.groups">
        <field name="name">Share meeting recordings publicly</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="era_sembly_meetings.res_groups_privilege_sembly"/>
        <field name="comment">Can create and revoke an "anyone with the link"
            share on a meeting recording. Deliberately NOT implied by the
            Sembly Employee group: the link opens the recording to whoever
            holds it, with no sign-in.</field>
    </record>

    <record id="group_sembly_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('era_sembly_meetings.group_sembly_share'))]"/>
    </record>

    <!-- Every internal user gets the base Sembly access; managers are granted
         deliberately, since that group also unlocks the token settings. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('era_sembly_meetings.group_sembly_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('era_sembly_meetings.group_sembly_manager'))]"/>
    </record>

</odoo>
