<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Requirement 5 — meetings count + navigation on the opportunity. -->
    <record id="view_crm_lead_form_sembly" model="ir.ui.view">
        <field name="name">crm.lead.form.sembly</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sembly_meetings" type="object"
                        class="oe_stat_button" icon="fa-video-camera"
                        groups="era_sembly_meetings.group_sembly_user"
                        invisible="sembly_meeting_count == 0">
                    <field name="sembly_meeting_count" widget="statinfo"
                           string="اجتماعات"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
