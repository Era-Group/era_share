<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Every xpath below targets an ANCHOR the base app declares on purpose,
         never an element a sibling link module contributes. -->

    <record id="view_sembly_meeting_form_tasks" model="ir.ui.view">
        <field name="name">sembly.meeting.form.tasks</field>
        <field name="model">sembly.meeting</field>
        <field name="inherit_id" ref="era_sembly_meetings.view_sembly_meeting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sembly_link_fields']" position="inside">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="task_id" options="{'no_create': True}"
                       domain="project_id and [('project_id', '=', project_id)] or []"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_linked_project" type="object"
                        class="oe_stat_button" icon="fa-folder-open"
                        invisible="not project_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">المشروع</span>
                    </div>
                </button>
                <button name="action_open_linked_task" type="object"
                        class="oe_stat_button" icon="fa-tasks"
                        invisible="not task_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">التاسك</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_sembly_meeting_list_tasks" model="ir.ui.view">
        <field name="name">sembly.meeting.list.tasks</field>
        <field name="model">sembly.meeting</field>
        <field name="inherit_id" ref="era_sembly_meetings.view_sembly_meeting_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='has_summary']" position="before">
                <field name="project_id" optional="show" options="{'no_create': True}"/>
                <field name="task_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_sembly_meeting_kanban_tasks" model="ir.ui.view">
        <field name="name">sembly.meeting.kanban.tasks</field>
        <field name="model">sembly.meeting</field>
        <field name="inherit_id" ref="era_sembly_meetings.view_sembly_meeting_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='sembly_kanban_links']" position="inside">
                <div t-if="record.task_id.raw_value">
                    <i class="fa fa-tasks me-1" title="التاسك"/><field name="task_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_sembly_meeting_search_tasks" model="ir.ui.view">
        <field name="name">sembly.meeting.search.tasks</field>
        <field name="model">sembly.meeting</field>
        <field name="inherit_id" ref="era_sembly_meetings.view_sembly_meeting_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sembly_meeting_id']" position="before">
                <field name="project_id"/>
                <field name="task_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_source']" position="before">
                <filter name="group_project" string="المشروع"
                        context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
