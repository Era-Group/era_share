<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    "AI: Fill / Rewrite SEO" actions bound to website.page (always present
    since era_seo_manager is a dependency). They appear in the list/form
    "Action" cog menu and call the era.seo.mixin methods, which fill the
    recommended meta fields on the selected record(s).

    Bindings for the optional blog models (blog.post, era.blog.series /
    category / author) are created in the post_init_hook only when
    era_seo_blog is installed — era_seo_ai does not depend on era_seo_blog,
    so we can't reference those models in static data.

    noupdate="1": keep admin tweaks to these actions across upgrades.
  -->
  <data noupdate="1">
    <record id="action_ai_fill_seo_page" model="ir.actions.server">
      <field name="name">AI: Fill Missing SEO</field>
      <field name="model_id" ref="website.model_website_page"/>
      <field name="binding_model_id" ref="website.model_website_page"/>
      <field name="binding_view_types">list,form</field>
      <field name="state">code</field>
      <field name="code">
if records:
    action = records.action_ai_fill_seo()
      </field>
    </record>

    <record id="action_ai_rewrite_seo_page" model="ir.actions.server">
      <field name="name">AI: Rewrite All SEO</field>
      <field name="model_id" ref="website.model_website_page"/>
      <field name="binding_model_id" ref="website.model_website_page"/>
      <field name="binding_view_types">list,form</field>
      <field name="state">code</field>
      <field name="code">
if records:
    action = records.action_ai_rewrite_seo()
      </field>
    </record>
  </data>
</odoo>
