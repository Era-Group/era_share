<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_res_config_settings_era_seo_ai" model="ir.ui.view">
    <field name="name">res.config.settings.era.seo.ai</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='website_info_settings']" position="after">
        <block title="ERA SEO — AI Auto-Fix" id="era_seo_ai_settings"
               help="Use Odoo's AI agent to Suggest / Apply fixes on SEO audit findings.">
          <setting id="era_seo_ai_enabled" string="Enable AI Auto-Fix"
                   help="Master switch. When off, all AI buttons hide and no AI calls happen.">
            <field name="era_seo_ai_enabled"/>
          </setting>
          <setting id="era_seo_ai_agent_id" string="AI Agent"
                   invisible="not era_seo_ai_enabled">
            <field name="era_seo_ai_agent_id"
                   options="{'no_create': True}"/>
            <div class="text-muted small mt-2">
              The agent carries the provider, model, and API key — all configured
              in the <b>AI</b> app. Leave empty to fall back to the site's
              "Ask AI" agent. The SEO house-style rules are sent with every
              request, so a generic agent works fine.
            </div>
            <div class="mt-2">
              <button name="action_test_ai_agent" type="object"
                      string="Test Agent" class="btn btn-secondary btn-sm"/>
            </div>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
