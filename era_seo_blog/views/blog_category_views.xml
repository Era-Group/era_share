<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_era_blog_category_list" model="ir.ui.view">
    <field name="name">era.blog.category.list</field>
    <field name="model">era.blog.category</field>
    <field name="arch" type="xml">
      <list string="Categories" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="slug"/>
        <field name="parent_id" optional="show"/>
        <field name="post_count" string="Posts"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_era_blog_category_form" model="ir.ui.view">
    <field name="name">era.blog.category.form</field>
    <field name="model">era.blog.category</field>
    <field name="arch" type="xml">
      <form string="Category">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="Category name"/></h1>
            <field name="slug" placeholder="category-slug"/>
          </div>
          <group>
            <group>
              <field name="parent_id" options="{'no_create': True}"/>
              <field name="sequence"/>
              <field name="color" widget="color_picker"/>
              <field name="active"/>
            </group>
            <group>
              <field name="post_count" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Description" name="description">
              <field name="description"/>
            </page>
            <page string="Posts" name="posts">
              <field name="post_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="published_date"/>
                  <field name="is_published"/>
                </list>
              </field>
            </page>
            <page string="Children" name="children">
              <field name="child_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="post_count"/>
                </list>
              </field>
            </page>
            <page string="SEO" name="seo">
              <group>
                <field name="seo_title"/>
                <field name="seo_description"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_era_blog_category" model="ir.actions.act_window">
    <field name="name">Blog Categories</field>
    <field name="res_model">era.blog.category</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_era_blog_categories"
            name="Categories"
            parent="menu_era_blog_root"
            action="action_era_blog_category"
            sequence="10"/>
</odoo>
