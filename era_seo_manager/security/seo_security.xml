<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <record id="module_era_seo_manager" model="ir.module.category">
      <field name="name">ERA SEO Manager</field>
      <field name="description">Manage SEO configuration for ERA websites.</field>
      <field name="sequence">100</field>
    </record>

    <!--
      group_era_seo_user — read SEO fields, no create/edit.
    -->
    <record id="group_era_seo_user" model="res.groups">
      <field name="name">SEO User</field>
      <field name="category_id" ref="module_era_seo_manager"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--
      group_era_seo_manager — full CRUD on all SEO models.
      Implies SEO User and Website Designer so the manager can also use the
      website builder to verify their changes.
    -->
    <record id="group_era_seo_manager" model="res.groups">
      <field name="name">SEO Manager</field>
      <field name="category_id" ref="module_era_seo_manager"/>
      <field name="implied_ids" eval="[
          (4, ref('era_seo_manager.group_era_seo_user')),
          (4, ref('website.group_website_designer')),
      ]"/>
    </record>

  </data>
</odoo>
