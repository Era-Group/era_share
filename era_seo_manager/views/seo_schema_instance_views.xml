<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ====================================================================
       era.seo.schema.instance — inline views for use on the page form
       Per SPEC §8.5
  ==================================================================== -->

  <!-- Inline list view used inside the website.page Schemas tab -->
  <record id="view_seo_schema_instance_list" model="ir.ui.view">
    <field name="name">era.seo.schema.instance.list</field>
    <field name="model">era.seo.schema.instance</field>
    <field name="arch" type="xml">
      <list string="Schema Instances" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="template_id"/>
        <field name="active" optional="show"/>
        <field name="name" optional="show"/>
      </list>
    </field>
  </record>

  <!-- Form view for editing an individual instance -->
  <record id="view_seo_schema_instance_form" model="ir.ui.view">
    <field name="name">era.seo.schema.instance.form</field>
    <field name="model">era.seo.schema.instance</field>
    <field name="arch" type="xml">
      <form string="Schema Instance">
        <sheet>
          <group>
            <group string="Configuration">
              <field name="template_id"/>
              <field name="sequence"/>
              <field name="active"/>
              <field name="res_model" readonly="1"/>
              <field name="res_id" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Context Overrides" name="data_json">
              <field name="data_json"
                     widget="ace"
                     options="{'mode': 'json'}"
                     style="min-height:200px;font-family:monospace;"
                     nolabel="1"/>
              <div class="text-muted small mt-2">
                Optional JSON object.  Keys here override the global rendering
                context for this instance only.  Example:
                <code>{"startDate": "2026-01-01"}</code>
              </div>
            </page>
            <page string="Rendered Preview" name="rendered_json">
              <field name="rendered_json"
                     readonly="1"
                     widget="ace"
                     options="{'mode': 'json', 'readOnly': true}"
                     style="min-height:200px;font-family:monospace;"
                     nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
