<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ====================================================================
       era.seo.schema.template — tree, search, and form views
       Per SPEC §8.5
  ==================================================================== -->

  <!-- Tree view grouped by category -->
  <record id="view_seo_schema_template_tree" model="ir.ui.view">
    <field name="name">era.seo.schema.template.tree</field>
    <field name="model">era.seo.schema.template</field>
    <field name="arch" type="xml">
      <list string="Schema Templates" default_group_by="category">
        <field name="name"/>
        <field name="code"/>
        <field name="schema_type"/>
        <field name="category"/>
        <field name="active" optional="show"/>
        <field name="is_default" optional="show"/>
      </list>
    </field>
  </record>

  <!-- Search view -->
  <record id="view_seo_schema_template_search" model="ir.ui.view">
    <field name="name">era.seo.schema.template.search</field>
    <field name="model">era.seo.schema.template</field>
    <field name="arch" type="xml">
      <search string="Search Templates">
        <field name="name"/>
        <field name="code"/>
        <field name="schema_type"/>
        <filter string="Core" name="cat_core" domain="[('category','=','core')]"/>
        <filter string="Content" name="cat_content" domain="[('category','=','content')]"/>
        <filter string="Commerce" name="cat_commerce" domain="[('category','=','commerce')]"/>
        <filter string="Event" name="cat_event" domain="[('category','=','event')]"/>
        <filter string="Local" name="cat_local" domain="[('category','=','local')]"/>
        <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
        <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
      </search>
    </field>
  </record>

  <!-- Form view with Ace JSON editor and Preview button -->
  <record id="view_seo_schema_template_form" model="ir.ui.view">
    <field name="name">era.seo.schema.template.form</field>
    <field name="model">era.seo.schema.template</field>
    <field name="arch" type="xml">
      <form string="Schema Template">
        <header>
          <button name="%(era_seo_manager.action_seo_schema_preview_wizard)d"
                  string="Preview"
                  type="action"
                  context="{'default_template_id': id}"
                  class="btn-secondary"
                  help="Render this template against a website page and inspect the output."/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Template name"/></h1>
          </div>
          <group>
            <group string="Identity">
              <field name="code"/>
              <field name="schema_type"/>
              <field name="category"/>
              <field name="active"/>
              <field name="is_default"/>
            </group>
            <group string="Documentation">
              <field name="documentation_url" widget="url"/>
              <field name="description"/>
            </group>
          </group>
          <notebook>
            <page string="Template Body" name="body">
              <field name="body"
                     widget="ace"
                     options="{'mode': 'json'}"
                     style="min-height:400px;font-family:monospace;"
                     nolabel="1"/>
              <div class="text-muted small mt-2">
                Placeholders: <code>{{ dotted.path }}</code>,
                <code>{{ path | json }}</code>,
                <code>{{ path | string }}</code>,
                <code>{{ path | default("value") }}</code>.
                Max 5 path segments.
              </div>
            </page>
            <page string="Required Fields" name="required_fields">
              <field name="required_fields_json"
                     widget="ace"
                     options="{'mode': 'json'}"
                     style="min-height:100px;font-family:monospace;"
                     nolabel="1"/>
              <div class="text-muted small mt-2">
                JSON array of dotted context paths expected at render time.
                Used by the SEO audit to flag missing data.
              </div>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_seo_schema_template" model="ir.actions.act_window">
    <field name="name">Schema Templates</field>
    <field name="res_model">era.seo.schema.template</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_seo_schema_template_search"/>
    <field name="context">{'search_default_group_category': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No schema templates yet.
      </p>
      <p>
        Schema templates are JSON-LD blueprints with
        <code>{{ placeholder }}</code> syntax. Attach instances to any
        page via its <strong>Schemas</strong> tab.
      </p>
    </field>
  </record>
</odoo>
