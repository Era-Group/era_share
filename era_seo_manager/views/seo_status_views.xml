<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ERA SEO Status Overview — form view + window action -->

  <record id="view_seo_status_form" model="ir.ui.view">
    <field name="name">era.seo.status.form</field>
    <field name="model">era.seo.status</field>
    <field name="arch" type="xml">
      <form string="ERA SEO — Module Status Report"
            create="false" edit="false" delete="false">
        <sheet>

          <!-- ── Header ──────────────────────────────────────────────── -->
          <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
              <img src="/era_seo_manager/static/description/icon.png"
                   style="width:48px;height:48px;border-radius:8px;"
                   alt="ERA SEO"/>
              <div>
                <h2 class="mb-0">ERA SEO Manager</h2>
                <span class="text-muted small">
                  v<field name="module_version" readonly="1" nolabel="1" class="d-inline"/>
                  — Status Report
                </span>
              </div>
            </div>
            <button name="action_go_settings"
                    string="Open Settings"
                    type="object"
                    class="btn btn-secondary btn-sm"/>
          </div>

          <!-- ── Setup Checklist ─────────────────────────────────────── -->
          <div class="alert alert-info mb-4" role="alert">
            <h5 class="alert-heading mb-2">Setup Checklist</h5>
            <p class="mb-2 small text-muted">
              Every item below should be ticked before going live. Open
              <strong>Settings → ERA SEO</strong> to fill in missing values.
            </p>
            <table class="table table-sm table-borderless mb-0" style="max-width:600px;">
              <tbody>
                <tr>
                  <td style="width:24px;">
                    <span t-if="record.ok_org_name.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Organization Name</td>
                  <td class="text-muted small">
                    <field name="org_name" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_logo.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Logo URL</td>
                  <td class="text-muted small">
                    <field name="logo_url" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_og_image.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Default OG Image</td>
                  <td class="text-muted small">
                    <field name="og_image_url" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_twitter.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Twitter / X Handle</td>
                  <td class="text-muted small">
                    <field name="twitter_handle" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_google_verification.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Google Search Console Verified</td>
                  <td class="text-muted small">
                    <field name="google_verification" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_bing_verification.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Bing Webmaster Tools Verified</td>
                  <td class="text-muted small">
                    <field name="bing_verification" readonly="1" nolabel="1" class="d-inline"/>
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_schema_engine.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>JSON-LD Schema Engine Enabled</td>
                  <td class="text-muted small"/>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_has_instances.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-danger fw-bold">✘</span>
                  </td>
                  <td>Schema Instances Attached to Pages</td>
                  <td class="text-muted small">
                    <field name="instances_active" readonly="1" nolabel="1" class="d-inline"/> active
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_title_coverage.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-warning fw-bold">!</span>
                  </td>
                  <td>SEO Title Coverage ≥ 80%</td>
                  <td class="text-muted small">
                    <field name="seo_title_pct" readonly="1" nolabel="1" class="d-inline"/>%
                    (<field name="pages_with_seo_title" readonly="1" nolabel="1" class="d-inline"/>
                    of <field name="total_pages" readonly="1" nolabel="1" class="d-inline"/> pages)
                  </td>
                </tr>
                <tr>
                  <td>
                    <span t-if="record.ok_desc_coverage.raw_value" class="text-success fw-bold">✔</span>
                    <span t-else="" class="text-warning fw-bold">!</span>
                  </td>
                  <td>SEO Description Coverage ≥ 80%</td>
                  <td class="text-muted small">
                    <field name="seo_desc_pct" readonly="1" nolabel="1" class="d-inline"/>%
                    (<field name="pages_with_seo_description" readonly="1" nolabel="1" class="d-inline"/>
                    of <field name="total_pages" readonly="1" nolabel="1" class="d-inline"/> pages)
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- ── Social Profiles ─────────────────────────────────────── -->
          <group string="Social Profiles">
            <group>
              <field name="social_profiles_set" readonly="1"
                     string="Configured (out of 5)"/>
              <field name="social_profiles_detail" readonly="1"/>
            </group>
          </group>

          <!-- ── Page SEO Coverage ────────────────────────────────────── -->
          <group string="Page SEO Coverage">
            <group>
              <field name="total_pages" readonly="1"/>
              <field name="published_pages" readonly="1"/>
              <field name="pages_with_seo_title" readonly="1"/>
              <field name="pages_with_seo_description" readonly="1"/>
            </group>
            <group>
              <field name="pages_with_canonical" readonly="1"/>
              <field name="pages_noindex" readonly="1"/>
              <field name="seo_title_pct" readonly="1" string="Title Coverage (%)"/>
              <field name="seo_desc_pct" readonly="1" string="Description Coverage (%)"/>
            </group>
            <div class="col-12 mt-2">
              <button name="action_open_pages"
                      string="Open Pages List"
                      type="object"
                      class="btn btn-secondary btn-sm"/>
            </div>
          </group>

          <!-- ── JSON-LD Schema Engine ─────────────────────────────────── -->
          <group string="JSON-LD Schema Engine">
            <group>
              <field name="schema_engine_enabled" readonly="1"/>
              <field name="templates_total" readonly="1"/>
              <field name="templates_active" readonly="1"/>
            </group>
            <group>
              <field name="instances_total" readonly="1"/>
              <field name="instances_active" readonly="1"/>
            </group>
            <div class="col-12 mt-2 d-flex gap-2">
              <button name="action_open_schema_templates"
                      string="Schema Templates"
                      type="object"
                      class="btn btn-secondary btn-sm"/>
              <button name="action_open_schema_instances"
                      string="Schema Instances"
                      type="object"
                      class="btn btn-secondary btn-sm"/>
            </div>
          </group>

          <!-- ── Redirects &amp; Hreflang ─────────────────────────────── -->
          <group string="Redirects &amp; Hreflang">
            <group>
              <field name="redirects_total" readonly="1"/>
              <field name="redirects_active" readonly="1"/>
            </group>
            <group>
              <field name="hreflang_rules" readonly="1"/>
            </group>
          </group>

        </sheet>
      </form>
    </field>
  </record>

  <record id="action_seo_status" model="ir.actions.act_window">
    <field name="name">SEO Status Report</field>
    <field name="res_model">era.seo.status</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_seo_status_form"/>
    <field name="target">current</field>
  </record>

</odoo>
