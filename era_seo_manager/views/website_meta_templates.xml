<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    era_seo_manager.meta_tags
    =========================
    Standalone template rendered inside <head> when the current page record
    inherits era.seo.mixin. Called via t-call with `seo` set to the dict
    returned by get_seo_meta_dict().

    Per SPEC §7.3.
  -->
  <template id="meta_tags" name="ERA SEO Meta Tags">
    <t t-if="seo">
      <title><t t-esc="seo.get('title') or website.name"/></title>
      <meta name="description" t-att-content="seo.get('description')"/>
      <meta t-if="seo.get('keywords')" name="keywords" t-att-content="seo.get('keywords')"/>
      <meta name="robots" t-att-content="seo.get('robots')"/>
      <link rel="canonical" t-att-href="seo.get('canonical')"/>

      <!-- Open Graph -->
      <meta property="og:title" t-att-content="seo.get('og_title')"/>
      <meta property="og:description" t-att-content="seo.get('og_description')"/>
      <meta property="og:type" t-att-content="seo.get('og_type')"/>
      <meta property="og:url" t-att-content="seo.get('canonical')"/>
      <meta t-if="seo.get('og_image')" property="og:image" t-att-content="seo.get('og_image')"/>
      <meta property="og:site_name" t-att-content="website.name"/>
      <meta property="og:locale" t-att-content="request.lang.code.replace('_', '-')"/>

      <!-- Twitter Card -->
      <meta name="twitter:card" t-att-content="seo.get('twitter_card')"/>
      <meta name="twitter:title" t-att-content="seo.get('og_title')"/>
      <meta name="twitter:description" t-att-content="seo.get('og_description')"/>
      <meta t-if="seo.get('og_image')" name="twitter:image" t-att-content="seo.get('og_image')"/>
      <meta t-if="seo.get('twitter_site')" name="twitter:site" t-att-content="seo.get('twitter_site')"/>
      <meta t-if="seo.get('twitter_creator')" name="twitter:creator" t-att-content="seo.get('twitter_creator')"/>
    </t>
  </template>
</odoo>
