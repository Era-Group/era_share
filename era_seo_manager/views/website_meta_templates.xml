<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    era_seo_manager.meta_tags
    =========================
    Standalone template rendered inside <head> when the current page record
    inherits era.seo.mixin. Called via t-call with `seo` set to the dict
    returned by get_seo_meta_dict().

    Two tags are NOT emitted here even though logically they belong:

      - <meta name="robots">      Step 5 of website_layout_templates.xml
                                  already replaces the stock <meta name="robots">
                                  with the ERA directive when era_seo is active.
                                  Emitting again here would duplicate the tag.

      - <meta property="og:locale">  Step 9 of website_layout_templates.xml
                                     emits it site-wide regardless of ERA mode.

    Per SPEC §7.3.
  -->
  <template id="meta_tags" name="ERA SEO Meta Tags">
    <t t-if="seo">
      <title><t t-esc="seo.get('title') or website.name"/></title>
      <meta name="description" t-att-content="seo.get('description')"/>
      <meta t-if="seo.get('keywords')" name="keywords" t-att-content="seo.get('keywords')"/>
      <link rel="canonical" t-att-href="seo.get('canonical')"/>

      <!-- Open Graph -->
      <meta property="og:title" t-att-content="seo.get('og_title')"/>
      <meta property="og:description" t-att-content="seo.get('og_description')"/>
      <meta property="og:type" t-att-content="seo.get('og_type')"/>
      <meta property="og:url" t-att-content="seo.get('canonical')"/>
      <meta t-if="seo.get('og_image')" property="og:image" t-att-content="seo.get('og_image')"/>
      <meta property="og:site_name" t-att-content="website.name"/>

      <!-- Twitter Card -->
      <meta name="twitter:card" t-att-content="seo.get('twitter_card')"/>
      <meta name="twitter:title" t-att-content="seo.get('og_title')"/>
      <meta name="twitter:description" t-att-content="seo.get('og_description')"/>
      <meta t-if="seo.get('og_image')" name="twitter:image" t-att-content="seo.get('og_image')"/>
      <meta t-if="seo.get('twitter_site')" name="twitter:site" t-att-content="seo.get('twitter_site')"/>
      <meta t-if="seo.get('twitter_creator')" name="twitter:creator" t-att-content="seo.get('twitter_creator')"/>
    </t>
  </template>

  <!--
    era_seo_manager.era_seo_schema_ld
    ==================================
    Emits one <script type="application/ld+json"> per active schema instance
    in sequence order. The preload is delegated to
    ``era.seo.schema.instance._get_for_render(main_object, website)`` so the
    template runs a single ORM call per page (CLAUDE.md §9: no ad-hoc queries
    in QWeb). The model method combines site-wide instances (bound to
    ``website``) and page-specific instances (bound to ``main_object`` when it
    carries ``era.seo.mixin``) and returns them ordered.

    Guard: emits nothing when the schema engine is disabled in settings.

    Per SPEC §8.4.
  -->
  <template id="era_seo_schema_ld" name="ERA JSON-LD Schemas">
    <t t-set="_schema_enabled"
       t-value="request.env['ir.config_parameter'].sudo().get_param('era_seo.schema_engine_enabled', 'True') not in ('False', '0', 'false', '')"/>
    <t t-if="_schema_enabled">
      <t t-set="_all_schemas"
         t-value="request.env['era.seo.schema.instance']._get_for_render(main_object, website)"/>
      <t t-foreach="_all_schemas" t-as="inst">
        <script type="application/ld+json">
          <t t-out="inst.get_rendered_json_ld(main_object or website)"/>
        </script>
      </t>
    </t>
  </template>

  <!--
    Layout injection: inject era_seo_schema_ld into website.layout <head>.
    Priority 25 places this AFTER Phase 1's meta_tags inject (priority 20),
    ensuring meta tags come before JSON-LD in the head.
  -->
  <template id="layout_inherit_era_seo_schema_ld"
            name="ERA JSON-LD Layout Inject"
            inherit_id="website.layout"
            priority="25">
    <xpath expr="//head" position="inside">
      <t t-call="era_seo_manager.era_seo_schema_ld"/>
    </xpath>
  </template>

  <!--
    era_seo_manager.hreflang_links
    ===============================
    Emits one <link rel="alternate" hreflang="…" href="…"/> per active
    ``era.seo.hreflang`` row attached to either ``main_object`` or the
    current ``website``. Rows flagged ``is_xdefault`` render as
    ``hreflang="x-default"``. The full set is fetched in one query via
    ``era.seo.hreflang._get_for_record``.

    Per SPEC §12.3.
  -->
  <template id="hreflang_links" name="ERA Hreflang Links">
    <t t-set="_hreflang_enabled"
       t-value="not request.env['era.seo.hreflang'].sudo()._emit_disabled()"/>
    <t t-if="_hreflang_enabled and main_object and 'seo_title' in main_object._fields">
      <t t-set="_hreflang_entries"
         t-value="request.env['era.seo.hreflang']._get_for_record(main_object)"/>
      <t t-foreach="_hreflang_entries" t-as="hl">
        <link rel="alternate"
              t-att-hreflang="hl.is_xdefault and 'x-default' or hl.lang_id.code.replace('_', '-')"
              t-att-href="hl.url"/>
      </t>
    </t>
  </template>

  <!--
    Layout injection: hreflang links into <head>.
    Priority 30 places this after meta (20) and schema (25), keeping the
    head order: meta → schema → hreflang.
  -->
  <template id="layout_inherit_era_hreflang"
            name="ERA Hreflang Layout Inject"
            inherit_id="website.layout"
            priority="30">
    <xpath expr="//head" position="inside">
      <t t-call="era_seo_manager.hreflang_links"/>
    </xpath>
  </template>
</odoo>
