<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_seo_audit_wizard_form" model="ir.ui.view">
    <field name="name">era.seo.audit.wizard.form</field>
    <field name="model">era.seo.audit.wizard</field>
    <field name="arch" type="xml">
      <form string="Run SEO Audit">
        <sheet>
          <div class="alert alert-info" role="alert">
            <strong>What this checks:</strong>
            22 SEO issues across every page — missing/duplicate titles,
            descriptions, OG images, canonical, multiple H1, missing alt
            text, slug length, missing schema, thin content, orphan pages,
            redirect chains, and more.
          </div>
          <group>
            <field name="website_id"
                   options="{'no_create': True, 'no_open': True}"
                   placeholder="All websites"/>
          </group>
        </sheet>
        <footer>
          <button string="Run Audit" name="action_run" type="object"
                  class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_seo_audit_wizard" model="ir.actions.act_window">
    <field name="name">Run SEO Audit</field>
    <field name="res_model">era.seo.audit.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
