<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">
    <!--
      ir.cron records owned by era_seo_suite.
      noupdate="1": once installed, admins may tweak interval/active without
      being overwritten on -u upgrades.
    -->

    <record id="cron_vacuum_redirect_log" model="ir.cron">
      <field name="name">ERA SEO: vacuum 404 log</field>
      <field name="model_id" ref="model_era_seo_redirect_log"/>
      <field name="state">code</field>
      <field name="code">model._vacuum_old_entries()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

    <record id="cron_seo_audit_nightly" model="ir.cron">
      <field name="name">ERA SEO: nightly audit</field>
      <field name="model_id" ref="model_era_seo_audit_run"/>
      <field name="state">code</field>
      <field name="code">model.run_scheduled_audit()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="False"/>
    </record>

  </data>
</odoo>
