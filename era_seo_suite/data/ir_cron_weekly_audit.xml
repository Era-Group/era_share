<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <!--
      ERA SEO: Weekly audit + AI auto-fix.

      WEEKLY full audit (the heavy re-scan of every page, incl. a rendered-HTML
      fetch), then auto-applies the SAFE fixes (_UNATTENDED_FIX_CODES: OG image,
      JSON-LD schema) for anything newly found. The day-to-day clearing of the
      safe-fix backlog runs separately in the DAILY cron below, so the heavy
      audit does NOT run daily. Pause both without disabling the crons by
      flipping `era_seo.weekly_audit_active` to False.
    -->
    <record id="cron_weekly_audit_and_fix" model="ir.cron">
      <field name="name">ERA SEO: Weekly audit + AI auto-fix</field>
      <field name="model_id" ref="model_era_seo_suite_hub"/>
      <field name="state">code</field>
      <field name="code">model.cron_weekly_audit_and_fix()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">weeks</field>
      <field name="active" eval="True"/>
      <field name="priority">6</field>
    </record>

    <!--
      ERA SEO: Hourly AI auto-fix (no audit).

      HOURLY, applies the SAFE auto-fixes to the backlog of open, untouched
      findings (OG image / JSON-LD schema) WITHOUT running a fresh audit.
      Each tick is bounded by _UNATTENDED_FIX_BATCH (max selected) AND a
      wall-clock budget (_UNATTENDED_FIX_TICK_BUDGET_S), so the frequency is
      safe: once the backlog is cleared a tick is a single no-op search, and
      new findings (only created by the weekly audit) get fixed within the
      hour. The full re-scan stays weekly. Same `era_seo.weekly_audit_active`
      gate. (xmlid/method kept as *_daily_* for back-compat of the cron code.)
    -->
    <record id="cron_daily_ai_fix" model="ir.cron">
      <field name="name">ERA SEO: Hourly AI auto-fix</field>
      <field name="model_id" ref="model_era_seo_suite_hub"/>
      <field name="state">code</field>
      <field name="code">model.cron_daily_ai_fix()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="True"/>
      <field name="priority">7</field>
    </record>

  </data>
</odoo>
