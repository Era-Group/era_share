<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_era_blog_author_list" model="ir.ui.view">
    <field name="name">era.blog.author.list</field>
    <field name="model">era.blog.author</field>
    <field name="arch" type="xml">
      <list string="Authors" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="slug"/>
        <field name="role"/>
        <field name="email" optional="show"/>
        <field name="user_id" optional="hide"/>
        <field name="post_count" string="Posts"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_era_blog_author_form" model="ir.ui.view">
    <field name="name">era.blog.author.form</field>
    <field name="model">era.blog.author</field>
    <field name="arch" type="xml">
      <form string="Author Profile">
        <sheet>
          <field name="avatar" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="Author name"/></h1>
            <field name="slug" placeholder="author-slug"/>
          </div>
          <group>
            <group>
              <field name="role"/>
              <field name="email" widget="email"/>
              <field name="user_id" options="{'no_create': True}"/>
            </group>
            <group string="Social">
              <field name="social_website" widget="url"/>
              <field name="social_twitter" widget="url"/>
              <field name="social_linkedin" widget="url"/>
              <field name="social_github" widget="url"/>
            </group>
            <group>
              <field name="sequence"/>
              <field name="active"/>
            </group>
            <group>
              <field name="post_count" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Bio" name="bio">
              <field name="bio"/>
            </page>
            <page string="Posts" name="posts">
              <field name="post_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="published_date"/>
                  <field name="is_published"/>
                </list>
              </field>
            </page>
            <page string="SEO" name="seo">
              <group>
                <field name="seo_title"/>
                <field name="seo_description"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_era_blog_author" model="ir.actions.act_window">
    <field name="name">Blog Authors</field>
    <field name="res_model">era.blog.author</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_era_blog_authors"
            name="Authors"
            parent="menu_era_blog_root"
            action="action_era_blog_author"
            sequence="30"/>
</odoo>
