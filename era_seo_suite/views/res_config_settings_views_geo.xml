<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_res_config_settings_era_geo" model="ir.ui.view">
    <field name="name">res.config.settings.era.geo</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='website_info_settings']" position="after">
        <block title="ERA GEO — Generative Engine Optimization" id="era_geo_settings"
               help="Optimize how AI answer engines (ChatGPT, Perplexity, Google AI Overviews, Claude) discover and cite your content.">
          <setting id="era_geo_llms_enabled" string="Publish /llms.txt"
                   help="Serve a Markdown site map for AI engines at /llms.txt (llmstxt.org).">
            <field name="era_geo_llms_enabled"/>
            <div class="content-group mt-2" invisible="not era_geo_llms_enabled">
              <div class="row">
                <label for="era_geo_site_summary" class="col-lg-4 o_light_label"/>
                <field name="era_geo_site_summary" placeholder="e.g. ERA — SEO &amp; GEO for the Saudi market"/>
              </div>
              <div class="row">
                <label for="era_geo_llms_max_items" class="col-lg-4 o_light_label"/>
                <field name="era_geo_llms_max_items"/>
              </div>
              <div class="row">
                <label for="era_geo_llms_include_blog" class="col-lg-4 o_light_label"/>
                <field name="era_geo_llms_include_blog"/>
              </div>
              <div class="mt-2">
                <a href="/llms.txt" target="_blank" role="button" class="btn btn-secondary btn-sm">Open /llms.txt</a>
              </div>
            </div>
          </setting>
          <setting id="era_geo_crawlers" string="AI Crawlers"
                   help="Allow or block each AI crawler in robots.txt.">
            <button name="%(action_era_geo_ai_crawler)d" type="action"
                    string="Manage AI Crawlers" class="btn btn-link"
                    icon="fa-arrow-right"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
