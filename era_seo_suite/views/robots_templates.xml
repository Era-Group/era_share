<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Append the AI-crawler directives to the native robots.txt. era.geo.ai.crawler
    ._robots_block() returns one "User-agent / Allow|Disallow" stanza per active
    crawler. Rendered via sudo so it works for the public robots.txt request.
  -->
  <template id="robots_ai_crawlers" inherit_id="website.robots" name="ERA GEO — AI crawlers in robots.txt">
    <xpath expr="//t[@t-translation='off']" position="inside">
      <t t-out="request.env['era.geo.ai.crawler'].sudo()._robots_block()"/>
    </xpath>
  </template>
</odoo>
