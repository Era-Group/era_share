<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Pages (SEO + Schemas) — own list view + action.

    Defined here ABOVE the hub form because the Dashboard quick-links
    bar at the top of the form references `era_seo_suite.action_era_seo_pages`
    via `%(…)d`, and that expansion requires the action's database id
    to exist by the time the form view is processed. The menuitem
    in menus_mgr.xml references the same xmlid by name and resolves
    at menu-load time.

    Why a custom list view: Odoo 19's stock website.page list is
        <list js_class="website_pages_list"
              type="object" action="open_website_url" …>
    which routes row-click to the public URL. That blocks SEO admins
    from reaching the backend form (where our SEO + Schemas tabs live).
    The minimal view below has no js_class / type / action, so
    row-click falls back to the default "open form" behavior.
  -->
  <record id="view_era_seo_website_page_list" model="ir.ui.view">
    <field name="name">era.seo.website.page.list</field>
    <field name="model">website.page</field>
    <field name="arch" type="xml">
      <list string="Pages (SEO + Schemas)" default_order="url asc">
        <field name="name"/>
        <field name="url"/>
        <field name="website_id" groups="website.group_multi_website"/>
        <field name="is_published"/>
        <field name="website_indexed"/>
      </list>
    </field>
  </record>

  <record id="action_era_seo_pages" model="ir.actions.act_window">
    <field name="name">Pages (SEO + Schemas)</field>
    <field name="res_model">website.page</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_era_seo_website_page_list')}),
    ]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No pages yet. Create one from the Website app, then come back here
        to attach schema templates or tune SEO meta.
      </p>
    </field>
  </record>

  <record id="view_era_seo_suite_hub_form" model="ir.ui.view">
    <field name="name">era.seo.suite.hub.form</field>
    <field name="model">era.seo.suite.hub</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" duplicate="0" js_class="form">
        <header>
          <button name="action_run_audit_now" type="object"
                  string="Run Audit Now" icon="fa-play-circle"
                  class="btn-primary"
                  confirm="Run a fresh SEO + GEO audit now? This scans every published page and may take a few seconds."/>
          <button name="%(era_seo_suite.action_era_seo_onboarding_wizard)d"
                  type="action"
                  string="Setup Wizard" icon="fa-magic"
                  class="btn-secondary"/>
          <button name="action_refresh" type="object"
                  string="Refresh" icon="fa-refresh" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1 class="mb-0">ERA SEO Suite</h1>
            <div class="text-muted">SEO · GEO · GSC — one screen, one click away.</div>
          </div>

          <notebook>

            <!-- ============================ DASHBOARD ============================ -->
            <page string="Dashboard" name="dashboard">
              <!-- Quick links — shortcuts to the surfaces the admin reaches
                   most often, so the dashboard is the only screen they need
                   open during day-to-day SEO work. -->
              <div class="d-flex flex-wrap gap-2 mb-3">
                <button name="%(era_seo_suite.action_era_seo_pages)d"
                        type="action"
                        string="Pages (SEO + Schemas)"
                        class="btn btn-primary"
                        icon="fa-file-text-o"/>
                <button name="%(era_seo_suite.action_seo_audit_run)d"
                        type="action"
                        string="Audit Runs"
                        class="btn btn-secondary"
                        icon="fa-search"/>
                <button name="%(era_seo_suite.action_seo_audit_finding)d"
                        type="action"
                        string="Findings"
                        class="btn btn-secondary"
                        icon="fa-flag"/>
                <button name="%(era_seo_suite.action_seo_schema_template)d"
                        type="action"
                        string="Schema Templates"
                        class="btn btn-secondary"
                        icon="fa-code"/>
              </div>

              <group string="SEO" name="dash_seo">
                <group>
                  <field name="kpi_published_pages"/>
                  <field name="kpi_active_redirects"/>
                  <field name="kpi_schema_instances"/>
                </group>
                <group>
                  <field name="kpi_audit_last_date"/>
                  <field name="kpi_audit_open_findings"/>
                  <field name="kpi_audit_critical"/>
                </group>
              </group>
              <group string="GEO" name="dash_geo">
                <group>
                  <field name="kpi_geo_llms_enabled" widget="boolean_toggle" readonly="1"/>
                  <field name="kpi_geo_crawlers_total"/>
                  <field name="kpi_geo_crawlers_blocked"/>
                </group>
              </group>
              <group string="GSC" name="dash_gsc">
                <group>
                  <field name="kpi_gsc_accounts_connected"/>
                  <field name="kpi_gsc_sites"/>
                  <field name="kpi_gsc_last_pull"/>
                </group>
                <group>
                  <field name="kpi_gsc_clicks_28d"/>
                  <field name="kpi_gsc_impressions_28d"/>
                </group>
              </group>
            </page>

            <!-- ============================== SEO =============================== -->
            <page string="SEO" name="seo">
              <div class="alert alert-light mb-3" role="status">
                Manage every SEO surface from here. Buttons open the existing
                lists; closing them returns you to this hub.
              </div>
              <group>
                <group string="Pages &amp; Schema">
                  <button name="%(era_seo_suite.action_seo_schema_template)d"
                          type="action" string="Schema Templates"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_era_content_block)d"
                          type="action" string="Content Blocks"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_seo_status)d"
                          type="action" string="SEO Overview"
                          class="btn-link" icon="fa-arrow-right"/>
                </group>
                <group string="Routing">
                  <button name="%(era_seo_suite.action_seo_redirect)d"
                          type="action" string="Redirects"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_seo_redirect_log)d"
                          type="action" string="404 Log"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_seo_hreflang)d"
                          type="action" string="Hreflang"
                          class="btn-link" icon="fa-arrow-right"/>
                </group>
                <group string="Audit">
                  <button name="%(era_seo_suite.action_seo_audit_run)d"
                          type="action" string="Audit Runs"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_seo_audit_finding)d"
                          type="action" string="All Findings"
                          class="btn-link" icon="fa-arrow-right"/>
                </group>
              </group>
            </page>

            <!-- ============================== GEO =============================== -->
            <page string="GEO" name="geo">
              <div class="alert alert-light mb-3" role="status">
                Generative Engine Optimization — discoverability and citation by
                AI answer engines.
              </div>
              <group>
                <group string="Status">
                  <field name="kpi_geo_llms_enabled" widget="boolean_toggle" readonly="1"/>
                  <field name="kpi_geo_crawlers_total"/>
                  <field name="kpi_geo_crawlers_blocked"/>
                </group>
                <group string="Quick links">
                  <button name="%(era_seo_suite.action_era_geo_ai_crawler)d"
                          type="action" string="Manage AI Crawlers"
                          class="btn-link" icon="fa-arrow-right"/>
                </group>
              </group>
              <div class="mt-2 small text-muted">
                Open <code>/llms.txt</code> on your domain to verify the live
                output: <code>https://&lt;your-domain&gt;/llms.txt</code>
              </div>
            </page>

            <!-- ============================== GSC =============================== -->
            <page string="GSC" name="gsc">
              <div class="alert alert-light mb-3" role="status">
                Google Search Console connector — pull search performance into
                Odoo.
              </div>
              <group>
                <group string="Status">
                  <field name="kpi_gsc_accounts_connected"/>
                  <field name="kpi_gsc_sites"/>
                  <field name="kpi_gsc_last_pull"/>
                  <field name="kpi_gsc_clicks_28d"/>
                  <field name="kpi_gsc_impressions_28d"/>
                </group>
                <group string="Quick links">
                  <button name="%(era_seo_suite.action_era_gsc_account)d"
                          type="action" string="Accounts"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_era_gsc_site)d"
                          type="action" string="Sites"
                          class="btn-link" icon="fa-arrow-right"/>
                  <button name="%(era_seo_suite.action_era_gsc_query)d"
                          type="action" string="Queries"
                          class="btn-link" icon="fa-arrow-right"/>
                </group>
              </group>
            </page>

            <!-- ============================ BLOG GENERATION =================== -->
            <page string="Blog Gen" name="blog_gen">
              <div class="alert alert-light mb-3" role="status">
                Trend-aware auto-publisher. Runs every 3 days when enabled —
                pulls today's Google Trends for the configured geo, asks the
                AI to write a full article on the most relevant one, publishes
                it, and emails the SEO Manager group.
              </div>

              <group>
                <group string="Auto-publish settings">
                  <field name="setting_article_generator_active"
                         widget="boolean_toggle"/>
                  <field name="setting_article_interval_days"
                         invisible="not setting_article_generator_active"/>
                  <field name="setting_trends_geo"
                         placeholder="US"
                         invisible="not setting_article_generator_active"/>
                  <field name="setting_article_lang"
                         placeholder="en_US / ar_001 (blank = auto-detect)"
                         invisible="not setting_article_generator_active"/>
                </group>
                <group string="Image generation"
                       invisible="not setting_article_generator_active">
                  <field name="setting_image_provider"/>
                  <field name="setting_image_api_key" password="True"
                         invisible="setting_image_provider == 'none'"
                         placeholder="blank = reuse the AI agent's OpenAI key"/>
                  <field name="setting_image_model"
                         invisible="setting_image_provider == 'none'"/>
                  <field name="setting_image_size"
                         invisible="setting_image_provider == 'none'"/>
                </group>
                <group string="Status">
                  <field name="setting_ai_enabled" widget="boolean_toggle" readonly="1"/>
                  <field name="setting_ai_agent_id" readonly="1"
                         options="{'no_create': True}"/>
                </group>
              </group>

              <div class="alert alert-warning" role="status"
                   invisible="setting_ai_enabled">
                AI Auto-Fix is currently off. Turn it on in the Settings tab
                (or via the Setup Wizard) before enabling auto-publish — the
                cron needs a configured AI agent to write articles.
              </div>

              <!-- Pulled outside any <group> so the textarea spans the
                   full tab width (groups force a half-width column). -->
              <div invisible="not setting_article_generator_active">
                <div class="o_horizontal_separator mt-4 mb-2 text-uppercase fw-bolder small">
                  Custom prompt guidance
                </div>
                <field name="setting_article_prompt_addendum"
                       nolabel="1"
                       class="w-100"
                       widget="text"
                       placeholder="Free-form admin guidance — appended to every prompt under an &quot;ADMIN GUIDANCE&quot; section. Use it to nudge tone, audiences, regional angles, brands to mention/avoid, etc. Leave blank for defaults."/>
              </div>

              <!-- Polling widget: while is_article_pending is True, the
                   form auto-reloads every 3 seconds so the new article
                   appears in the table on its own. Invisible to the user. -->
              <field name="is_article_pending"
                     widget="era_auto_refresh_when_true"
                     invisible="1"/>

              <div class="mt-3 d-flex align-items-center gap-2">
                <button name="action_generate_blog_article_now"
                        type="object"
                        string="Generate article now"
                        class="btn btn-primary"
                        icon="fa-magic"
                        invisible="not setting_ai_enabled or is_article_pending"
                        confirm="Generate and publish a new article now? Runs in the background; the tab auto-refreshes every 3 seconds while it runs."/>
                <div class="alert alert-info mb-0 py-1 px-3"
                     role="status"
                     invisible="not is_article_pending">
                  <i class="fa fa-spinner fa-spin me-2"/>
                  Generating in the background — the table will refresh
                  on its own when the article is ready.
                </div>
              </div>

              <div class="o_horizontal_separator mt-4 mb-2 text-uppercase fw-bolder small">
                Recently generated
              </div>
              <field name="recent_ai_article_ids" nolabel="1" mode="list" readonly="1">
                <list string="AI-generated articles" create="0" delete="0">
                  <field name="era_ai_generated_at" string="Generated"/>
                  <field name="name" string="Title"/>
                  <field name="era_ai_trend_signal" string="Trend"/>
                  <field name="era_ai_confidence" string="Confidence" widget="float" digits="[3,2]"/>
                  <field name="is_published" string="Published" widget="boolean_toggle"/>
                  <field name="website_url" widget="url" string="URL" optional="show"/>
                  <button name="action_era_ai_regenerate" type="object"
                          string="Regenerate" icon="fa-refresh"
                          help="Replace this article with a fresh AI proposal (same record)."
                          confirm="Regenerate this article? Title, body, and SEO meta will be replaced."/>
                  <button name="action_era_open_website" type="object"
                          string="Open" icon="fa-external-link"
                          help="Open the live URL of this article in a new tab."/>
                </list>
              </field>
            </page>

            <!-- ============================ SETTINGS ============================ -->
            <page string="Settings" name="settings">
              <div class="alert alert-light mb-3" role="status">
                All settings live here. Changes save through the standard
                <b>Save</b> button at the top — they round-trip through
                <code>ir.config_parameter</code>, so the legacy
                <i>Website → Configuration → Settings</i> panels stay in sync.
              </div>

              <group string="Organization (used in JSON-LD + OG)">
                <group>
                  <field name="setting_org_name"
                         placeholder="ERA — Excellence Resources Arabia"/>
                  <field name="setting_legal_name"/>
                  <field name="setting_twitter_handle" placeholder="@era"/>
                </group>
                <group>
                  <field name="setting_logo_url" placeholder="https://…/logo.png"/>
                  <field name="setting_og_image_url" placeholder="https://…/og.png"/>
                  <field name="setting_schema_engine" widget="boolean_toggle"/>
                </group>
              </group>

              <group string="Social profiles">
                <group>
                  <field name="setting_social_facebook" placeholder="https://facebook.com/…"/>
                  <field name="setting_social_twitter" placeholder="https://twitter.com/…"/>
                  <field name="setting_social_linkedin" placeholder="https://linkedin.com/company/…"/>
                </group>
                <group>
                  <field name="setting_social_instagram" placeholder="https://instagram.com/…"/>
                  <field name="setting_social_youtube" placeholder="https://youtube.com/@…"/>
                </group>
              </group>

              <group string="Search engine verification">
                <group>
                  <field name="setting_google_verify"
                         placeholder="content of google-site-verification meta"/>
                </group>
                <group>
                  <field name="setting_bing_verify"/>
                </group>
              </group>

              <group string="AI Auto-Fix">
                <group>
                  <field name="setting_ai_enabled" widget="boolean_toggle"/>
                  <field name="setting_ai_agent_id"
                         invisible="not setting_ai_enabled"
                         options="{'no_create': True}"/>
                  <field name="setting_article_generator_active"
                         widget="boolean_toggle"
                         invisible="not setting_ai_enabled"/>
                </group>
              </group>
              <div class="text-muted small mb-3" invisible="not setting_ai_enabled">
                The agent carries the provider, model, and API key — all configured in the
                <b>AI</b> app (Odoo Enterprise). Leave the picker empty to fall back to the
                site's "Ask AI" agent. The SEO house-style rules are sent with every
                request, so a generic agent works fine.
              </div>
              <div class="text-muted small mb-3"
                   invisible="not setting_article_generator_active">
                Auto-publish runs every 3 days. The agent picks a current trend in
                your domain, writes the article, publishes it, and emails the
                SEO Manager group with the link.
              </div>

              <group string="GEO — /llms.txt &amp; AI crawlers">
                <group>
                  <field name="setting_llms_enabled" widget="boolean_toggle"/>
                  <field name="setting_llms_summary"
                         invisible="not setting_llms_enabled"
                         placeholder="One-line site description for AI engines"/>
                </group>
                <group invisible="not setting_llms_enabled">
                  <field name="setting_llms_max_items"/>
                  <field name="setting_llms_include_blog" widget="boolean_toggle"/>
                </group>
              </group>

              <group string="GSC — Google Search Console">
                <group>
                  <field name="setting_gsc_redirect_uri" readonly="1"
                         widget="CopyClipboardChar"/>
                  <field name="setting_gsc_client_id"
                         placeholder="xxxxxxxx.apps.googleusercontent.com"/>
                  <field name="setting_gsc_client_secret" password="True"
                         placeholder="••••••••••••••••"/>
                  <field name="setting_gsc_pull_window"/>
                </group>
              </group>
              <details class="mb-3">
                <summary class="text-primary small" style="cursor: pointer;">
                  Show GSC setup guide (one-time)
                </summary>
                <ol class="ps-3 mt-2 small text-muted">
                  <li>Open <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a> and create (or pick) a project.</li>
                  <li>Under <b>APIs &amp; Services → Library</b>, enable <a href="https://console.cloud.google.com/apis/library/searchconsole.googleapis.com" target="_blank">Search Console API</a>.</li>
                  <li>Configure the OAuth consent screen (Internal or External).</li>
                  <li>Under <b>Credentials</b>, create an OAuth client ID — <b>Web application</b>.</li>
                  <li>Add the <b>Authorized Redirect URI</b> shown above to the OAuth client — exact match, including https and no trailing slash.</li>
                  <li>Paste the Client ID and Client Secret into the fields above and save.</li>
                  <li>Open <i>ERA SEO Suite → GSC → Accounts → New</i>, then click <b>Connect with Google</b>.</li>
                </ol>
              </details>
            </page>

            <!-- ============================== GUIDE ============================== -->
            <page string="Guide" name="guide">
              <div class="alert alert-light mb-3" role="status">
                On-page setup walkthroughs. Click a section to expand.
                To re-run the guided setup, use the <b>Setup Wizard</b>
                button in the header above.
              </div>
              <details class="mb-3">
                <summary class="h6 text-primary" style="cursor: pointer;">
                  AI Auto-Fix — first run
                </summary>
                <ol class="ps-3 mt-2 small">
                  <li>Install Odoo's AI app (Enterprise) and configure a provider with an API key.</li>
                  <li>Settings → ERA SEO — AI Auto-Fix: tick Enable, pick the "ERA SEO Fixer" agent, click Test Agent.</li>
                  <li>On any audit finding (or in batch), click Suggest Fix (AI) → review → Apply Fix.</li>
                  <li>On pages / posts / content blocks, use AI: Fill SEO / AI: Rewrite SEO in the form header.</li>
                </ol>
              </details>

              <details class="mb-3">
                <summary class="h6 text-primary" style="cursor: pointer;">
                  GEO — /llms.txt and AI crawlers
                </summary>
                <ol class="ps-3 mt-2 small">
                  <li>Toggle <i>Publish /llms.txt</i> above; set a one-line site summary.</li>
                  <li>Open the GEO tab → Manage AI Crawlers; flip <i>Allowed</i> off on training-only bots if you want to block them from robots.txt.</li>
                  <li>Verify the live output: <code>https://&lt;domain&gt;/llms.txt</code> and the AI section in <code>/robots.txt</code>.</li>
                  <li>Run an SEO Audit; GEO checks (no answer summary, no headings, llms.txt off, answer-bots blocked) appear alongside SEO findings.</li>
                </ol>
              </details>

              <details class="mb-3">
                <summary class="h6 text-primary" style="cursor: pointer;">
                  GSC — connect a Google account
                </summary>
                <ol class="ps-3 mt-2 small">
                  <li>In Google Cloud Console: create a project; enable <b>Search Console API</b>.</li>
                  <li>Create OAuth 2.0 Client (Web app); add Redirect URI <code>&lt;base&gt;/era_gsc/oauth/callback</code>.</li>
                  <li>In Odoo: Settings → ERA SEO — Google Search Console; paste Client ID + Secret.</li>
                  <li>Open the GSC tab → Accounts → New → Connect with Google; grant read access.</li>
                  <li>Sites are auto-discovered; click Pull Now on a site to fill in queries.</li>
                </ol>
              </details>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Server action that lands on the singleton hub record. -->
  <record id="action_open_era_seo_suite_hub" model="ir.actions.server">
    <field name="name">Open ERA SEO Suite</field>
    <field name="model_id" ref="model_era_seo_suite_hub"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_hub()</field>
  </record>
</odoo>
