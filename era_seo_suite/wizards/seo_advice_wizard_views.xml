<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_era_seo_advice_wizard_form" model="ir.ui.view">
    <field name="name">era.seo.advice.wizard.form</field>
    <field name="model">era.seo.advice.wizard</field>
    <field name="arch" type="xml">
      <form string="AI Traffic Advice">
        <div class="oe_title mb-2">
          <h2 class="mb-0">
            <i class="fa fa-lightbulb-o text-warning me-2"/>AI tip to grow your traffic
          </h2>
        </div>
        <field name="advice_html" nolabel="1" readonly="1" widget="html"/>
        <div class="text-muted small mt-2" invisible="not model_label">
          Generated by
          <field name="model_label" readonly="1" nolabel="1" class="d-inline"/>
          — tips vary each time; click <b>Get another tip</b> for a fresh angle.
        </div>
        <footer>
          <button name="action_generate" type="object" string="Get another tip"
                  class="btn-primary" icon="fa-refresh"/>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
