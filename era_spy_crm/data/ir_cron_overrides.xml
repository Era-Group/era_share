<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Deliberate overrides of cron records that data/ir_cron.xml creates under
      noupdate="1". They live in this separate, updatable file so that upgrading
      the module re-applies them: editing the original noupdate block changes
      nothing on a database where the record already exists.
    -->
    <data>
        <!--
          Polling replaced by event-driven triggering on 2026-07-30.

          At interval_number=1/minutes this ran 1,430 times a day to service a
          median of 17 new leads — an 84:1 poll-to-work ratio — and together
          with the era_spy_recruitment twin made up 53.8% of every cron
          execution on the platform.

          CrmLead.create() already knows exactly when the work is due, so it now
          calls cron._trigger(at=scheduled_at), which inserts an ir_cron_trigger
          row that _get_ready_sql_condition picks up. This interval is only the
          safety net for a trigger row that was somehow lost. Note the run still
          starts within the worker's normal 60 s poll — no faster than before,
          but no slower either, and 99% of the wake-ups are gone.
        -->
        <record id="ir_cron_eraspy_auto_enrich_leads" model="ir.cron">
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
