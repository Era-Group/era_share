<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eraspy_enrich_wizard" model="ir.ui.view">
        <field name="name">eraspy.enrich.wizard.form</field>
        <field name="model">eraspy.enrich.wizard</field>
        <field name="arch" type="xml">
            <form string="EraSpy Enrichment" create="false">
                <sheet>
                    <group>
                        <field name="lead_ids" widget="many2many_tags"/>
                        <field name="lookup_source"/>
                        <field name="query" invisible="lookup_source != 'query'"/>
                        <field name="without_contacts"/>
                        <field name="overwrite_existing"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Enrich" type="object" name="action_enrich" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
