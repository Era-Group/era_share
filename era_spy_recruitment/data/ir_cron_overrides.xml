<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Deliberate overrides of cron records that data/ir_cron.xml creates under
      noupdate="1". They live in this separate, updatable file so that upgrading
      the module re-applies them: editing the original noupdate block changes
      nothing on a database where the record already exists.
    -->
    <data>
        <!--
          Auto-enrich polling switched OFF on 2026-07-30.

          Measured over 24h: this cron ran 1,429 times a day and, together with
          its era_spy_crm twin, accounted for 53.8% of every cron execution on
          the platform (2,859 of 5,318). What it had to do in that time: nothing
          at all. hr_applicant holds 69 rows, 0 of them with
          eraspy_auto_enrich_pending set, and the newest was created
          2026-01-13 — no new applicant in over six months.

          If recruitment starts up again, do NOT simply re-activate this: give
          it the event-driven treatment era_spy_crm now uses (cron._trigger()
          from create(), with a long interval as a safety net).
        -->
        <record id="ir_cron_eraspy_auto_enrich_applicants" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
