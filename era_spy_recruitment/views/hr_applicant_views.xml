<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_applicant_eraspy_bulk" model="ir.actions.server">
        <field name="name">EraSpy Enrich</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_eraspy_enrich()</field>
    </record>

    <record id="view_hr_applicant_eraspy_form" model="ir.ui.view">
        <field name="name">hr.applicant.form.eraspy</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="EraSpy" name="eraspy">
                    <field name="eraspy_enrichment_state" invisible="1"/>

                    <!-- Enrich button + live status -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <button name="action_eraspy_enrich"
                                type="object"
                                string=" Enrich Candidate"
                                invisible="eraspy_enrichment_state == 'queued'"
                                class="btn btn-primary"/>
                        <field name="eraspy_last_status" widget="eraspy_status"
                               readonly="1" nolabel="1"
                               invisible="not eraspy_last_status"/>
                    </div>

                    <!-- AI Match section -->
                    <div class="mb-4" invisible="not eraspy_ai_match">
                        <h3 class="mb-2">
                            <i class="fa fa-star text-warning me-1"/>
                            AI Qualification Match
                        </h3>
                        <div class="border rounded p-3 bg-white">
                            <field name="eraspy_ai_match" readonly="1" widget="html" nolabel="1"/>
                        </div>
                    </div>

                    <!-- More Data section -->
                    <div class="mb-4" invisible="not eraspy_more_data">
                        <h3 class="mb-2">
                            <i class="fa fa-id-card-o text-primary me-1"/>
                            Candidate Profile
                        </h3>
                        <div class="border rounded p-3 bg-white" style="direction: ltr; text-align: left;">
                            <field name="eraspy_more_data" readonly="1" widget="html" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Metadata footer -->
                    <div class="mt-3 p-3 bg-light rounded" style="font-size: 0.85em;">
                        <group col="4">
                            <field name="eraspy_last_status" readonly="1" string="Status"/>
                            <field name="eraspy_last_checked" readonly="1" string="Last Checked"/>
                            <field name="eraspy_last_request_id" readonly="1" string="Request ID"/>
                            <field name="eraspy_last_identifier" readonly="1" string="Identifier"/>
                            <field name="eraspy_profile_url" readonly="1" widget="url" string="Profile URL"/>
                            <field name="eraspy_rating" readonly="1" string="Rating"/>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
