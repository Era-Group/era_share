<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_lead_form_voip_call_button" model="ir.ui.view">
        <field name="name">crm.lead.form.voip.call.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_voip_calls" class="oe_stat_button" icon="fa-phone">
                    <field name="voip_call_count" widget="statinfo" string="VoIP Calls"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
