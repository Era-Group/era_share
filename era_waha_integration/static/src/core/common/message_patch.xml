<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Replace EE's plain green WhatsApp icon with WhatsApp-style delivery/read ticks
         for OUTBOUND messages; keep the icon for inbound (received) messages. -->
    <t t-name="era_waha_integration.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('fa-whatsapp')]" position="replace">
            <t t-if="isWahaOutboundStatus">
                <span class="ms-1 o-waha-tick" t-att-class="wahaTickClass"
                      t-att-title="getWhatsappStatusTitle()" t-esc="wahaTickMarks"/>
            </t>
            <t t-else="">
                <span class="fa fa-whatsapp ms-1" t-att-class="getWhatsappStatusClass()"
                      t-att-title="getWhatsappStatusTitle()"/>
            </t>
        </xpath>
    </t>

    <!-- Failed-post warning icon: replace the generic "Failed to post…" tooltip with the
         actual reason when one is known (e.g. a WAHA account-protection block). The getter
         falls back to the standard text for every other failure. -->
    <t t-name="era_waha_integration.MessagePendingStatus" t-inherit="mail.Message.pendingStatus" t-inherit-mode="extension">
        <xpath expr="//button" position="replace">
            <button t-if="message.postFailRedo" class="btn p-0"
                    t-att-title="wahaPendingTitle"
                    t-on-click="() => message.postFailRedo?.()">
                <i class="fa fa-fw fa-warning text-warning"/>
            </button>
        </xpath>
    </t>

</templates>
