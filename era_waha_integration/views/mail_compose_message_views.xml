<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_compose_message_view_form_waha" model="ir.ui.view">
        <field name="name">mail.compose.message.form.waha</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@special='cancel']" position="before">
                <field name="waha_available" invisible="1"/>
                <button string="WhatsApp" name="action_send_waha_whatsapp" type="object"
                        class="btn-secondary" icon="fa-whatsapp" data-hotkey="w"
                        invisible="not waha_available or not wa_account_id"/>
                <field name="wa_account_id"
                       invisible="not waha_available"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="WAHA account"/>
            </xpath>
        </field>
    </record>

</odoo>
