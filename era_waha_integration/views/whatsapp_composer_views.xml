<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whatsapp_composer_view_form_waha" model="ir.ui.view">
        <field name="name">whatsapp.composer.form.waha</field>
        <field name="model">whatsapp.composer</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_composer_view_form"/>
        <field name="arch" type="xml">

            <!-- Account selector -->
            <xpath expr="//field[@name='wa_template_id']" position="before">
                <field name="is_waha" invisible="1"/>
                <field name="wa_account_id"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>

            <!-- Template only for non-WAHA accounts, scoped to the chosen account -->
            <xpath expr="//field[@name='wa_template_id']" position="attributes">
                <attribute name="required">not is_waha</attribute>
                <attribute name="invisible">is_waha</attribute>
                <attribute name="domain">[('model', '=', res_model), ('status', '=', 'approved'), ('wa_account_id', '=', wa_account_id), ('template_type', 'in', context.get('template_types', ['authentication', 'marketing', 'utility']))]</attribute>
            </xpath>

            <!-- WAHA free-text message + optional image/file -->
            <xpath expr="//field[@name='wa_template_id']" position="after">
                <field name="waha_body" widget="html"
                       invisible="not is_waha"
                       required="is_waha and not waha_attachment"
                       class="o_waha_composer_body"
                       placeholder="Type your message..."/>
                <field name="waha_attachment_name" invisible="1"/>
                <field name="waha_attachment"
                       widget="binary"
                       filename="waha_attachment_name"
                       invisible="not is_waha"/>
            </xpath>

        </field>
    </record>

</odoo>
