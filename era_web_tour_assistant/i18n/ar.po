#. module: era_web_tour_assistant
#: model:ir.actions.server,name:era_web_tour_assistant.ir_cron_drop_stale_walkthroughs_ir_actions_server
msgid "Tour Assistant: remove walkthroughs an older builder wrote"
msgstr "مساعد الجولات: حذف الشروح التي كتبها بنّاء أقدم"

#. module: era_web_tour_assistant
#: model:ir.actions.server,name:era_web_tour_assistant.ir_cron_report_usage_ir_actions_server
