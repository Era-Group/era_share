<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="era_web_tour_assistant.Systray">
        <div class="o_tour_assistant_systray">
            <button type="button" class="btn o_tour_assistant_button"
                    t-on-click="onClick"
                    title="Ask about any task and be walked through it on screen"
                    aria-label="Show me how">
                <i class="fa fa-life-ring" role="img"/>
                <!-- A ring on its own reads as "help" — documentation, or a
                     support queue. The words are what say you can ask here and
                     be walked through the answer, and they are what somebody
                     who was never told about this feature has to go on. -->
                <span class="o_tour_assistant_label d-none d-md-inline ms-1">
                    Step by step
                </span>
            </button>
        </div>
    </t>

    <t t-name="era_web_tour_assistant.AskDialog">
        <Dialog size="'md'" title="title">
            <div class="o_tour_assistant_dialog">
                <p class="text-muted">
                    Describe what you are trying to do, in your own words.
                </p>
                <textarea t-ref="question"
                          class="form-control o_tour_assistant_input"
                          rows="3"
                          placeholder="e.g. how do I add a new contact?"
                          t-model="state.question"
                          t-on-keydown="onKeydown"
                          t-att-disabled="state.busy"/>
                <div t-if="state.busy" class="text-muted small mt-2" role="status">
                    <span class="fa fa-circle-o-notch fa-spin me-1"/>
                    Working out how to do that.
                    <t t-if="state.wait"><t t-esc="state.wait"/></t>
                </div>
                <div t-if="state.message" class="alert alert-info mt-3 mb-0" role="status">
                    <t t-esc="state.message"/>
                </div>
                <!--
                    Already worked out, and runnable again without asking for
                    it a second time or going into Settings. Only what this
                    user may actually run reaches here.
                -->
                <div t-if="state.library.length" class="o_tour_assistant_library mt-3">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th colspan="3" class="fw-normal bg-body p-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small text-nowrap">
                                            Walkthroughs ready for you
                                        </span>
                                        <input type="text"
                                               class="form-control form-control-sm o_tour_assistant_sift"
                                               placeholder="Search"
                                               t-model="state.sift"/>
                                        <span class="text-muted small text-nowrap"
                                              t-esc="shown.length"/>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="shown" t-as="walk" t-key="walk.name">
                                <td class="align-middle">
                                    <t t-esc="walk.label"/>
                                    <span t-if="walk.stages > 1"
                                          class="badge text-bg-light ms-1"
                                          title="Screens this walkthrough crosses">
<t t-esc="walk.stagesLabel"/>
                                    </span>
                                </td>
                                <td class="align-middle text-muted small text-nowrap">
<t t-esc="walk.stepsLabel"/>
                                </td>
                                <td class="align-middle text-end">
                                    <button class="btn btn-sm btn-link p-0"
                                            t-on-click="() => this.replay(walk)">
                                        Show me again
                                    </button>
                                    <button t-if="!walk.reported"
                                            class="btn btn-sm btn-link p-0 ms-3 o_tour_assistant_report"
                                            title="Tell us this walkthrough did not help. You will be asked to confirm."
                                            t-on-click="() => this.report(walk)">
                                        <i class="fa fa-flag-o me-1" role="img"/>
                                        Did not help
                                    </button>
                                    <span t-else="" class="small text-muted ms-3">
                                        <i class="fa fa-check me-1" role="img"/>Reported
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-on-click="submit"
                        t-att-disabled="!canSubmit">
                    <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                    Show me
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
