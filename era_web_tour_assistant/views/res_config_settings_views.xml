<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tour.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tour Assistant" string="Tour Assistant"
                     name="era_web_tour_assistant"
                     groups="era_web_tour_assistant.group_tour_assistant_manager">

                    <block title="Answering">
                        <setting id="tour_assistant_generate_setting"
                                 string="Build walkthroughs automatically"
                                 help="Work out a walkthrough for a question no recorded tour answers. With this off, an unanswered question only joins the queue.">
                            <field name="tour_assistant_generate"/>
                        </setting>
                        <setting id="tour_assistant_threshold_setting"
                                 string="Answer confidence"
                                 help="How closely a question must agree with a walkthrough before it is answered with it. Higher asks for more agreement, and queues a question rather than risk sending somebody to the wrong screen.">
                            <field name="tour_assistant_match_threshold"/>
                        </setting>
                    </block>

                    <!--
                        The usage switch is out of the screen until there is
                        somewhere for a report to land. Nothing in this repo
                        implements a receiver, and the module ships no address,
                        so the switch could only ever have been turned on
                        against an endpoint the customer supplied themselves —
                        an offer to share data with a publisher who cannot
                        receive it, which is worse than no offer.

                        The model, the snapshot, its tests and the weekly cron
                        are all left in place and cost nothing while the two
                        parameters are unset. Restoring the block is the whole
                        of what it takes to turn this back on.
                    -->

                </app>
            </xpath>
        </field>
    </record>

</odoo>
