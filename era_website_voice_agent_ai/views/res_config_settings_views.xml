<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_openai_realtime" model="ir.ui.view">
    <field name="name">res.config.settings.openai.realtime</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="Website AI Widget" name="openai_realtime" logo="/era_website_voice_agent_ai/static/src/img/website_widget_icon.svg" groups="base.group_system">
          <block title="Realtime Voice Agent">
            <setting string="OpenAI API Key" help="Stored in system parameters as openai.api_key (server-side only).">
              <field name="openai_api_key" password="True" placeholder="sk-..."/>
            </setting>

            <setting string="Realtime Prompt ID" help="Published prompt id for your agent, e.g. pmpt_...">
              <field name="openai_realtime_prompt_id" placeholder="pmpt_..."/>
            </setting>

            <setting string="Realtime Prompt Version" help="Optional prompt version to use for Realtime sessions (e.g. 2).">
              <field name="openai_realtime_prompt_version" placeholder="2"/>
            </setting>

            <setting string="Realtime Model" help="Model for realtime sessions (default: gpt-realtime-mini).">
              <field name="openai_realtime_model" placeholder="gpt-realtime-mini"/>
            </setting>

            <setting string="Voice" help="Voice name for audio output (default: alloy).">
              <field name="openai_realtime_voice" placeholder="alloy"/>
            </setting>

            <setting string="Show Website Widget" help="Show or hide the floating widget on the website.">
              <field name="openai_realtime_widget_enabled"/>
            </setting>

            <setting string="Widget Button Label" help="Text shown on the floating website widget button.">
              <field name="openai_realtime_widget_label"/>
            </setting>

            <setting string="Summary Prompt" help="System prompt used to analyze and summarize call recordings.">
              <field name="openai_realtime_summary_prompt" widget="text" placeholder="لخص المكالمة الواردة بالعربية بشكل قصير ومباشر جدًا. 2-3 نقاط كحد أقصى، واذكر أي إجراء مطلوب إن وجد"/>
            </setting>

            <setting string="Allowed Embed Origins" help="Optional allowlist of parent website origins that can embed the external widget frame. One origin per line, e.g. https://example.com">
              <field name="openai_realtime_embed_allowed_origins" widget="text" placeholder="https://example.com&#10;https://www.example.com"/>
            </setting>

            <setting string="External Embed Script" help="Copy/paste this script into any external website.">
              <field name="openai_realtime_embed_script" widget="text" readonly="1"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
