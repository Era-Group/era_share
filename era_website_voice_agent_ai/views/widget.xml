<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="realtime_agent_fab" inherit_id="website.layout" name="Realtime Agent Floating Button">
    <xpath expr="//body" position="inside">
      <div id="oai-agent-widget"
           class="oai-agent-widget"
           t-if="request.env['ir.config_parameter'].sudo().get_param('openai.realtime_widget_enabled', 'True') in ('1', 'true', 'True')"
           t-att-data-prompt-id="request.env['ir.config_parameter'].sudo().get_param('openai.realtime_prompt_id') or ''"
           t-att-data-model="request.env['ir.config_parameter'].sudo().get_param('openai.realtime_model') or 'gpt-realtime-mini'"
           t-att-data-voice="request.env['ir.config_parameter'].sudo().get_param('openai.realtime_voice') or 'alloy'"
           t-att-data-caller-phone="(request.env.user.partner_id.phone or (request.env.user.partner_id.mobile if 'mobile' in request.env.user.partner_id._fields else '')) if not request.env.user._is_public() else ''"
           t-att-data-caller-company="request.env.user.partner_id.company_name if not request.env.user._is_public() else ''">

        <t t-set="widget_label" t-value="request.env['ir.config_parameter'].sudo().get_param('openai.realtime_widget_label', default='')"/>
        <button id="oai-agent-fab"
                class="oai-agent-fab btn btn-primary rounded-pill shadow"
                type="button"
                t-att-aria-label="widget_label or ''">
          <span class="fa fa-align-center" style="transform: rotate(90deg);" aria-hidden="true"></span>
          <span class="oai-agent-fab__text">
            <t t-esc="widget_label"/>
          </span>
        </button>

        <div id="oai-agent-panel" class="oai-agent-panel d-none shadow-lg" role="dialog" aria-label="Realtime assistant" dir="rtl">
          <div class="oai-agent-panel__title">المساعد الصوتي</div>
          <div id="oai-agent-status" class="oai-agent-panel__status">أدخل رقم الجوال للمتابعة</div>

          <div id="oai-agent-mobile-step" class="oai-agent-mobile-step">
            <label for="oai-agent-mobile-input" class="oai-agent-mobile-label">رقم الجوال</label>
            <input id="oai-agent-mobile-input"
                   class="oai-agent-mobile-input"
                   type="tel"
                   inputmode="tel"
                   autocomplete="tel"
                   placeholder="+9665xxxxxxxx"/>
            <div id="oai-agent-mobile-error" class="oai-agent-mobile-error d-none"></div>
            <button id="oai-agent-start" class="btn btn-primary w-100 py-2" type="button">متابعة</button>
          </div>

          <div id="oai-agent-call-actions" class="oai-agent-panel__actions d-none">
            <button id="oai-agent-stop" class="btn btn-danger oai-agent-stop-btn" type="button">End call</button>
            <button id="oai-agent-ptt"
                    class="btn oai-agent-ptt-btn"
                    type="button"
                    aria-pressed="false"
                    title="Push to talk">
              <span class="fa fa-microphone" aria-hidden="true"></span>
              <span id="oai-agent-ptt-label" class="visually-hidden">Push to talk</span>
            </button>
          </div>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
