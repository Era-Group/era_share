#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/base.py:0
msgid "Missing Authorization header."
msgstr "لم يتم إرسال رمز الدخول."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/base.py:0
msgid "Unauthorized."
msgstr "غير مصرح بالدخول."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/base.py:0
msgid "Internal server error."
msgstr "حدث خطأ داخلي في الخادم."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Field '%s' is required."
msgstr "الحقل '%s' مطلوب."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Invalid date format. Use ISO 8601."
msgstr "تنسيق التاريخ غير صحيح. استخدم صيغة ISO 8601."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Leave type not found."
msgstr "نوع الإجازة غير موجود."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "You already have a leave request during this period."
msgstr "لديك طلب إجازة آخر في هذه الفترة."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Leave request (Yusr)"
msgstr "طلب إجازة (يُسر)"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid ""
"This leave type is measured in hours. Please provide hour_from and "
"hour_to."
msgstr "هذا النوع من الإجازات يُحسب بالساعات. يرجى تحديد وقت البداية ووقت النهاية."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "hour_from and hour_to must be decimal hours (e.g. 9.5 for 09:30)."
msgstr "يجب إدخال الساعات بصيغة عشرية (مثال: 9.5 تعني 09:30)."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Hours must be between 0 and 24."
msgstr "يجب أن تكون الساعة بين 0 و 24."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "hour_to must be greater than hour_from."
msgstr "وقت النهاية يجب أن يكون بعد وقت البداية."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Leave request submitted."
msgstr "تم إرسال طلب الإجازة."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Request not found."
msgstr "الطلب غير موجود."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Only pending requests can be cancelled."
msgstr "لا يمكن إلغاء إلا الطلبات قيد المراجعة."

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/leaves.py:0
msgid "Request cancelled."
msgstr "تم إلغاء الطلب."

#. module: era_yusr_api
#: code:addons/era_yusr_api/wizard/set_pin_wizard.py:0
msgid "No employee selected."
msgstr "لم يتم اختيار موظف."

#. module: era_yusr_api
#: code:addons/era_yusr_api/wizard/set_pin_wizard.py:0
msgid "PIN confirmation does not match."
msgstr "تأكيد الرقم السري غير مطابق."

#. module: era_yusr_api
#: code:addons/era_yusr_api/wizard/set_pin_wizard.py:0
#: code:addons/era_yusr_api/models/hr_employee.py:0
msgid "PIN must be 4 to 6 digits."
msgstr "يجب أن يكون الرقم السري من 4 إلى 6 أرقام."

#. module: era_yusr_api
#: code:addons/era_yusr_api/wizard/set_pin_wizard.py:0
msgid "Yusr PIN has been set/reset by %s."
msgstr "تم تعيين/إعادة تعيين رقم يُسر السري بواسطة %s."

#. module: era_yusr_api
#: code:addons/era_yusr_api/models/hr_employee.py:0
msgid "Login ID and PIN are required."
msgstr "اسم المستخدم والرقم السري مطلوبان."

#. module: era_yusr_api
#: code:addons/era_yusr_api/models/hr_employee.py:0
msgid "Invalid credentials."
msgstr "بيانات الدخول غير صحيحة."

#. module: era_yusr_api
#: code:addons/era_yusr_api/models/hr_employee.py:0
msgid "Your Yusr access is disabled. Contact HR."
msgstr "تم إيقاف وصولك إلى تطبيق يُسر. يرجى التواصل مع إدارة الموارد البشرية."

#. module: era_yusr_api
#: code:addons/era_yusr_api/models/hr_employee.py:0
msgid "Account locked due to too many failed attempts. Try again later."
msgstr "تم إقفال الحساب بسبب محاولات دخول خاطئة متكررة. حاول مرة أخرى لاحقاً."

#. module: era_yusr_api
#. Notifications feed — leave titles
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave request submitted"
msgstr "تم تقديم طلب إجازة"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave request approved"
msgstr "تم اعتماد طلب الإجازة"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave pending second approval"
msgstr "الطلب بانتظار الاعتماد الثاني"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave request refused"
msgstr "تم رفض طلب الإجازة"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave request cancelled"
msgstr "تم إلغاء طلب الإجازة"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Leave"
msgstr "إجازة"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "%s day(s)"
msgstr "%s يوم"

#. module: era_yusr_api
#. Notifications feed — payslip titles
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "New payslip available"
msgstr "مسير جديد متاح"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Payslip paid"
msgstr "تم صرف المسير"

#. module: era_yusr_api
#. Notifications feed — expense titles
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Expense submitted"
msgstr "تم تقديم طلب تعويض"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Expense approved"
msgstr "تم اعتماد طلب التعويض"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Expense reimbursed"
msgstr "تم صرف التعويض"

#. module: era_yusr_api
#: code:addons/era_yusr_api/controllers/notifications.py:0
msgid "Expense refused"
msgstr "تم رفض طلب التعويض"
