<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_mobile_notification" model="ir.module.category">
        <field name="name">Mobile Notification</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_mobile_notification" model="res.groups.privilege">
        <field name="name">Mobile Notification</field>
        <field name="category_id" ref="module_category_mobile_notification"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_notification_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_mobile_notification"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Full access to all notification features: configurations, devices, logs, and settings.</field>
    </record>

    <!-- Record Rules -->
    <record id="notification_config_rule_admin" model="ir.rule">
        <field name="name">Notification Config: Admin Full Access</field>
        <field name="model_id" ref="model_notification_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_notification_admin'))]"/>
    </record>

    <record id="notification_config_rule_user" model="ir.rule">
        <field name="name">Notification Config: User Read Own Company</field>
        <field name="model_id" ref="model_notification_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="notification_device_rule_admin" model="ir.rule">
        <field name="name">Notification Device: Admin Full Access</field>
        <field name="model_id" ref="model_notification_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_notification_admin'))]"/>
    </record>

    <record id="notification_device_rule_user" model="ir.rule">
        <field name="name">Notification Device: User Read Own</field>
        <field name="model_id" ref="model_notification_device"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="notification_log_rule_admin" model="ir.rule">
        <field name="name">Notification Log: Admin Full Access</field>
        <field name="model_id" ref="model_notification_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_notification_admin'))]"/>
    </record>

    <record id="notification_log_rule_user" model="ir.rule">
        <field name="name">Notification Log: User Read Own</field>
        <field name="model_id" ref="model_notification_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
