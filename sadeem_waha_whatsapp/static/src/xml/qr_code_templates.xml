<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="sadeem_waha_whatsapp.QRCodeWidget" owl="1">
        <div class="waha_qr_code">
            <div t-if="state.isLoading" class="text-center">
                <i class="fa fa-spinner fa-spin fa-2x"></i>
                <p>Loading QR Code...</p>
            </div>

            <div t-elif="state.error" class="alert alert-danger">
                <strong>Error:</strong> <t t-esc="state.error"/>
                <button class="btn btn-sm btn-secondary ml-2" t-on-click="manualRefresh">
                    <i class="fa fa-refresh"></i> Retry
                </button>
            </div>

            <div t-elif="props.record.data.qr_code_image" class="text-center">
                <img t-attf-src="data:image/png;base64,{{props.record.data.qr_code_image}}"
                     alt="QR Code" class="img-fluid"/>
                <br/>
                <button class="btn btn-primary mt-3" t-on-click="manualRefresh">
                    <i class="fa fa-refresh"></i> Refresh QR Code
                </button>
            </div>

            <div t-else class="text-center">
                <p>No QR Code available</p>
                <button class="btn btn-primary" t-on-click="manualRefresh">
                    <i class="fa fa-qrcode"></i> Get QR Code
                </button>
            </div>
        </div>
    </t>
</templates>