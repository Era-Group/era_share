<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Partner Form to add WhatsApp fields -->
    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add WhatsApp button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_send_whatsapp" type="object"
                        class="oe_stat_button" icon="fa-whatsapp"
                        invisible="not waha_whatsapp_number"
                        groups="sadeem_waha_whatsapp.group_waha_whatsapp_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Send</span>
                        <span class="o_stat_text">WhatsApp</span>
                    </div>
                </button>
                <button name="action_view_whatsapp_messages" type="object"
                        class="oe_stat_button" icon="fa-comments"
                        invisible="waha_whatsapp_message_count == 0"
                        groups="sadeem_waha_whatsapp.group_waha_whatsapp_user">
                    <field name="waha_whatsapp_message_count" widget="statinfo" string="Messages"/>
                </button>
            </xpath>

            <!-- Add WhatsApp number field (computed from phone) -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="waha_whatsapp_number" widget="phone"
                       readonly="1"
                       string="WhatsApp Number (Auto)"
                       help="Auto-computed from Phone field"
                       groups="sadeem_waha_whatsapp.group_waha_whatsapp_user"/>
            </xpath>
        </field>
    </record>

</odoo>